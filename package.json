{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 9003",
    "dev:webpack": "next dev -p 9003",
    "dev:turbo": "next dev --turbopack -p 9003",
    "dev:9002": "next dev --turbopack -p 9002",
    "free:9002": "npx --yes kill-port 9002",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate:phase1": "npx --yes tsx scripts/phase1-labor-cost-migration.ts",
    "migrate:phase5": "npx --yes tsx scripts/phase5-strip-position-rate-cost-baseline.ts",
    "migrate:phase6": "npx --yes tsx scripts/phase6-strip-main-contract-costing-denorm.ts",
    "migrate:po-active-phase1": "npx --yes tsx scripts/po-active-workflow-phase1-migration.ts",
    "migrate:po-active-auto-daily": "npx --yes tsx scripts/po-active-auto-daily-timesheets.ts",
    "firebase:login": "npx firebase-tools login",
    "firebase:login:reauth": "npx firebase-tools login --reauth",
    "firebase:login:no-localhost": "npx firebase-tools login --no-localhost",
    "firebase:login:reauth:no-localhost": "npx firebase-tools login --reauth --no-localhost",
    "deploy:app": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only apphosting:opecbackend --force",
    "generate:permission-matrix": "npx tsx scripts/generate-role-permission-matrix.ts",
    "generate:rules-from-matrix": "npx tsx scripts/generate-firestore-rules-from-matrix.ts",
    "generate:rules-simplified": "npx tsx scripts/generate-simplified-firestore-rules.ts",
    "rules:merge-preserved": "npx tsx scripts/extract-preserved-rules-blocks.ts",
    "deploy:rules": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore:rules",
    "deploy:rules:retry": "node scripts/deploy-firestore-rules-cli-retry.mjs",
    "deploy:rules:admin": "node scripts/deploy-firestore-rules.mjs",
    "deploy:rules:noninteractive": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore:rules --non-interactive",
    "deploy:indexes": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore:indexes",
    "deploy:firestore": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore",
    "deploy:storage": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only storage",
    "deploy:all": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --force",
    "deploy:functions": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only functions",
    "deploy:functions:indexes": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore:indexes,functions",
    "deploy:rules-and-app": "cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only firestore:rules && cross-env NODE_OPTIONS=--use-system-ca npx firebase-tools deploy --only apphosting:opecbackend --force"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "^1.28.0",
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.5.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.9.1",
    "firebase-admin": "^12.0.0",
    "genkit": "^1.28.0",
    "lucide-react": "^0.475.0",
    "next": "15.5.9",
    "patch-package": "^8.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-day-picker": "^9.11.3",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^20",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "firebase-tools": "^15.16.0",
    "genkit-cli": "^1.28.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
