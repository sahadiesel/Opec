rules_version = '2';
// 3-tier model: admin | accounting | internal (default). ASCII-only comments (Console publish).
// Supports both snake_case (status, user_type, role) and legacy camelCase (approvalStatus, userType, assignedRoleKey).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userRef());
    }

    function userData() {
      return get(userRef()).data;
    }

    function isActiveStatus(d) {
      return d != null && (
        ('status' in d && (d.status == 'active' || d.status == 'ACTIVE'))
        || ('approvalStatus' in d && (d.approvalStatus == 'ACTIVE' || d.approvalStatus == 'APPROVED' || d.approvalStatus == 'active'))
        || ((!('status' in d) || d.status == null) && (!('approvalStatus' in d) || d.approvalStatus == null) && d.isActive == true)
      );
    }

    function isInternalTypeData(d) {
      return d != null
        && !isCustomerPortalData(d)
        && (
          ('user_type' in d && (d.user_type == 'internal' || d.user_type == 'INTERNAL'))
          || ('userType' in d && d.userType is string && d.userType.lower() == 'internal')
          || (!('user_type' in d) && !('userType' in d))
        );
    }

    function isCustomerPortalData(d) {
      return d != null && (
        ('user_type' in d && (d.user_type == 'customer_portal' || d.user_type == 'CUSTOMER_PORTAL'))
        || ('userType' in d && d.userType == 'customer_portal')
      );
    }

    /** ไม่มี role → คืน '' ให้ทั้งสองแขนของ ternary เป็น string เดียวกัน (หลีกเลี่ยง warning ตอน compile) */
    function effectiveRoleFromRoleField(d) {
      return (d != null && 'role' in d && d.role is string && d.role.size() > 0)
        ? d.role.lower()
        : '';
    }

    function effectiveRoleFromAssignedKey(d) {
      return (d != null && 'assignedRoleKey' in d && d.assignedRoleKey is string && d.assignedRoleKey.size() > 0)
        ? d.assignedRoleKey.lower()
        : '';
    }

    /** assignedRoleKeys[0] — สอดคล้องลำดับ getPrimaryLegacyRole ฝั่งแอป */
    function effectiveRoleFromAssignedKeysFirst(d) {
      return d != null
        && 'assignedRoleKeys' in d
        && d.assignedRoleKeys is list
        && d.assignedRoleKeys.size() > 0
        && d.assignedRoleKeys[0] is string
        && d.assignedRoleKeys[0].size() > 0
        ? d.assignedRoleKeys[0].lower()
        : '';
    }

    /**
     * ลำดับเดียวกับ getPrimaryLegacyRole ฝั่งแอป (assignedRoleKey -> assignedRoleKeys[0] -> role scalar)
     * แก้กรณี UI เป็น system_admin แต่ effectiveRole() ในกฎอ่าน role เก่าก่อนจึงทำให้ isAdmin() เป็น false
     */
    function primaryBusinessRoleForAdminGate(d) {
      return d == null
        ? ''
        : (
            effectiveRoleFromAssignedKey(d).size() > 0
              ? effectiveRoleFromAssignedKey(d)
              : (
                  effectiveRoleFromAssignedKeysFirst(d).size() > 0
                    ? effectiveRoleFromAssignedKeysFirst(d)
                    : effectiveRoleFromRoleField(d)
                )
          );
    }

    function permissionProfileIndicatesOperationsManager(d) {
      return d != null && (
        (
          'permissionProfileKey' in d
          && d.permissionProfileKey is string
          && d.permissionProfileKey.lower() == 'operations_manager'
        )
        || (
          'permissionProfileKeys' in d
          && d.permissionProfileKeys is list
          && d.permissionProfileKeys.size() > 0
          && d.permissionProfileKeys[0] is string
          && d.permissionProfileKeys[0].lower() == 'operations_manager'
        )
      );
    }

    /**
     * Legacy effectiveRole: role field ก่อน assignedRoleKey — ใช้ที่อื่นในไฟล์นี้
     * ผู้จัดการปฏิบัติการ Petty Cash: แอปใช้ assignedRoleKey ก่อน role + รองรับ permissionProfileKey
     */
    function effectiveRole(d) {
      return effectiveRoleFromRoleField(d).size() > 0
        ? effectiveRoleFromRoleField(d)
        : effectiveRoleFromAssignedKey(d);
    }

    function isInternalUser() {
      return hasUserDoc()
        && isInternalTypeData(userData())
        && !isCustomerPortalData(userData())
        && isActiveStatus(userData());
    }

    /** Internal user document (ไม่บังคับ isActive) — ใช้เฉพาะคอลเลกชันที่ต้องการให้ staff ยัง list ได้แม้สถานะบัญชียังไม่ครบ */
    function isInternalStaffDoc() {
      return hasUserDoc()
        && isInternalTypeData(userData())
        && !isCustomerPortalData(userData());
    }

    /** โปรไฟล์ payroll_officer บน user doc — บางบัญชีมีแค่ permissionProfileKey(s) โดยไม่มี role scalar */
    function permissionProfileIndicatesPayrollOfficer(d) {
      return d != null && (
        (
          'permissionProfileKey' in d
          && d.permissionProfileKey is string
          && d.permissionProfileKey.lower() == 'payroll_officer'
        )
        || (
          'permissionProfileKeys' in d
          && d.permissionProfileKeys is list
          && d.permissionProfileKeys.hasAny(['payroll_officer', 'PAYROLL_OFFICER'])
        )
      );
    }

    /** เจ้าหน้าที่เงินเดือน — เทียบ cashAdvancePrivilegedReader (บทบาท scalar / assigned keys / profile / roleIds) */
    function payrollOfficerRoleOrProfile(d) {
      return d != null
        && !isCustomerPortalData(d)
        && (
          effectiveRoleFromAssignedKey(d) == 'payroll_officer'
          || effectiveRoleFromAssignedKeysFirst(d) == 'payroll_officer'
          || effectiveRoleFromRoleField(d) == 'payroll_officer'
          || permissionProfileIndicatesPayrollOfficer(d)
          || (
            'roleIds' in d
            && d.roleIds is list
            && d.roleIds.hasAny(['payroll_officer', 'PAYROLL_OFFICER'])
          )
        );
    }

    /** สอดคล้อง getEffectivePermissionProfileKey — primary key ก่อน permissionProfileKeys[0] */
    function userPrimaryPermissionProfileIdString() {
      let d = userData();
      return ('permissionProfileKey' in d && d.permissionProfileKey is string && d.permissionProfileKey.size() > 0)
        ? d.permissionProfileKey
        : (
          ('permissionProfileKeys' in d && d.permissionProfileKeys is list && d.permissionProfileKeys.size() > 0 && d.permissionProfileKeys[0] is string && d.permissionProfileKeys[0].size() > 0)
            ? d.permissionProfileKeys[0]
            : ''
        );
    }

    /** โปรไฟล์ที่เป็นบทบาท payroll_officer / เปิด worker_payroll.view — บางแถวเก็บแค่ profileKey ไม่มีเมทริกซ์ครบ */
    function workerPayrollProfileIndicatesPayrollAccess(profileData) {
      return profileData != null && (
        (
          'permissions' in profileData
          && profileData.permissions is map
          && 'worker_payroll' in profileData.permissions
          && profileData.permissions.worker_payroll is map
          && 'view' in profileData.permissions.worker_payroll
          && profileData.permissions.worker_payroll.view == true
        )
        || (
          'primaryRoleTemplateKey' in profileData
          && profileData.primaryRoleTemplateKey is string
          && profileData.primaryRoleTemplateKey.lower() == 'payroll_officer'
        )
        || (
          'profileKey' in profileData
          && profileData.profileKey is string
          && profileData.profileKey.lower() == 'payroll_officer'
        )
      );
    }

    /**
     * UI ใช้เมทริกซ์ใน permission_profiles — บทบาท scalar บน user doc อาจไม่ใช่ payroll_officer
     */
    function workerPayrollViewGrantedViaAssignedPermissionProfile() {
      let pid = userPrimaryPermissionProfileIdString();
      return hasUserDoc()
        && !isCustomerPortalData(userData())
        && pid.size() > 0
        && exists(/databases/$(database)/documents/permission_profiles/$(pid))
        && (
          workerPayrollProfileIndicatesPayrollAccess(get(/databases/$(database)/documents/permission_profiles/$(pid)).data)
          || pid.lower() == 'payroll_officer'
        );
    }

    /**
     * เมนูธนาคาร/cashbook ในแอปมาจาก permission_profiles.permissions — เดิม bank_accounts อนุญาตแค่บัญชี·ผู้จัดการปฏิบัติการ
     * ทำให้ผู้ใช้ที่ได้ bank_accounts.view / cashbook.view จากโปรไฟล์แต่ไม่ใช่บทบาทบัญชีถูก deny list ที่หน้า payroll batch
     */
    function bankAccountsOrCashbookViewTrue(profileData) {
      return profileData != null && (
        (
          'permissions' in profileData
          && profileData.permissions is map
          && 'bank_accounts' in profileData.permissions
          && profileData.permissions.bank_accounts is map
          && 'view' in profileData.permissions.bank_accounts
          && profileData.permissions.bank_accounts.view == true
        )
        || (
          'permissions' in profileData
          && profileData.permissions is map
          && 'cashbook' in profileData.permissions
          && profileData.permissions.cashbook is map
          && 'view' in profileData.permissions.cashbook
          && profileData.permissions.cashbook.view == true
        )
      );
    }

    function bankAccountsViewGrantedViaAssignedPermissionProfile() {
      let pid = userPrimaryPermissionProfileIdString();
      return hasUserDoc()
        && !isCustomerPortalData(userData())
        && pid.size() > 0
        && exists(/databases/$(database)/documents/permission_profiles/$(pid))
        && bankAccountsOrCashbookViewTrue(get(/databases/$(database)/documents/permission_profiles/$(pid)).data);
    }

    /** อ่าน permission_profiles/{id} เฉพาะแถวที่ผูกกับ user — ไม่เปิด list ทั้งชุด */
    function profileDocIsAssignedToCurrentUser(profileId) {
      return hasUserDoc()
        && profileId is string
        && profileId.size() > 0
        && (
          ('permissionProfileKey' in userData() && userData().permissionProfileKey == profileId)
          || (
            'permissionProfileKeys' in userData()
            && userData().permissionProfileKeys is list
            && userData().permissionProfileKeys.size() > 0
            && userData().permissionProfileKeys[0] is string
            && userData().permissionProfileKeys[0] == profileId
          )
        );
    }

    /**
     * อ่านข้อมูล payroll / exception / monthly docs — ให้สอดคล้อง workers·daily_timesheets (มี isInternalStaffDoc)
     * เพื่อให้ payroll_officer และบัญชี internal ที่สถานะยังไม่ active ครบเปิด HR dashboard / list งวดได้
     */
    function internalPayrollDataReader() {
      return isInternalUser()
        || isInternalStaffDoc()
        || (
          hasUserDoc()
          && !isCustomerPortalData(userData())
          && payrollOfficerRoleOrProfile(userData())
        )
        || workerPayrollViewGrantedViaAssignedPermissionProfile();
    }

    /**
     * แอดมินระบบ — ต้องสอดคล้องกับ isSystemAdmin() ฝั่งแอป (role / accessGroup / roleIds ฯลฯ)
     * มิฉะนั้นผู้ใช้ที่ UI แสดง Administrator แต่ effectiveRole ไม่ใช่ system_admin จะถูกปฏิเสธ
     * ตอนลง cashbook / อัปเดต bank_accounts (canAccessBankAccountsAndCashbook อ้าง isAdmin)
     */
    function stringLowerEqAdmin(v) {
      return v is string && v.size() > 0 && v.lower() == 'admin';
    }

    /** สอดคล้องกับ isSystemAdmin() ฝั่งแอป — ผู้ใช้ที่ได้สิทธิ์จาก permissionProfileKey โดยไม่มี role/scalar */
    function permissionProfileKeyIndicatesSystemAdmin(d) {
      return d != null
        && 'permissionProfileKey' in d
        && d.permissionProfileKey is string
        && (
          d.permissionProfileKey.lower() == 'system_admin'
          || d.permissionProfileKey.lower() == 'admin_admin'
        );
    }

    function permissionProfileKeysListIndicatesSystemAdmin(d) {
      return d != null
        && 'permissionProfileKeys' in d
        && d.permissionProfileKeys is list
        && d.permissionProfileKeys.hasAny([
          'system_admin', 'SYSTEM_ADMIN', 'admin_admin', 'ADMIN_ADMIN',
        ]);
    }

    function userDocIndicatesSystemAdmin(d) {
      return d != null && (
        primaryBusinessRoleForAdminGate(d) == 'system_admin'
        || primaryBusinessRoleForAdminGate(d) == 'admin_admin'
        || permissionProfileKeyIndicatesSystemAdmin(d)
        || permissionProfileKeysListIndicatesSystemAdmin(d)
        || (
          'roleIds' in d && d.roleIds is list
          && (
            d.roleIds.hasAny(['system_admin']) || d.roleIds.hasAny(['SYSTEM_ADMIN'])
            || d.roleIds.hasAny(['admin_admin']) || d.roleIds.hasAny(['ADMIN_ADMIN'])
          )
        )
        || (('accessGroup' in d) && stringLowerEqAdmin(d.accessGroup))
        || (('departmentGroup' in d) && stringLowerEqAdmin(d.departmentGroup))
        || (('department' in d) && stringLowerEqAdmin(d.department))
      );
    }

    function isAdmin() {
      return isInternalUser() && userDocIndicatesSystemAdmin(userData());
    }

    /** สอดคล้องกับบทบาทบัญชีเมื่อกำหนดผ่าน permission profile แทน role scalar */
    function permissionProfileKeyIndicatesAccounting(d) {
      return d != null
        && 'permissionProfileKey' in d
        && d.permissionProfileKey is string
        && (
          d.permissionProfileKey.lower() == 'accounting_manager'
          || d.permissionProfileKey.lower() == 'accounting_officer'
        );
    }

    function permissionProfileKeysListIndicatesAccounting(d) {
      return d != null
        && 'permissionProfileKeys' in d
        && d.permissionProfileKeys is list
        && d.permissionProfileKeys.hasAny([
          'accounting_manager', 'ACCOUNTING_MANAGER',
          'accounting_officer', 'ACCOUNTING_OFFICER',
        ]);
    }

    function isAccounting() {
      return isInternalUser()
        && (
          (
            effectiveRole(userData()).size() > 0
            && (
              effectiveRole(userData()) == 'accounting_manager'
              || effectiveRole(userData()) == 'accounting_officer'
            )
          )
          || permissionProfileKeyIndicatesAccounting(userData())
          || permissionProfileKeysListIndicatesAccounting(userData())
        );
    }

    function isAccountingOrAdmin() {
      return isAdmin() || isAccounting();
    }

    /** hasUserDoc ก่อน — หลีกเลี่ยง userData()/get() ล้ม; ห้ามใช้ if/return แบบ JS (Rules ไม่รองรับ) */
    function isOperationsManagerRole() {
      return hasUserDoc()
        && (isInternalUser() || isInternalStaffDoc())
        && (
          effectiveRoleFromAssignedKey(userData()) == 'operations_manager'
          || (
            effectiveRoleFromAssignedKey(userData()).size() == 0
            && (
              effectiveRoleFromAssignedKeysFirst(userData()) == 'operations_manager'
              || (
                effectiveRoleFromAssignedKeysFirst(userData()).size() == 0
                && (
                  effectiveRoleFromRoleField(userData()) == 'operations_manager'
                  || (
                    effectiveRoleFromRoleField(userData()).size() == 0
                    && permissionProfileIndicatesOperationsManager(userData())
                  )
                )
              )
            )
          )
        );
    }

    /** บัญชี: master data — ผู้จัดการปฏิบัติการบันทึก Petty Cash / โอน (อัปเดตยอด) ได้ */
    function canAccessBankAccountsAndCashbook() {
      return isAccountingOrAdmin() || isOperationsManagerRole();
    }

    /** เบิกล่วงหน้า — list/get ทั้งชุดเฉพาะบทบาทที่เกี่ยวข้อง (พนักงานเห็นเฉพาะแถวของตนเอง) */
    function cashAdvancePrivilegedReader() {
      return isAdmin()
        || isAccountingOrAdmin()
        || isOperationsManagerRole()
        || (
          (isInternalUser() || isInternalStaffDoc())
          && (
            effectiveRoleFromAssignedKey(userData()) == 'hr_manager'
            || effectiveRoleFromAssignedKeysFirst(userData()) == 'hr_manager'
            || effectiveRoleFromRoleField(userData()) == 'hr_manager'
          )
        )
        || (
          (isInternalUser() || isInternalStaffDoc())
          && (
            effectiveRoleFromAssignedKey(userData()) == 'payroll_officer'
            || effectiveRoleFromAssignedKeysFirst(userData()) == 'payroll_officer'
            || effectiveRoleFromRoleField(userData()) == 'payroll_officer'
            || permissionProfileIndicatesPayrollOfficer(userData())
            || (
              'roleIds' in userData()
              && userData().roleIds is list
              && userData().roleIds.hasAny(['payroll_officer', 'PAYROLL_OFFICER'])
            )
          )
        );
    }

    // Head of commercial/ops/HR pillar (not system_admin): broad internal business access in app + rules.
    function isOperationsPillarExecutive() {
      return hasUserDoc()
        && isInternalUser()
        && (
          effectiveRole(userData()) == 'operations_manager'
          || effectiveRole(userData()) == 'hr_manager'
          || effectiveRole(userData()) == 'sales_manager'
          || (
            (
              ('accessGroup' in userData() && (userData().accessGroup == 'operations' || userData().accessGroup == 'operation'))
              || ('departmentGroup' in userData() && (userData().departmentGroup == 'operations' || userData().departmentGroup == 'operation'))
            )
            && ('accessLevel' in userData() && userData().accessLevel == 'manager')
          )
        );
    }

    function isCustomerPortalUserCreate(userId) {
      let c = request.resource.data;
      return c.id == userId
        && c.userType == 'customer_portal'
        && c.assignedRoleKey == 'client_user'
        && ('customerId' in c)
        && c.customerId is string
        && c.customerId.size() > 0
        && ('email' in c)
        && c.email is string;
    }

    /** สร้างบัญชีพนักงาน/ลูกจ้างจากทะเบียน (พอร์ทัล My Profile) — เฉพาะผู้บริหารสายปฏิบัติการ */
    function isEmployeeSelfPortalUserCreate(userId) {
      let c = request.resource.data;
      return c.id == userId
        && c.userType == 'internal'
        && c.assignedRoleKey == 'employee_self'
        && ('email' in c)
        && c.email is string
        && c.email.size() > 0;
    }

    /** บัญชีพนักงานแบบจำกัดสิทธิ์ (ล็อกอินจากทะเบียนลูกจ้าง) */
    function isEmployeeSelfPortalUser() {
      return hasUserDoc()
        && isInternalTypeData(userData())
        && !isCustomerPortalData(userData())
        && isActiveStatus(userData())
        && effectiveRole(userData()) == 'employee_self';
    }

    /** พนักงานสร้างคำขอเบิกล่วงหน้าด้วยตนเอง — ห้ามแอบอ้าง UID คนอื่น */
    function cashAdvanceEmployeeSelfCreateValid() {
      let c = request.resource.data;
      return c.keys().hasAll([
          'subjectLinkedUserId', 'origin', 'status', 'amountBaht', 'reason',
          'createdAt', 'updatedAt', 'createdByUid', 'createdByName', 'requestNo',
        ])
        && c.subjectLinkedUserId is string
        && c.subjectLinkedUserId == request.auth.uid
        && c.createdByUid is string
        && c.createdByUid == request.auth.uid
        && c.origin == 'employee'
        && c.status == 'PENDING_PAYROLL_REVIEW';
    }

    /** สอดคล้อง permissions.ts — hr_officer ถูกบล็อกโมดูล cash_advances */
    function isHrOfficerRoleScalar() {
      return hasUserDoc()
        && (
          effectiveRoleFromAssignedKey(userData()) == 'hr_officer'
          || effectiveRoleFromAssignedKeysFirst(userData()) == 'hr_officer'
          || effectiveRoleFromRoleField(userData()) == 'hr_officer'
        );
    }

    /**
     * แอปให้ internal หลายบทบาทเห็นรายการเบิก (fallback FULL_ACCESS) แต่เดิมกฎอนุญาตเฉพาะ cashAdvancePrivilegedReader
     * จึง list /hr/cash-advances ไม่ได้ — เปิดอ่านคิวให้ internal ที่ไม่ใช่ employee_self และไม่ใช่ hr_officer
     */
    function cashAdvanceInternalQueueReader() {
      return hasUserDoc()
        && (isInternalUser() || isInternalStaffDoc())
        && !isEmployeeSelfPortalUser()
        && !isHrOfficerRoleScalar();
    }

    function opsExecClientPortalUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return isOperationsPillarExecutive()
        && before.userType == 'customer_portal'
        && after.userType == 'customer_portal'
        && before.assignedRoleKey == 'client_user'
        && after.assignedRoleKey == 'client_user'
        && before.customerId == after.customerId
        && before.id == after.id;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userSecurityFieldChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userType', 'user_type', 'status', 'approvalStatus', 'isActive',
        'assignedRoleKey', 'assignedRoleKeys', 'role',
        'permissionProfileKey', 'permissionProfileKeys',
        'accessGroup', 'departmentGroup', 'department', 'level', 'roleId', 'roleIds',
        'customerId', 'portalRole', 'mustResetPassword'
      ]);
    }

    function bootstrapUserCreateValid(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && d.id == uid
        && (d.userType == 'internal' || (('user_type' in d) && (d.user_type == 'internal' || d.user_type == 'INTERNAL')))
        && (d.isActive == true || (('status' in d) && (d.status == 'active' || d.status == 'ACTIVE')))
        && (d.approvalStatus == 'ACTIVE' || (('status' in d) && (d.status == 'active' || d.status == 'ACTIVE')));
    }

    // Self-service signup on home page: Auth user creates own Firestore profile, then signs out; admin approves in Users UI.
    function selfRegistrationPendingCreateValid(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && d.id == uid
        && d.userType == 'internal'
        && d.isActive == false
        && d.approvalStatus == 'PENDING'
        && ('email' in d) && d.email is string && d.email.size() > 0
        && ('displayName' in d) && d.displayName is string && d.displayName.size() > 0
        && ('phone' in d) && d.phone is string && d.phone.size() > 0
        && d.department == 'operations'
        && d.level == 'viewer'
        && ('roleIds' in d) && d.roleIds is list && d.roleIds.size() == 0
        && ('createdAt' in d) && d.createdAt is int
        && ('updatedAt' in d) && d.updatedAt is int
        && !('assignedRoleKey' in d)
        && !('assignedRoleKeys' in d)
        && !('permissionProfileKey' in d)
        && !('permissionProfileKeys' in d)
        && !('role' in d)
        && !('accessGroup' in d)
        && !('departmentGroup' in d)
        && !('customerId' in d)
        && !('portalRole' in d);
    }

    function clientPortalUserActive() {
      return hasUserDoc()
        && isCustomerPortalData(userData())
        && isActiveStatus(userData());
    }

    function portalCustomerIdOk() {
      let d = userData();
      return clientPortalUserActive()
        && d != null
        && 'customerId' in d
        && d.customerId is string
        && d.customerId.size() > 0;
    }

    function portalOwnsResourceCustomerId() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAny(['customerId'])
        && resource.data.customerId == userData().customerId;
    }

    /** Daily timesheet row may omit customerId; allow read when its wave belongs to the portal customer */
    function portalDailyTimesheetReadableViaWave() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['waveId'])
        && resource.data.waveId is string
        && exists(/databases/$(database)/documents/waves/$(resource.data.waveId))
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.customerId == userData().customerId;
    }

    /** อ่าน timesheet รายวันตาม PO เมื่อ PO เป็นของลูกค้า (เอกสาร timesheet รอบ PO+เดือน) */
    function portalDailyTimesheetReadableViaPo() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['purchaseOrderId'])
        && resource.data.purchaseOrderId is string
        && exists(/databases/$(database)/documents/purchase_orders/$(resource.data.purchaseOrderId))
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.purchaseOrderId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.purchaseOrderId)).data.customerId == userData().customerId;
    }

    function portalIsApprover() {
      return portalCustomerIdOk()
        && 'portalRole' in userData()
        && userData().portalRole == 'approver';
    }

    function portalTaxInvoiceBillingApprovalKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'billingCustomerApprovedAt',
        'billingCustomerApprovedByUid',
        'billingCustomerApprovedByName',
        'billingCustomerApprovalSource',
        'billingApprovalToken',
        'billingApprovalEvents',
        'updatedAt'
      ]);
    }

    function portalTaxInvoicePaymentNotifyKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'paymentNotifiedAt',
        'paymentNotifiedByUid',
        'paymentNotifiedByName',
        'paymentNotifySource',
        'paymentNotificationNote',
        'updatedAt'
      ]);
    }

    function portalTaxInvoicePaymentNotifyAllowed() {
      return resource.data.status == 'ISSUED'
        && !('paymentNotifiedAt' in resource.data)
        && !('paymentReceivedConfirmedAt' in resource.data)
        && !('linkedReceiptId' in resource.data);
    }

    /** ลูกค้า (Approver) ยืนยันใบแจ้งหนี้เรียกเก็บ — commercial_invoices */
    function portalCommercialInvoiceConfirmKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'customerApprovedAt',
        'customerApprovedByUid',
        'customerApprovedByName',
        'customerApprovalSource',
        'updatedAt',
        'updatedByUid',
        'updatedByName'
      ]);
    }

    /** ลูกค้าแนบสลิป/หลักฐาน — เอกสารยืนยัน ISSUED แล้ว, ยังไม่รับรอง OPEC */
    function portalCommercialPaymentProofKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'customerPaymentReportedAt',
        'customerPaymentReportedByUid',
        'customerPaymentReportedByName',
        'customerPaymentProofUrl',
        'customerPaymentProofFileName',
        'updatedAt',
        'updatedByUid',
        'updatedByName'
      ]);
    }

    function portalCommercialPaymentReportAllowed() {
      return portalIsApprover()
        && portalOwnsResourceCustomerId()
        && resource.data.status == 'ISSUED'
        && !resource.data.keys().hasAny(['opecPaymentVerifiedAt']);
    }

    /** ลูกหนี้ (AR) จากยืนยันยอด — documentNo คงที่ ไม่ต้องใช้ number_sequences ใน portal */
    function portalArComFromCommercialCreateOk() {
      return clientPortalUserActive()
        && portalIsApprover()
        && request.resource.data.keys().hasAll(['customerId', 'documentNo', 'referenceType', 'referenceId', 'issueDate', 'dueDate', 'debitAmount', 'creditAmount', 'outstandingAmount', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.referenceType == 'COMMERCIAL_INVOICE'
        && request.resource.data.referenceId is string
        && request.resource.data.documentNo == ('AR-COM-' + request.resource.data.referenceId)
        && request.resource.data.customerId == userData().customerId
        && request.resource.data.status == 'OPEN'
        && request.resource.data.creditAmount == 0
        && request.resource.data.debitAmount is number
        && request.resource.data.debitAmount > 0
        && request.resource.data.outstandingAmount == request.resource.data.debitAmount
        && exists(/databases/$(database)/documents/commercial_invoices/$(request.resource.data.referenceId))
        && get(/databases/$(database)/documents/commercial_invoices/$(request.resource.data.referenceId)).data.customerId == userData().customerId
        && get(/databases/$(database)/documents/commercial_invoices/$(request.resource.data.referenceId)).data.status == 'ISSUED';
    }

    /** ลูกค้าแจ้งร้องขอแก้ไข (Open Dispute) — คงสถานะ PENDING_CUSTOMER */
    function portalCommercialInvoiceRevisionRequestKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'customerRevisionRequestedAt',
        'customerRevisionRequestNote',
        'customerRevisionIssueId',
        'updatedAt',
        'updatedByUid',
        'updatedByName'
      ]);
    }

    /** ลูกค้า (Approver) ตอบรับ/ปฏิเสธใบเสนอราคา — จาก sent → accepted|rejected */
    function portalQuotationPortalDecisionKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'updatedAt',
        'updatedBy',
        'portalDecisionAt',
        'portalDecisionByUid',
        'portalDecisionByName',
        'portalDecisionSource'
      ]);
    }

    /** Portal: read/list only after OPEC marked sent — hide draft/revised from customer */
    function portalQuotationPortalReadOk() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAny(['customerId'])
        && resource.data.customerId == userData().customerId
        && resource.data.status in ['sent', 'accepted', 'rejected', 'expired', 'cancelled'];
    }

    /** Portal approver: request revision (negotiate) while status stays sent */
    function portalQuotationNegotiationRequestKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'customerRevisionRequestedAt',
        'customerRevisionRequestNote',
        'customerRevisionIssueId',
        'updatedAt',
        'updatedBy'
      ]);
    }

    function portalTimesheetBillingLockKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'lockedAt',
        'lockedBy',
        'billingLockedByTaxInvoiceId',
        'lockedForBillingAt',
        'updatedAt'
      ]);
    }

    /** Portal: monthly wave review — read-only after manager approved; wave must belong to customer */
    function portalWaveMonthTimesheetReviewReadable() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['waveId', 'status'])
        && resource.data.waveId is string
        && resource.data.status == 'approved'
        && exists(/databases/$(database)/documents/waves/$(resource.data.waveId))
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.customerId == userData().customerId;
    }

    /** Portal: photo bundle for wave/month — same customer as wave (evidence for billing review; avoids orphan bundle when review doc lags) */
    function portalWaveMonthTimesheetPhotoBundleReadable() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['waveId'])
        && resource.data.waveId is string
        && exists(/databases/$(database)/documents/waves/$(resource.data.waveId))
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/waves/$(resource.data.waveId)).data.customerId == userData().customerId;
    }

    /** Portal: งวด timesheet ราย PO+เดือน — อ่านได้เมื่อผู้จัดการอนุมัติ (ฉบับเดียวกับ invoice/payroll) */
    function portalPoMonthTimesheetReviewReadable() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['poId', 'status'])
        && resource.data.poId is string
        && resource.data.status == 'approved'
        && exists(/databases/$(database)/documents/purchase_orders/$(resource.data.poId))
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.poId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.poId)).data.customerId == userData().customerId;
    }

    function portalPoMonthTimesheetPhotoBundleReadable() {
      return portalCustomerIdOk()
        && resource != null
        && exists(/databases/$(database)/documents/po_month_timesheet_reviews/$(resource.id))
        && get(/databases/$(database)/documents/po_month_timesheet_reviews/$(resource.id)).data.status == 'approved'
        && get(/databases/$(database)/documents/po_month_timesheet_reviews/$(resource.id)).data.poId is string
        && exists(/databases/$(database)/documents/purchase_orders/$(get(/databases/$(database)/documents/po_month_timesheet_reviews/$(resource.id)).data.poId))
        && get(/databases/$(database)/documents/purchase_orders/$(get(/databases/$(database)/documents/po_month_timesheet_reviews/$(resource.id)).data.poId)).data.customerId == userData().customerId;
    }

    // ---------- Admin-only (no overlapping permissive catch-all) ----------
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId) || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
      allow list: if isAdmin() || isOperationsPillarExecutive();
      allow create: if isAdmin()
        || (isOwner(userId) && bootstrapUserCreateValid(userId))
        || (isOwner(userId) && selfRegistrationPendingCreateValid(userId))
        || (isOperationsPillarExecutive() && isCustomerPortalUserCreate(userId))
        || (isOperationsPillarExecutive() && isEmployeeSelfPortalUserCreate(userId));
      allow update: if isAdmin()
        || (isOwner(userId) && !userSecurityFieldChanges())
        || opsExecClientPortalUpdateOk();
      allow delete: if isAdmin()
        || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
    }

    match /roles_system_admin/{id} {
      allow read, write: if isAdmin();
    }

    match /permission_profiles/{id} {
      allow get: if isInternalUser()
        || clientPortalUserActive()
        || isInternalStaffDoc()
        || profileDocIsAssignedToCurrentUser(id);
      allow list: if isInternalUser() || clientPortalUserActive();
      allow write: if isAdmin();
    }

    // UI list: admin only; app services append entries as any internal user.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isInternalUser()
        || (clientPortalUserActive() && request.resource.data.actorUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    /** Demo: เอกสารโควต้ารวมจากหลาย PO — UI อยู่ภายใต้ /system-admin/employee-demo */
    match /employee_quota_documents/{id} {
      allow read, write: if isAdmin();
    }

    /** Demo: จองลูกจ้างตามเอกสารโควต้า */
    match /employee_quota_slots/{id} {
      allow read, write: if isAdmin();
    }

    // Document codes (customers, workers, POs, vendor bills, etc.) — active internal + staff doc (pending activation).
    match /number_sequences/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    // ---------- Accounting-only modules ----------
    match /billing_notes/{id} {
      allow read: if isAccountingOrAdmin() || portalOwnsResourceCustomerId();
      allow write: if isAccountingOrAdmin();
    }
    match /billing_notes/{billingNoteId}/lines/{lineId} {
      allow read: if isAccountingOrAdmin()
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/billing_notes/$(billingNoteId))
            && get(/databases/$(database)/documents/billing_notes/$(billingNoteId)).data.customerId == userData().customerId);
      allow write: if isAccountingOrAdmin();
    }
    match /billing_notes/{billingNoteId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    // DRAFT: บัญชีสร้าง/ออกเอกสารจริง — พนักงานภายในดูได้และแนบรูปสลิปขณะยัง DRAFT เท่านั้น
    // Commercial invoices (draft → customer approval → issued) — not tax invoices; internal creates from timesheet/wave.
    /** Transition to VOID — restricted to admin (internal ops managers must not void via client). */
    function commercialInvoiceTransitionToVoid() {
      return resource.data != null
        && 'status' in resource.data
        && resource.data.status != 'VOID'
        && request.resource.data != null
        && 'status' in request.resource.data
        && request.resource.data.status == 'VOID';
    }

    match /commercial_invoices/{id} {
      // Portal: same customer. DRAFT = readable so the app can show “not shared yet” instead of a rules error (e.g. from timesheet hub links).
      // isInternalStaffDoc: list ได้แม้ approval/activation ยังไม่สมบูรณ์ (เทียบ purchase_orders, worker_month_timesheets, …)
      allow read: if isInternalUser() || isInternalStaffDoc()
        || (portalCustomerIdOk()
            && resource.data.customerId == userData().customerId
            && resource.data.status in ['DRAFT', 'PENDING_CUSTOMER', 'ISSUED', 'VOID']);
      allow create: if isInternalUser() || isInternalStaffDoc();
      allow update: if (commercialInvoiceTransitionToVoid() && isAdmin())
        || (
          !commercialInvoiceTransitionToVoid()
          && (
            isInternalUser() || isInternalStaffDoc()
            || (
              portalIsApprover()
              && portalOwnsResourceCustomerId()
              && resource.data.status == 'PENDING_CUSTOMER'
              && request.resource.data.status == 'ISSUED'
              && portalCommercialInvoiceConfirmKeysOnly()
            )
            || (
              portalIsApprover()
              && portalOwnsResourceCustomerId()
              && resource.data.status == 'PENDING_CUSTOMER'
              && request.resource.data.status == 'PENDING_CUSTOMER'
              && portalCommercialInvoiceRevisionRequestKeysOnly()
            )
            || (
              portalCommercialPaymentReportAllowed()
              && request.resource.data.status == 'ISSUED'
              && portalCommercialPaymentProofKeysOnly()
            )
          )
        );
      /** Admin cannot hard-delete ISSUED (confirmed billing); internal non-admin still only DRAFT. */
      allow delete: if (isAdmin() && resource.data.status != 'ISSUED')
        || ((isInternalUser() || isInternalStaffDoc()) && resource.data.status == 'DRAFT');
    }

    match /tax_invoices/{id} {
      allow read: if isInternalUser() || portalOwnsResourceCustomerId();
      allow create: if isAccountingOrAdmin()
        && request.resource.data.status == 'DRAFT';
      allow update: if isAccountingOrAdmin()
        || (
          isInternalUser()
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'DRAFT'
        )
        || (
          portalIsApprover()
          && portalOwnsResourceCustomerId()
          && resource.data.status == 'DRAFT'
          && request.resource.data.status == 'DRAFT'
          && portalTaxInvoiceBillingApprovalKeysOnly()
        )
        || (
          portalIsApprover()
          && portalOwnsResourceCustomerId()
          && portalTaxInvoicePaymentNotifyAllowed()
          && portalTaxInvoicePaymentNotifyKeysOnly()
        );
      allow delete: if isAccountingOrAdmin();
    }
    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read: if isInternalUser()
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId))
            && get(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId)).data.customerId == userData().customerId);
      allow write: if isAccountingOrAdmin();
    }

    /** ใบเสร็จรับเงิน (ลูกค้า) — อ้างอิงใบกำกับภาษี; read ให้สอดคล้อง tax_invoices (พนักงานภายในดูได้) */
    match /receipts/{id} {
      allow read: if isInternalUser() || portalOwnsResourceCustomerId();
      allow create, update, delete: if isAccountingOrAdmin();
    }

    /**
     * AP Bills — บัญชีเป็นหลัก; ฝั่งคลัง/จัดซื้อต้องลบแถวที่ผูก purchaseId ได้เมื่อลบ PO (cascade)
     * (มิฉะนั้น getDocs(ap_bills where purchaseId==…) จะ permission-denied แม้ลบ purchases ได้)
     */
    function apBillHasPurchaseLink(data) {
      return data != null
        && 'purchaseId' in data
        && (
          (data.purchaseId is string && data.purchaseId.size() > 0)
          /** Legacy/import rows may store DocumentReference instead of string — still tied to a PO */
          || data.purchaseId is path
        );
    }

    match /ap_bills/{id} {
      allow read: if isAccountingOrAdmin()
        || (
          (isInternalUser() || isInternalStaffDoc())
          && resource.data != null
          && apBillHasPurchaseLink(resource.data)
        );
      allow create, update: if isAccountingOrAdmin();
      allow delete: if isAccountingOrAdmin()
        || (
          (isInternalUser() || isInternalStaffDoc())
          && resource.data != null
          && apBillHasPurchaseLink(resource.data)
        );
    }

    match /accounts_receivable/{id} {
      allow read: if isAccountingOrAdmin() || portalOwnsResourceCustomerId();
      allow create: if isAccountingOrAdmin() || portalArComFromCommercialCreateOk();
      allow update, delete: if isAccountingOrAdmin();
    }

    // Internal users may create rows from store workflow (vendor bill); accounting still controls payment in UI.
    // isInternalStaffDoc: ฝ่ายคลัง/ผจก. ที่ยัง pending activation — เทียบ purchases / purchase_requests
    match /accounts_payable/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    /** หัก ณ ที่จ่าย (ผู้รับเงิน) — สะสมรอนำส่งสรรพากร ไม่ตัดบัญชีธนาคารตอนจ่ายคู่ค้า */
    match /withholding_at_source_items/{id} {
      allow read: if isAccountingOrAdmin() || isInternalUser() || isInternalStaffDoc();
      allow write: if isAccountingOrAdmin();
    }

    match /purchase_vendor_bills/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    /** อ่านบัญชีธนาคารสำหรับเลือกบัญชีตัดจ่าย payroll — รวมเมทริกซ์โปรไฟล์ bank_accounts/cashbook.view */
    match /bank_accounts/{id} {
      allow read: if canAccessBankAccountsAndCashbook()
        || internalPayrollDataReader()
        || bankAccountsViewGrantedViaAssignedPermissionProfile();
      allow write: if canAccessBankAccountsAndCashbook();
    }

    match /cashbook_entries/{id} {
      allow read, write: if canAccessBankAccountsAndCashbook();
    }

    /** รับ/จ่าย Petty Cash หน้างาน — ไม่ใช่รายการ cashbook หลัก */
    match /petty_cash_entries/{id} {
      allow read, write: if canAccessBankAccountsAndCashbook();
    }

    match /executive_payroll_runs/{id} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /executive_payroll_runs/{runId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    /** รายชื่อผู้บริหาร + ฐานเงินเดือน — ใช้เฉพาะงวด executive payroll (เมนูบัญชี) */
    match /executive_payroll_staff/{id} {
      allow read, write: if isAccountingOrAdmin();
    }

    // ---------- System docs (read widened where app needs) ----------
    match /system/{docId} {
      allow read: if isAdmin()
        || (docId == 'bootstrap' && isSignedIn())
        || (docId == 'company_profile' && (isInternalUser() || isInternalStaffDoc() || clientPortalUserActive()))
        || (docId == 'drug_test_panel' && isInternalUser());
      allow write: if isAdmin();
    }

    match /approvals/{id} {
      allow read, write: if isInternalUser();
    }

    // ---------- Client portal ----------
    match /client_portal/{document=**} {
      allow read, write: if clientPortalUserActive();
    }

    // ---------- Core operations (all active internal) ----------
    match /customers/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc()
        || (portalCustomerIdOk() && userData().customerId == id);
      allow write: if isInternalUser() || isInternalStaffDoc();
    }
    match /customers/{customerId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    // Portal list/get: customer sees only post-"sent" statuses (draft stays internal-only).
    match /quotations/{id} {
      allow read: if isInternalUser() || portalQuotationPortalReadOk();
      allow create, delete: if isInternalUser();
      allow update: if isInternalUser()
        || (
          portalCustomerIdOk()
          && portalQuotationPortalReadOk()
          && resource.data.status == 'sent'
          && request.resource.data.status == 'sent'
          && request.resource.data.customerId == resource.data.customerId
          && !('customerRevisionRequestedAt' in resource.data)
          && portalQuotationNegotiationRequestKeysOnly()
        )
        || (
          portalIsApprover()
          && portalQuotationPortalReadOk()
          && resource.data.status == 'sent'
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.customerId == resource.data.customerId
          && portalQuotationPortalDecisionKeysOnly()
        );
    }
    match /quotations/{quotationId}/lines/{lineId} {
      allow read: if isInternalUser()
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/quotations/$(quotationId))
            && get(/databases/$(database)/documents/quotations/$(quotationId)).data.customerId == userData().customerId
            && get(/databases/$(database)/documents/quotations/$(quotationId)).data.status
              in ['sent', 'accepted', 'rejected', 'expired', 'cancelled']);
      allow write: if isInternalUser();
    }

    match /main_contracts/{id} {
      allow read: if isInternalUser() || portalOwnsResourceCustomerId();
      allow create: if isInternalUser();
      allow update: if isInternalUser();
      allow delete: if isAdmin();
    }
    match /main_contracts/{contractId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    /** สรุปกลุ่ม PO Active ต่อลูกค้า + โหมดงาน (id = `{customerId}__ONSHORE|OFFSHORE`) — คิวโควต้าใช้ PO โดยตรงได้แม้ยังไม่มีแถวนี้ */
    match /po_active_bundles/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow create, update: if isInternalUser();
      allow delete: if isAdmin();
    }

    match /sales_contract_terms/{id} {
      allow read, write: if isInternalUser();
    }

    match /purchase_orders/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalOwnsResourceCustomerId();
      allow write: if isInternalUser();
    }
    /** PO lines: portal may read workLocation for their PO (site per line). */
    match /purchase_orders/{purchaseOrderId}/po_lines/{lineId} {
      allow read: if isInternalUser()
        || isInternalStaffDoc()
        || (portalCustomerIdOk()
          && get(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)).data.customerId
            == userData().customerId);
      allow write: if isInternalUser();
    }
    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /rate_conditions/{id} {
      allow read, write: if isInternalUser();
    }

    match /profit_estimates/{id} {
      allow read, write: if isInternalUser();
    }

    match /waves/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalOwnsResourceCustomerId();
      allow write: if isInternalUser();
    }

    match /mobilizations/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalOwnsResourceCustomerId();
      /** ให้ payroll_officer / internal_staff อัปเดตสถานะจาก Wave Board (จบงาน → รอ Mob) — เทียบเท่า customer_month_timesheet_documents */
      allow write: if isInternalUser() || isInternalStaffDoc();
    }
    match /mobilizations/{mobId}/fulfillment_lines/{lineId} {
      allow read, write: if isInternalUser();
    }

    match /assignments/{id} {
      allow read, write: if isInternalUser();
    }

    match /worker_wave_acceptances/{id} {
      allow read, write: if isInternalUser();
    }

    match /workers/{workerId} {
      allow read: if isInternalUser()
        || isInternalStaffDoc()
        || (isEmployeeSelfPortalUser()
          && resource.data.keys().hasAll(['linkedUserId'])
          && resource.data.linkedUserId is string
          && resource.data.linkedUserId == request.auth.uid)
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/workers/$(workerId))
            && 'assignedCustomerIds' in get(/databases/$(database)/documents/workers/$(workerId)).data
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds is list
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds.hasAny([userData().customerId]));
      allow write: if isInternalUser() && !isEmployeeSelfPortalUser();
    }
    match /workers/{workerId}/{document=**} {
      allow read: if isInternalUser()
        || isInternalStaffDoc()
        || (isEmployeeSelfPortalUser()
          && exists(/databases/$(database)/documents/workers/$(workerId))
          && get(/databases/$(database)/documents/workers/$(workerId)).data.keys().hasAll(['linkedUserId'])
          && get(/databases/$(database)/documents/workers/$(workerId)).data.linkedUserId is string
          && get(/databases/$(database)/documents/workers/$(workerId)).data.linkedUserId == request.auth.uid)
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/workers/$(workerId))
            && 'assignedCustomerIds' in get(/databases/$(database)/documents/workers/$(workerId)).data
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds is list
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds.hasAny([userData().customerId]));
      allow write: if isInternalUser() && !isEmployeeSelfPortalUser();
    }

    match /positions/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || clientPortalUserActive();
      allow write: if isInternalUser();
    }
    match /positions/{positionId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /labor_cost_contract_terms/{id} {
      allow read, write: if isInternalUser();
    }

    /** อ่านสำหรับหน้าคลัง (custody) — รองรับพนักงานภายในที่ยัง pending activation */
    match /office_staff/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow write: if isInternalUser();
    }

    match /worker_document_catalog/{id} {
      allow read, write: if isInternalUser();
    }

    // Master registries: match app canManage (internal staff) — isInternalStaffDoc สำหรับบัญชีที่ยัง pending/ยังไม่ active ครบ
    match /bank_name_catalog/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }
    match /sso_hospital_catalog/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    /** บันทึกการออกหนังสือรับรองหัก ณ ที่จ่าย (ม.50 ทวิ) — เลขที่ไม่ซ้ำ */
    match /withholding_certificate_issues/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow create: if isInternalUser() || isInternalStaffDoc();
      allow update, delete: if isAdmin();
    }

    /**
     * หนังสือรับรองหัก ณ ที่จ่าย (snapshot + สถานะ) — ควบคุมการแก้ไขหลักในแอป (ISSUED ห้ามแก้ตัวเลข)
     * กฎระดับนี้ยอมให้เจ้าหน้าที่บัญชีสร้าง/อัปเดตได้; รายละเอียด immutable ตรวจที่ client/server เพิ่มเติม
     */
    match /withholding_certificate_documents/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow create: if isAccountingOrAdmin();
      allow update: if isAccountingOrAdmin();
      /**
       * Delete: accounting/admin — plus internal cleanup when removing a purchase-linked cert during PO cascade
       * (UI gate still blocks paid vendor bills / paid milestones).
       */
      allow delete: if isAccountingOrAdmin()
        || (
          (isInternalUser() || isInternalStaffDoc())
          && resource.data != null
          && 'sourcePurchaseId' in resource.data
          && resource.data.sourcePurchaseId is string
          && resource.data.sourcePurchaseId.size() > 0
        );
    }

    match /withholding_certificate_documents/{docId}/audit_logs/{logId} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow create: if isAccountingOrAdmin();
      allow update, delete: if false;
    }

    match /withholding_certificate_documents/{docId}/xml_export_logs/{logId} {
      allow read: if isInternalUser() || isInternalStaffDoc();
      allow create: if isAccountingOrAdmin();
      allow update, delete: if false;
    }

    match /payroll_runs/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /payroll_batches/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }
    match /payroll_batches/{batchId}/{document=**} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /payroll_periods/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /payroll_policies/{id} {
      /** ลูกจ้าง/พนักงานพอร์ทัลอ่านได้เฉพาะนโยบายปฏิทิน-ตัวคูณค่าจ้างกลาง (แสดงใน My Profile) — ไม่เปิดทั้งคอลเลกชัน */
      allow read: if internalPayrollDataReader()
        || (
          id == 'policy_worker_global_labor'
          && isSignedIn()
          && hasUserDoc()
          && !isCustomerPortalData(userData())
        );
      allow write: if isInternalUser();
    }

    match /payroll_correction_requests/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    /** ใบหัก ณ ที่จ่ายจาก payroll ลูกจ้าง — แยกจาก withholding_certificate_documents (คู่ค้า) */
    match /payroll_wht_certificates/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /office_payroll_runs/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }
    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }
    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /payment_export_batches/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    match /wave_month_timesheet_reviews/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalWaveMonthTimesheetReviewReadable();
      allow write: if isInternalUser() || isInternalStaffDoc();
    }

    function portalPoLocationMonthTimesheetReadable() {
      return portalCustomerIdOk()
        && resource != null
        && resource.data.keys().hasAll(['poId'])
        && resource.data.poId is string
        && exists(/databases/$(database)/documents/purchase_orders/$(resource.data.poId))
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.poId)).data.keys().hasAll(['customerId'])
        && get(/databases/$(database)/documents/purchase_orders/$(resource.data.poId)).data.customerId == userData().customerId;
    }

    /** หัวงวด timesheet ราย PO+เดือน+สถานที่ (จาก po_lines) — เฟส B */
    match /po_location_month_timesheets/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalPoLocationMonthTimesheetReadable();
      allow write: if isInternalUser() || isInternalStaffDoc();
    }

    /** งวด timesheet รอบเดือนต่อ PO (หลาย wave) — ใช้ /draft-invoices, /timesheets/po-month, ศูนย์อนุมัติ */
    match /po_month_timesheet_reviews/{id} {
      allow read: if internalPayrollDataReader() || portalPoMonthTimesheetReviewReadable();
      allow write: if internalPayrollDataReader();
    }

    match /po_month_timesheet_photo_bundles/{id} {
      allow read: if isInternalStaffDoc() || portalPoMonthTimesheetPhotoBundleReadable();
      allow write: if isInternalStaffDoc();
    }

    match /wave_month_timesheet_photo_bundles/{id} {
      allow read: if isInternalStaffDoc() || portalWaveMonthTimesheetPhotoBundleReadable();
      allow write: if isInternalStaffDoc();
    }

    match /monthly_timesheet_documents/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    /** แนบรูป/PDF คู่เอกสาร timesheet รายเดือน (TS-) — id = yyyy-MM */
    match /monthly_timesheet_photo_bundles/{id} {
      allow read: if isInternalStaffDoc();
      allow write: if isInternalStaffDoc();
    }

    /** เฟส 2 — หัวเอกสาร timesheet รายเดือนต่อลูกค้า × Onshore/Offshore */
    match /customer_month_timesheet_documents/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser() || isInternalStaffDoc();
    }

    match /daily_timesheets/{id} {
      allow read: if isInternalUser() || isInternalStaffDoc() || portalOwnsResourceCustomerId() || portalDailyTimesheetReadableViaWave() || portalDailyTimesheetReadableViaPo();
      allow create, delete: if isInternalUser();
      allow update: if isInternalUser()
        || (
          portalIsApprover()
          && portalOwnsResourceCustomerId()
          && resource.data.status != 'LOCKED'
          && request.resource.data.status == 'LOCKED'
          && portalTimesheetBillingLockKeysOnly()
        );
    }

    match /exception_requests/{id} {
      allow read: if internalPayrollDataReader();
      allow write: if isInternalUser();
    }

    /** เบิกเงินล่วงหน้า — HR/Payroll workflow (ยืนยันฝั่งผู้ถือเรื่องเมื่อสร้างจาก office) */
    match /cash_advance_requests/{id} {
      /** เงื่อนไขเจ้าของเรื่องมาก่อน — ไม่ต้องประเมิน privileged reader (หลีกเลี่ยง userData() ล้มเมื่อยังไม่มี users/{uid}) */
      allow read: if (
          isSignedIn()
          && resource.data.keys().hasAll(['subjectLinkedUserId'])
          && resource.data.subjectLinkedUserId is string
          && resource.data.subjectLinkedUserId == request.auth.uid
        )
        || cashAdvancePrivilegedReader()
        || cashAdvanceInternalQueueReader();
      allow create: if cashAdvancePrivilegedReader()
        || (
             (isInternalUser() || isInternalStaffDoc())
             && !isEmployeeSelfPortalUser()
             && !isHrOfficerRoleScalar()
           )
        || (isEmployeeSelfPortalUser() && cashAdvanceEmployeeSelfCreateValid());
      allow update: if cashAdvancePrivilegedReader()
        || (
          isSignedIn()
          && resource.data.keys().hasAll(['subjectLinkedUserId'])
          && resource.data.subjectLinkedUserId == request.auth.uid
          && resource.data.status == 'PENDING_SUBJECT_CONFIRMATION'
          && request.resource.data.status == 'PENDING_PAYROLL_REVIEW'
        );
      allow delete: if cashAdvancePrivilegedReader();
    }

    match /customer_issues/{id} {
      allow create: if clientPortalUserActive()
        && request.resource.data.customerId == userData().customerId;
      allow read: if isInternalUser()
        || (portalCustomerIdOk() && resource.data.customerId == userData().customerId);
      allow update, delete: if isInternalUser();
    }

    match /worker_payment_profiles/{id} {
      allow read, write: if isInternalUser();
    }

    match /vendors/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    // PR: ฝ่ายคลัง + ผู้จัดการอนุมัติ — อนุญาต isInternalStaffDoc เหมือน po_month_timesheet_reviews (บัญชียัง pending / activation ยังไม่ครบ)
    match /purchase_requests/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }
    match /purchase_requests/{prId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    // รายการซื้อ/ใบสั่งซื้อ: ฝ่ายคลัง + ผจก.ฝ่ายอนุมัติ — รองรับ isInternalStaffDoc (บัญชี internal ยัง pending activation)
    match /purchases/{purchaseId} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }
    match /purchases/{purchaseId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    // คลังสินค้า: เทียบ purchases / purchase_requests — รองรับ isInternalStaffDoc (บัญชียัง pending activation)
    match /store_items/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_transactions/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_receipts/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_issue_slips/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_return_slips/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_writeoffs/{id} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_receipts/{receiptId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_issue_slips/{slipId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_return_slips/{returnId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /store_writeoffs/{writeoffId}/{document=**} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /{path=**}/po_lines/{lineId} {
      allow read, write: if isInternalUser() || isInternalStaffDoc();
    }

    match /{path=**}/position_rates/{rateId} {
      allow read, write: if isInternalUser();
    }

    match /{path=**}/lines/{lineId} {
      allow read, write: if isInternalUser();
    }

    // Deny by default (no broad catch-all OR with admin paths).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
