
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Security Rules
     * Core Philosophy: Role-Based Access Control (RBAC) via DBAC.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_$(role)/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() && (
        hasRole('system_admin') || 
        hasRole('hr_manager') || 
        hasRole('hr_officer') || 
        hasRole('operations_officer') ||
        hasRole('safety_officer') ||
        hasRole('sales_officer') || 
        hasRole('finance_officer') || 
        hasRole('payroll_officer') || 
        hasRole('store_officer')
      );
    }

    function isSystemAdmin() { return hasRole('system_admin'); }
    function isHRStaff() { return isSignedIn() && (hasRole('system_admin') || hasRole('hr_manager') || hasRole('hr_officer')); }
    function isSalesStaff() { return isSignedIn() && (hasRole('system_admin') || hasRole('sales_officer')); }
    function isOpsStaff() { return isSignedIn() && (hasRole('system_admin') || hasRole('operations_officer') || hasRole('hr_officer') || hasRole('hr_manager')); }
    function isStoreStaff() { return isSignedIn() && (hasRole('system_admin') || hasRole('store_officer') || hasRole('operations_officer')); }
    function isClient() { return isSignedIn() && (hasRole('client_user') || hasRole('client')); }

    match /users/{userId} {
      allow get: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isStaff();
      allow write: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /workers {
      allow list: if isStaff();
      match /{workerId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        match /{sub=**} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    match /positions {
      allow list: if isStaff();
      match /{positionId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        match /{sub=**} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    match /waves/{waveId} {
      allow read: if isStaff();
      allow write: if isOpsStaff();
      match /{sub=**} { 
        allow read: if isStaff(); 
        allow write: if isOpsStaff(); 
      }
    }

    match /customers {
      allow list: if isStaff();
      match /{customerId} {
        allow get: if isStaff() || (isClient() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == customerId);
        allow write: if isSalesStaff();
        match /{sub=**} { 
          allow read: if isStaff() || (isClient() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == customerId);
          allow write: if isSalesStaff(); 
        }
      }
    }

    match /client_users/{uid} {
      allow get: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isStaff();
      allow write: if isStaff();
    }

    match /main_contracts {
      allow list: if isStaff() || isClient();
      match /{id} {
        allow get: if isStaff() || (isClient() && resource.data.customerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId);
        allow write: if isSalesStaff();
        match /{sub=**} { 
          allow read: if isStaff() || (isClient() && get(/databases/$(database)/documents/main_contracts/$(id)).data.customerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId);
          allow write: if isSalesStaff(); 
        }
      }
    }

    match /purchase_orders {
      allow list: if isStaff() || isClient();
      match /{poId} {
        allow get: if isStaff() || (isClient() && resource.data.customerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId);
        allow write: if isSalesStaff();
        match /po_lines/{lineId} {
          allow read: if isStaff() || isClient();
          allow write: if isSalesStaff();
          match /assignments/{asgnId} {
            allow read: if isStaff() || isClient();
            allow write: if isHRStaff();
          }
        }
      }
    }

    match /{path=**}/assignments/{asgnId} {
      allow read: if isStaff() || isClient();
    }

    // Store / Inventory Rules
    match /store_items/{itemId} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
    }
    match /store_transactions/{txId} {
      allow read: if isStaff();
      allow create: if isStoreStaff();
    }
    match /store_issue_slips/{id} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
      match /items/{lineId} { allow read: if isStaff(); allow write: if isStoreStaff(); }
    }
    match /store_return_slips/{id} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
      match /items/{lineId} { allow read: if isStaff(); allow write: if isStoreStaff(); }
    }

    match /roles_hr_manager/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_hr_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_system_admin/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_sales_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_safety_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_operations_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_finance_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_payroll_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_store_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_client_user/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_client/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    
    match /system/bootstrap { allow read: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
