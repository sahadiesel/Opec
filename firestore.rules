rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Security Rules
     * Core Philosophy: Role-Based Access Control (RBAC) via DBAC.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Optimized Role Check
    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_$(role)/$(request.auth.uid));
    }

    // Role check helpers
    function isSystemAdmin() { return hasRole('system_admin'); }
    function isHRManager() { return hasRole('hr_manager'); }
    function isHROfficer() { return hasRole('hr_officer'); }
    function isSalesOfficer() { return hasRole('sales_officer'); }
    function isFinanceOfficer() { return hasRole('finance_officer'); }
    function isPayrollOfficer() { return hasRole('payroll_officer'); }
    function isStoreOfficer() { return hasRole('store_officer'); }

    // Combined Staff check
    function isStaff() {
      return isSignedIn() && (
        isSystemAdmin() || 
        isHRManager() || 
        isHROfficer() || 
        isSalesOfficer() || 
        isFinanceOfficer() || 
        isPayrollOfficer() || 
        isStoreOfficer()
      );
    }

    function isHRStaff() {
      return isSignedIn() && (isSystemAdmin() || isHRManager() || isHROfficer());
    }

    function isSalesStaff() {
      return isSignedIn() && (isSystemAdmin() || isSalesOfficer());
    }

    // Collection Group support
    match /{path=**}/assignments/{asgnId} { 
      allow read: if isStaff() || (isSignedIn() && resource.data.customerId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId); 
      allow write: if isStaff();
    }
    match /{path=**}/purchase_orders/{poId} { allow read: if isStaff(); allow write: if isSalesStaff(); }
    match /{path=**}/main_contracts/{id} { allow read: if isStaff(); allow write: if isSalesStaff(); }
    match /{path=**}/po_lines/{lineId} { allow read: if isStaff(); allow write: if isSalesStaff(); }

    // Users
    match /users/{userId} {
      allow get: if isStaff() || (isSignedIn() && request.auth.uid == userId);
      allow list: if isStaff();
      allow write: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    // Master Data
    match /workers {
      allow list: if isStaff();
      match /{workerId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        match /{sub=**} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    match /positions {
      allow list: if isStaff();
      match /{positionId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        match /{sub=**} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    // Commercial Hierarchy
    match /customers {
      allow list: if isStaff();
      match /{customerId} {
        allow get: if isStaff();
        allow write: if isSalesStaff();
        match /{sub=**} { allow read: if isStaff(); allow write: if isSalesStaff(); }
      }
    }

    // Roles & System Bootstrap
    match /roles_hr_manager/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_hr_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_system_admin/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_sales_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_finance_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_payroll_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_store_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    
    match /system/bootstrap { allow read: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
