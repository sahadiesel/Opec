
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Safely fetches the user document if it exists. */
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    /** Checks if the user has a specific role. */
    function hasRole(roleName) {
      let user = getUserData();
      return isSignedIn() && user != null && (
        user.roleId == roleName || 
        (user.roleIds != null && user.roleIds.hasAny([roleName])) ||
        user.assignedRoleKey == roleName
      );
    }

    function isHRStaff() {
      return hasRole('hr_manager') || hasRole('hr_officer') || hasRole('payroll_officer') || hasRole('system_admin');
    }

    function isOperationsStaff() {
      return hasRole('operations_officer') || hasRole('operations_manager') || hasRole('safety_officer') || hasRole('system_admin');
    }

    function isAccountingStaff() {
      return hasRole('accounting_manager') || hasRole('accounting_officer') || hasRole('finance_officer') || hasRole('system_admin');
    }

    function isSalesStaff() {
      return hasRole('sales_officer') || hasRole('sales_manager') || hasRole('system_admin');
    }

    function isStoreStaff() {
      return hasRole('store_officer') || hasRole('store_manager') || hasRole('system_admin');
    }

    function isInternalStaff() {
      return isHRStaff() || isOperationsStaff() || isAccountingStaff() || isSalesStaff() || isStoreStaff();
    }

    function isClient() {
      return hasRole('client_user') || hasRole('client') || hasRole('client_approver') || hasRole('client_viewer');
    }

    function isClientOf(cid) {
      return isClient() && getUserData().customerId == cid;
    }

    /** Security Safeguard: Only system_admin can modify security fields. */
    function isModifyingSecurityFields() {
      let securityFields = [
        'roleId', 'roleIds', 
        'assignedRoleKey', 'assignedRoleKeys', 
        'permissionProfileKey', 'permissionProfileKeys', 
        'department', 'level', 
        'isActive', 'approvalStatus',
        'customerId', 'userType', 'portalRole', 'mustResetPassword'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(securityFields);
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isInternalStaff();
      allow create: if isOwner(userId) || hasRole('system_admin');
      allow update: if (isOwner(userId) && !isModifyingSecurityFields()) || hasRole('system_admin');
      allow delete: if hasRole('system_admin');
    }

    match /workers/{id} {
      allow read: if isInternalStaff() || isClient();
      allow write: if isHRStaff();
    }

    match /positions/{id} {
      allow read: if isInternalStaff() || isClient();
      allow write: if isHRStaff();
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if isHRStaff() || isAccountingStaff();
      allow write: if isHRStaff();
    }

    match /payroll_runs/{id} {
      allow read, write: if isHRStaff() || isAccountingStaff();
    }

    match /payroll_batches/{id} {
      allow read, write: if isHRStaff() || isAccountingStaff();
    }

    match /office_payroll_runs/{id} {
      allow read, write: if isHRStaff() || isAccountingStaff();
    }

    match /waves/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isOperationsStaff();
    }

    match /mobilizations/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isOperationsStaff() || isHRStaff();
    }

    match /vendors/{id} {
      allow read: if isInternalStaff();
      allow write: if isStoreStaff() || isAccountingStaff();
    }

    match /purchases/{id} {
      allow read: if isInternalStaff();
      allow write: if isStoreStaff() || isAccountingStaff();
    }

    match /store_items/{id} {
      allow read: if isInternalStaff();
      allow write: if isStoreStaff();
    }

    match /store_transactions/{id} {
      allow read: if isInternalStaff();
      allow write: if isStoreStaff();
    }

    match /customers/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff() || isAccountingStaff();
    }

    match /quotations/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isSalesStaff();
    }

    match /main_contracts/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff() || isAccountingStaff();
    }

    match /sales_contract_terms/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff() || isAccountingStaff();
    }

    match /purchase_orders/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isSalesStaff() || isAccountingStaff() || isOperationsStaff();
    }

    match /billing_notes/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isAccountingStaff();
    }

    match /tax_invoices/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isAccountingStaff();
    }

    match /receipts/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isAccountingStaff();
    }

    match /accounts_receivable/{id} {
      allow read, write: if isAccountingStaff();
    }

    match /accounts_payable/{id} {
      allow read, write: if isAccountingStaff();
    }

    match /bank_accounts/{id} {
      allow read: if isInternalStaff();
      allow write: if isAccountingStaff();
    }

    match /cashbook_entries/{id} {
      allow read, write: if isAccountingStaff();
    }

    match /number_sequences/{id} {
      allow read: if isSignedIn();
      allow write: if isInternalStaff();
    }

    match /audit_logs/{id} {
      allow read: if isSystemAdmin() || hasRole('hr_manager') || hasRole('accounting_manager');
      allow create: if isSignedIn();
    }

    match /permission_profiles/{id} {
      allow read: if isSignedIn();
      allow write: if hasRole('system_admin');
    }

    match /rate_conditions/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff() || isHRStaff() || isAccountingStaff();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if hasRole('system_admin');
    }
  }
}
