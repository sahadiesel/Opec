        || (docId == 'company_profile' && (canReadQuotationsInternal() || clientPortalUserActive()))
        || (docId == 'drug_test_panel' && (canReadWorkers() || clientPortalUserActive()));
    }
    function systemBootstrapCreateOk(docId) {
      return docId == 'bootstrap'
        && isAdmin()
        && !exists(/databases/$(database)/documents/system/bootstrap);
    }
    function numberSequenceAllowsWrite(seqId) {
      return isAdmin()
        || (
          hasUserDoc()
          && (
            (seqId == 'main_contract' && canWriteCommercialDocs())
            || (seqId == 'customer' && canWriteCustomers())
            || (seqId == 'customer_po' && canWriteCommercialDocs())
            || (seqId == 'quotation' && canWriteQuotations())
            || (seqId == 'sales_term' && canWriteCommercialDocs())
            || (seqId == 'cost_term' && canWriteLaborCostContractTerms())
            || (seqId == 'billing_note' && canWriteAccountingDocs())
            || (seqId == 'tax_invoice' && canWriteAccountingDocs())
            || (seqId == 'money_receipt' && canWriteAccountingDocs())
            || (seqId == 'commercial_invoice' && canIssueCommercialInvoiceSequence())
            || (seqId == 'ap_bill' && canWriteAccountingDocs())
            || (seqId == 'ar' && canWriteAccountingDocs())
            || (seqId == 'ap' && (canWriteAccountingDocs() || canWritePurchases()))
            || (seqId == 'cashbook_entry' && canWriteAccountingDocs())
            || (seqId == 'petty_cash_entry' && bankAccountsWriteAllowed())
            || (seqId == 'bank_account' && canWriteAccountingDocs())
            || (seqId == 'petty_cash_account' && canWriteAccountingDocs())
            || (seqId == 'office_staff' && canWriteWorkers())
            || (seqId == 'worker' && canWriteWorkers())
            || (seqId == 'position' && canCreatePositions())
            || (seqId == 'wave' && canWriteOpsScheduling())
            || (seqId == 'assignment' && canWriteOpsScheduling())
            || (seqId == 'purchase_request' && canWritePurchases())
            || (seqId == 'purchase' && canWritePurchases())
            || (seqId == 'purchase_vendor_bill' && canWritePurchases())
            || (seqId == 'cash_advance' && canIssueCashAdvanceSequence())
            || (seqId == 'vendor' && canCreateVendors())
            || (seqId == 'store_receive' && canWriteStoreInventory())
            || (seqId == 'store_issue' && canWriteStoreInventory())
            || (seqId == 'store_return' && canWriteStoreInventory())
            || (seqId == 'store_writeoff' && canWriteStoreInventory())
            || (seqId == 'store_item_equipment' && canWriteStoreInventory())
            || (seqId == 'store_item_ppe' && canWriteStoreInventory())
            || (seqId == 'payroll_run' && canPreparePayroll())
            || (seqId == 'office_payroll_run' && canPrepareOfficePayrollRunDoc())
            || (seqId == 'executive_payroll_run' && (canWriteAccountingDocs() || canManagePayrollFinancial()))
            || (seqId == 'executive_payroll_staff' && canWriteAccountingDocs())
            || (seqId == 'monthly_timesheet' && canWriteDailyTimesheet())
            || (seqId == 'customer_month_timesheet' && canWriteDailyTimesheet())
            || (seqId == 'wht_certificate_50' && canWriteAccountingDocs())
          )
        );
    }
    function clientPortalUserActive() {
      return hasUserDoc()
        && isCustomerPortalData(userData())
        && isActiveStatus(userData());
    }
    function roleIs(d, key) {
      return primaryRole(d) == key;
    }
    function internalActiveOrStaff() {
      return hasUserDoc() && (isInternalUser() || isInternalStaffDoc());
    }
    function canIssueCommercialInvoiceSequence() {
      return internalActiveOrStaff()
        && !roleIs(userData(), 'store_officer')
        && (
          canReadCommercialDocs()
          || canReadTimesheetsInternal()
          || canReadAccountingInternal()
        );
    }
    function roleIsAccounting(d) {
      return roleIs(d, 'accounting_manager') || roleIs(d, 'accounting_officer');
    }
    function attendanceKioskSessionGate(token) {
      let p = /databases/$(database)/documents/attendance_kiosk_sessions/$(token);
      return exists(p)
        && get(p).data.keys().hasAll(['expiresAt', 'active', 'createdByUid', 'createdAt'])
        && get(p).data.active == true
        && kioskSessionStillActive(get(p).data.expiresAt);
    }
    function punchSubjectLinkedToCaller(subjectType, subjectId) {
      let path = subjectType == 'worker'
        ? /databases/$(database)/documents/workers/$(subjectId)
        : /databases/$(database)/documents/office_staff/$(subjectId);
      return exists(path)
        && 'linkedUserId' in get(path).data
        && get(path).data.linkedUserId is string
        && get(path).data.linkedUserId.size() > 0
        && get(path).data.linkedUserId == request.auth.uid;
    }
    function attendanceCorrectionSubmitter() {
      return hasUserDoc()
        && isInternalUser()
        && (isAdmin() || roleIs(userData(), 'payroll_officer'));
    }
    function attendanceCorrectionManager() {
      return hasUserDoc()
        && isInternalUser()
        && (isAdmin() || roleIs(userData(), 'hr_manager') || roleIs(userData(), 'operations_manager'));
    }
    function officeStaffLinkedToCallerById(staffId) {
      let s = /databases/$(database)/documents/office_staff/$(staffId);
      return exists(s)
        && 'linkedUserId' in get(s).data
        && get(s).data.linkedUserId is string
        && get(s).data.linkedUserId.size() > 0
        && get(s).data.linkedUserId == request.auth.uid;
    }
    function leaveRequestDraftEditorAllowed() {
      return internalPayrollDataReader()
        || (
          leaveRequestOwnedByCaller()
          && resource.data.createdByUid == request.auth.uid
        );
    }
    function isAccountingOrAdmin() {
      return isAdmin() || isAccounting();
    }
    function isOperationsManagerRole() {
      return hasUserDoc()
        && (isInternalUser() || isInternalStaffDoc())
        && (
          roleKeyIsOperationsManager(primaryRole(userData()))
          || isInternalOperationsManagerPartition(userData())
        );
    }
    function procurementReadCore() {
      return internalActiveOrStaff()
        && !roleIs(userData(), 'hr_officer')
        && !roleIs(userData(), 'payroll_officer')
        && !roleIs(userData(), 'accounting_officer');
    }
    function isInternalOperationsManagerPartition(d) {
      return d != null
        && isInternalTypeData(d)
        && !isCustomerPortalData(d)
        && accessLevelIsManager(d)
        && (
          ('accessGroup' in d && (d.accessGroup == 'operations' || d.accessGroup == 'operation'))
          || ('departmentGroup' in d && (d.departmentGroup == 'operations' || d.departmentGroup == 'operation'))
          || (
            'department' in d
            && d.department is string
            && (d.department.lower() == 'operations' || d.department.lower() == 'operation')
          )
        )
        && primaryRole(d) != 'hr_manager'
        && primaryRole(d) != 'sales_manager'
        && primaryRole(d) != 'store_officer';
    }
    function canReadQuotationsInternal() {
      return internalActiveOrStaff()
        && !roleIs(userData(), 'store_officer');
    }
    function canWriteQuotations() {
      return isAdmin()
        || (
          isInternalUser()
          && (
            roleIs(userData(), 'sales_officer')
            || roleIs(userData(), 'operations_manager')
            || roleIs(userData(), 'operations_officer')
            || roleIs(userData(), 'hr_manager')
            || roleIs(userData(), 'accounting_manager')
          )
        );
    }
    function canWriteLaborCostContractTerms() {
      return canWriteWorkers()
        || (isInternalUser() && roleIs(userData(), 'sales_manager'));
    }
    function bankAccountsWriteAllowed() {
      return hasUserDoc() && bankAccountsWriteAllowedForUser(userData());
    }
    function canWriteOpsScheduling() {
      return isAdmin()
        || (
          isInternalUser()
          && (
            roleIs(userData(), 'operations_manager')
            || roleIs(userData(), 'operations_officer')
            || roleIs(userData(), 'hr_manager')
            || roleIs(userData(), 'hr_officer')
            || roleIs(userData(), 'sales_manager')
            || roleIs(userData(), 'sales_officer')
            || roleIs(userData(), 'accounting_manager')
          )
        );
    }
    function canIssueCashAdvanceSequence() {
      return cashAdvancePrivilegedReader()
        || (
          (isInternalUser() || isInternalStaffDoc())
          && !isEmployeeSelfPortalUser()
          && !isHrOfficerRoleScalar()
        )
        || isEmployeeSelfPortalUser();
    }
    function canCreateVendors() {
      return isAdmin()
        || (
          isInternalUser()
          && (
            roleIs(userData(), 'store_officer')
            || roleIs(userData(), 'operations_manager')
            || roleIs(userData(), 'sales_manager')
            || roleIs(userData(), 'accounting_manager')
          )
        );
    }
    function canWriteStoreInventory() {
      return isAdmin()
        || (
          isInternalUser()
          && (
            roleIs(userData(), 'store_officer')
            || roleIs(userData(), 'operations_manager')
            || roleIs(userData(), 'operations_officer')
          )
        );
    }
    function canPrepareOfficePayrollRunDoc() {
      return isAdmin()
        || roleIs(userData(), 'hr_manager')
        || roleIs(userData(), 'hr_officer')
        || roleIs(userData(), 'payroll_officer')
        || roleIs(userData(), 'accounting_manager');
    }
    function canManagePayrollFinancial() {
      return isAdmin()
        || roleIsAccounting(userData())
        || roleIs(userData(), 'payroll_officer')
        || roleIs(userData(), 'hr_manager')
        || roleIs(userData(), 'operations_manager');
    }
    function kioskSessionStillActive(expMs) {
      return (expMs is int || expMs is float)
        && expMs > request.time.toMillis() - 120000;
    }
    function roleKeyIsOperationsManager(k) {
      return k == 'operations_manager' || k == 'operation_manager';
    }
    function accessLevelIsManager(d) {
      return d != null && (
        ('accessLevel' in d && d.accessLevel is string && d.accessLevel.lower() == 'manager')
        || ('level' in d && d.level is string && d.level.lower() == 'manager')
      );
    }
    function bankAccountsWriteAllowedForUser(u) {
      return pettyCashSiteUserDocOk(u)
        || accountingOrAdminOnUserDoc(u)
        || roleIs(u, 'accounting_manager');
    }
    function pettyCashSiteUserDocOk(d) {
      return d != null
        && isInternalTypeData(d)
        && !isCustomerPortalData(d)
        && (
          roleKeyIsOperationsManager(primaryRole(d))
          || isInternalOperationsManagerPartition(d)
        );
    }
    function accountingOrAdminOnUserDoc(d) {
      return d != null
        && isInternalTypeData(d)
        && !isCustomerPortalData(d)
        && isActiveStatus(d)
        && (roleIsAdmin(d) || roleIsAccounting(d));
    }
    function roleIsAdmin(d) {
      return roleIs(d, 'system_admin')
        || roleIs(d, 'admin_admin')
        || (d != null && ('accessGroup' in d) && stringLowerEqAdmin(d.accessGroup));
    }
    function stringLowerEqAdmin(v) {
      return v is string && v.size() > 0 && v.lower() == 'admin';
    }
