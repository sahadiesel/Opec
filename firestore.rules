rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Firestore Security Rules
     * 
     * แนวคิดหลัก:
     * - ใช้ DBAC / RBAC โดยเก็บ role เป็น document ตาม collection: 
     *   roles_system_admin/{uid}, roles_hr_manager/{uid}, ...
     * - แยก Staff/Users ออกจาก Workers ชัดเจน
     * - ใช้ document-level match paths ให้รองรับ get/list/query ได้ถูกต้อง
     * - เปิดเฉพาะเส้นทางที่ต้องใช้จริง และปิดทุกอย่างที่เหลือ
     */

    // =========================
    // Helper Functions
    // =========================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ตรวจสอบสิทธิ์ผ่านคอลเลกชันบทบาท (DBAC)
    function hasRole(role) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/roles_$(role)/$(request.auth.uid)) ||
        (role == 'system_admin' && exists(/databases/$(database)/documents/system/bootstrap) && 
         get(/databases/$(database)/documents/system/bootstrap).data.initializedBy == request.auth.uid)
      );
    }

    function isSystemAdmin() { return hasRole('system_admin'); }
    function isHRManager() { return hasRole('hr_manager') || isSystemAdmin(); }
    function isHROfficer() { return hasRole('hr_officer') || isHRManager(); }
    function isSalesOfficer() { return hasRole('sales_officer') || isSystemAdmin(); }
    function isFinanceOfficer() { return hasRole('finance_officer') || isSystemAdmin(); }
    function isPayrollOfficer() { return hasRole('payroll_officer') || isHRManager(); }
    function isStoreOfficer() { return hasRole('store_officer') || isSystemAdmin(); }
    function isOperationsOfficer() { return hasRole('operations_officer') || isSystemAdmin(); }
    function isSafetyOfficer() { return hasRole('safety_officer') || isSystemAdmin(); }
    function isClient() { return hasRole('client') || hasRole('client_user'); }

    function isStaff() {
      return isSystemAdmin() || 
             hasRole('hr_manager') || hasRole('hr_officer') || 
             hasRole('operations_officer') || hasRole('safety_officer') ||
             hasRole('sales_officer') || hasRole('finance_officer') || 
             hasRole('payroll_officer') || hasRole('store_officer');
    }

    function isHRStaff() { return isHRManager() || isHROfficer(); }
    function isCommercialStaff() { return isSalesOfficer() || isFinanceOfficer(); }
    function isOpsStaff() { return isOperationsOfficer() || isHRStaff(); }
    function isFinanceStaff() { return isFinanceOfficer() || isHRManager() || isSystemAdmin(); }
    function isStoreStaff() { return isStoreOfficer() || isOperationsOfficer(); }

    // =========================
    // System / Bootstrap
    // =========================
    
    match /system/bootstrap {
      allow read: if true;
      allow write: if !exists(/databases/$(database)/documents/system/bootstrap);
    }

    // =========================
    // Role Management (DBAC)
    // =========================
    
    match /roles_{roleName}/{uid} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    // =========================
    // Users & Staff Profiles
    // =========================
    
    match /users/{userId} {
      allow list: if isStaff();
      allow get: if isStaff() || isSelf(userId);
      allow write: if isSystemAdmin() || isSelf(userId);
    }

    match /audit_logs/{logId} {
      allow read: if isSystemAdmin();
      allow create: if isSignedIn();
    }

    // =========================
    // Master Data
    // =========================
    
    match /positions/{positionId} {
      allow read: if isStaff();
      allow write: if isHRStaff() || isSafetyOfficer();
      match /{sub=**} {
        allow read: if isStaff();
        allow write: if isHRStaff() || isSafetyOfficer();
      }
    }

    match /workers/{workerId} {
      allow read: if isStaff() || isClient();
      allow write: if isHRStaff();
      match /{sub=**} {
        allow read: if isStaff() || isClient();
        allow write: if isHRStaff();
      }
    }

    match /office_staff/{staffId} {
      allow read: if isStaff();
      allow write: if isHRStaff();
    }

    match /vendors/{vendorId} {
      allow read: if isStaff();
      allow write: if isStoreStaff() || isFinanceOfficer();
    }

    match /bank_accounts/{accountId} {
      allow read: if isStaff();
      allow write: if isFinanceStaff();
    }

    match /customers/{customerId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff();
      match /{sub=**} {
        allow read: if isStaff() || isClient();
        allow write: if isCommercialStaff();
      }
    }

    // =========================
    // Commercial & Contracts
    // =========================
    
    match /main_contracts/{contractId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff();
      match /{sub=**} {
        allow read: if isStaff() || isClient();
        allow write: if isCommercialStaff() || isHRManager();
      }
    }

    match /purchase_orders/{poId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff();
      match /{sub=**} {
        allow read: if isStaff() || isClient();
        allow write: if isCommercialStaff() || isHRStaff();
      }
    }

    match /billing_notes/{noteId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff() || isFinanceStaff();
      match /lines/{lineId} {
        allow read: if isStaff() || isClient();
        allow write: if isCommercialStaff() || isFinanceStaff();
      }
    }

    // =========================
    // Purchasing & AP
    // =========================

    match /purchases/{purchaseId} {
      allow read: if isFinanceStaff() || isStoreStaff();
      allow write: if isFinanceStaff() || isStoreStaff();
      match /lines/{lineId} {
        allow read: if isFinanceStaff() || isStoreStaff();
        allow write: if isFinanceStaff() || isStoreStaff();
      }
    }

    match /ap_bills/{billId} {
      allow read: if isFinanceStaff();
      allow write: if isFinanceStaff();
    }

    // =========================
    // Operations & Store
    // =========================
    
    match /waves/{waveId} {
      allow read: if isStaff();
      allow write: if isOpsStaff();
      match /{sub=**} {
        allow read: if isStaff();
        allow write: if isOpsStaff();
      }
    }

    match /assignments/{asgnId} {
      allow read: if isStaff() || isClient();
      allow write: if isOpsStaff() || isHRStaff();
    }

    match /store_items/{itemId} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
    }

    match /store_transactions/{txId} {
      allow read: if isStaff();
      allow create: if isStoreStaff();
    }

    match /store_issue_slips/{id} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
    }

    match /store_return_slips/{id} {
      allow read: if isStaff();
      allow write: if isStoreStaff();
    }

    // =========================
    // Finance & Payroll
    // =========================
    
    match /payroll_runs/{runId} {
      allow read: if isPayrollOfficer() || isFinanceOfficer();
      allow create: if isPayrollOfficer() || isHRManager();
      allow update: if isPayrollOfficer() || isFinanceOfficer();
      allow delete: if isSystemAdmin();
      match /lines/{lineId} {
        allow read: if isPayrollOfficer() || isFinanceOfficer();
        allow write: if isPayrollOfficer() || isHRManager();
      }
    }

    match /office_payroll_runs/{runId} {
      allow read: if isFinanceStaff();
      allow create: if isFinanceStaff();
      allow update: if isFinanceStaff();
      allow delete: if isSystemAdmin();
      match /lines/{lineId} {
        allow read: if isFinanceStaff();
        allow write: if isFinanceStaff();
      }
    }

    // =========================
    // Billing & AR
    // =========================

    match /tax_invoices/{invoiceId} {
      allow read: if isFinanceStaff() || isSalesOfficer();
      allow write: if isFinanceStaff();
    }

    match /receipts/{receiptId} {
      allow read: if isFinanceStaff();
      allow write: if isFinanceStaff();
      match /allocations/{allocId} {
        allow read: if isFinanceStaff();
        allow write: if isFinanceStaff();
      }
    }

    match /accounts_receivable/{arId} {
      allow read: if isFinanceStaff();
      allow write: if isFinanceStaff();
    }

    // =========================
    // Collection Group Support
    // =========================
    
    match /{path=**}/assignments/{asgnId} {
      allow read: if isStaff() || isClient();
      allow write: if isOpsStaff() || isHRStaff();
    }

    match /{path=**}/purchase_orders/{poId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff();
    }

    match /{path=**}/po_lines/{lineId} {
      allow read: if isStaff() || isClient();
      allow write: if isCommercialStaff();
    }

    // =========================
    // Default Deny
    // =========================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
