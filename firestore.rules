    // ----- จ่ายเงินคนงาน (worker_payroll) -----
    function canFullWorkerPayroll() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- รอบจ่ายคนงาน (payroll_runs) -----
    function canFullPayrollRuns() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- สลิปเงินเดือนคนงาน (payslips) -----
    function canFullPayslips() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- เงินเดือนออฟฟิศ (office_payroll) -----
    function canFullOfficePayroll() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- ไฟล์โอนเงินธนาคาร (payment_export_batches) -----
    function canFullPaymentExportBatches() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- เบิกเงินล่วงหน้า (cash_advances) -----
    function canReadCashAdvanceRequests() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'operations_manager', 'accounting_manager', 'accounting_officer', 'employee_self']); }
    function canCreateCashAdvanceRequests() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'operations_manager', 'accounting_manager', 'accounting_officer', 'employee_self']); }
    function canEditCashAdvanceRequests() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canDeleteCashAdvanceRequests() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canApproveCashAdvanceRequests() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'payroll_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ----- ศูนย์กลาง HR (configuration) (hr_hub) -----
    function canFullHrHub() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ===== Self / Overview — Gates =====
    // ----- โปรไฟล์ของฉัน (employee_self_profile) -----
    function canReadEmployeeSelfProfile() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'operations_officer', 'timekeeper', 'accounting_manager', 'accounting_officer', 'employee_self']); }
    function canCreateEmployeeSelfProfile() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'operations_officer', 'timekeeper', 'accounting_manager', 'accounting_officer', 'employee_self']); }
    function canEditEmployeeSelfProfile() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'operations_officer', 'timekeeper', 'accounting_manager', 'accounting_officer', 'employee_self']); }
    function canDeleteEmployeeSelfProfile() { return (isInternalUser() && userRole() in ['system_admin']); }
    function canApproveEmployeeSelfProfile() { return (isInternalUser() && userRole() in ['system_admin']); }
    // ----- แดชบอร์ดหลัก (overview_dashboard) -----
    function canReadOverviewDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'operations_officer', 'timekeeper', 'accounting_manager', 'accounting_officer']); }
    function canCreateOverviewDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canEditOverviewDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canDeleteOverviewDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canApproveOverviewDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    // ===== Accounting (บัญชี) — Gates =====
    // ----- แดชบอร์ดบัญชี (accounting_dashboard) -----
    function canFullAccountingDashboard() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- ใบวางบิลลูกหนี้ (billing_notes) -----
    function canFullBillingNotes() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- ใบกำกับภาษี (tax_invoices) -----
    function canReadTaxInvoices() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canCreateTaxInvoices() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    function canEditTaxInvoices() { return (isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer', 'sales_manager', 'sales_officer', 'store_officer', 'operations_manager', 'accounting_manager', 'accounting_officer']); }
    function canDeleteTaxInvoices() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    function canApproveTaxInvoices() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- ใบเสร็จรับเงิน (receipts) -----
    function canFullReceipts() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- รับวางบิลเจ้าหนี้ (ap_bills) -----
    function canFullApBills() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- ลูกหนี้การค้า (AR) (accounts_receivable) -----
    function canFullAccountsReceivable() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- เจ้าหนี้การค้า (AP) (accounts_payable) -----
    function canFullAccountsPayable() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- หัก ณ ที่จ่าย (withholding_tax_items) -----
    function canFullWithholdingTaxItems() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- สมุดรับ-จ่าย (cashbook) -----
    function canFullCashbook() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- บัญชีธนาคาร (bank_accounts) -----
    function canFullBankAccounts() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ----- เงินเดือนผู้บริหาร (executive_payroll) -----
    function canFullExecutivePayroll() { return (isInternalUser() && userRole() in ['system_admin', 'accounting_manager', 'accounting_officer']); }
    // ===== Administration (ระบบ) — Gates =====
    // ----- จัดการระบบ (system_admin) -----
    function canFullSystemAdmin() { return (isInternalUser() && userRole() in ['system_admin']); }
    // ----- เลขที่เอกสาร (document_numbering) -----
    function canFullDocumentNumbering() { return (isInternalUser() && userRole() in ['system_admin']); }
    // ----- ประวัติกิจกรรม (audit_logs) -----
    function canFullAuditLogs() { return (isInternalUser() && userRole() in ['system_admin']); }
    // ===== Client Portal — Gates =====
    // ----- Client Portal (client_portal) -----
    function canReadClientPortal() { return (isInternalUser() && userRole() in ['system_admin']) || (isClientPortalUser() && userRole() in ['client_user']); }
    function canCreateClientPortal() { return (isInternalUser() && userRole() in ['system_admin']); }
    function canEditClientPortal() { return (isInternalUser() && userRole() in ['system_admin']); }
    function canDeleteClientPortal() { return (isInternalUser() && userRole() in ['system_admin']); }
    function canApproveClientPortal() { return (isInternalUser() && userRole() in ['system_admin']); }
    // =====================================================================
    // MATCH BLOCKS (matrix-gated; simple collections only)
    // =====================================================================
    // ===== Commercial (การค้า) — Match blocks =====
    match /customers/{id} {
      allow read, write: if canFullCustomers();
    }
    match /quotations/{id} {
      allow read:   if canReadQuotations();
      allow create: if canCreateQuotations();
      allow update: if canEditQuotations() || canApproveQuotations();
      allow delete: if canDeleteQuotations();
    }
    match /quotations/{quotationId}/lines/{lineId} {
      allow read:   if canReadQuotations();
      allow create: if canCreateQuotations();
      allow update: if canEditQuotations() || canApproveQuotations();
      allow delete: if canDeleteQuotations();
    }
    match /main_contracts/{id} {
      allow read:   if canReadMainContracts();
      allow create: if canCreateMainContracts();
      allow update: if canEditMainContracts() || canApproveMainContracts();
      allow delete: if canDeleteMainContracts();
    }
    match /main_contracts/{contractId}/position_rates/{rateId} {
      allow read:   if canReadMainContracts();
      allow create: if canCreateMainContracts();
      allow update: if canEditMainContracts() || canApproveMainContracts();
      allow delete: if canDeleteMainContracts();
    }
    match /main_contracts/{contractId}/{document=**} {
      allow read:   if canReadMainContracts();
      allow create: if canCreateMainContracts();
      allow update: if canEditMainContracts() || canApproveMainContracts();
      allow delete: if canDeleteMainContracts();
    }
    match /purchase_orders/{poId}/po_lines/{lineId} {
      allow read:   if canReadCustomerPos();
      allow create: if canCreateCustomerPos();
      allow update: if canEditCustomerPos() || canApproveCustomerPos();
      allow delete: if canDeleteCustomerPos();
    }
    match /purchase_orders/{poId}/{document=**} {
      allow read:   if canReadCustomerPos();
      allow create: if canCreateCustomerPos();
      allow update: if canEditCustomerPos() || canApproveCustomerPos();
      allow delete: if canDeleteCustomerPos();
    }
    match /po_active_bundles/{id} {
      allow read:   if canReadCustomerPos();
      allow create: if canCreateCustomerPos();
      allow update: if canEditCustomerPos() || canApproveCustomerPos();
      allow delete: if canDeleteCustomerPos();
    }
    match /sales_contract_terms/{id} {
      allow read, write: if canFullSalesContractTerms();
    }
    match /rate_conditions/{id} {
      allow read, write: if canFullRateConditions();
    }
    match /profit_estimates/{id} {
      allow read, write: if canFullProfitEstimates();
    }
    // ===== Operations (ปฏิบัติการ) — Match blocks =====
    match /waves/{id} {
      allow read, write: if canFullWaves();
    }
    match /worker_wave_acceptances/{id} {
      allow read, write: if canFullWaves();
    }
    match /assignments/{id} {
      allow read, write: if canFullAssignments();
    }
    match /mobilizations/{id} {
      allow read, write: if canFullMobilization();
    }
    match /mobilizations/{mobId}/fulfillment_lines/{lineId} {
      allow read, write: if canFullMobilization();
    }
    match /petty_cash_entries/{id} {
      allow read, write: if canFullOperationsPettyCash();
    }
    // ===== Store / Vendor (คลัง + คู่ค้า) — Match blocks =====
    match /vendors/{id} {
      allow read, write: if canFullVendors();
    }
    match /purchases/{purchaseId} {
      allow read, write: if canFullPurchases();
    }
    match /purchases/{purchaseId}/{document=**} {
      allow read, write: if canFullPurchases();
    }
    match /purchase_requests/{id} {
      allow read, write: if canFullPurchases();
    }
    match /purchase_requests/{prId}/{document=**} {
      allow read, write: if canFullPurchases();
    }
    match /purchase_vendor_bills/{id} {
      allow read, write: if canFullPurchases();
    }
    match /store_items/{id} {
      allow read, write: if canFullStoreInventory();
    }
    match /store_transactions/{id} {
      allow read, write: if canFullStoreInventory();
    }
    match /store_receipts/{id} {
      allow read, write: if canFullStoreInventory();
    }
    match /store_issue_slips/{id} {
      allow read, write: if canFullStoreInventory();
    }
    match /store_return_slips/{id} {
      allow read, write: if canFullStoreInventory();
    }
    // ===== HR & Payroll (บุคคล) — Match blocks =====
    match /workers/{workerId}/{document=**} {
      allow read:   if canReadWorkers();
      allow create: if canCreateWorkers();
      allow update: if canEditWorkers() || canApproveWorkers();
      allow delete: if canDeleteWorkers();
    }
    match /positions/{id} {
      allow read:   if canReadPositions();
      allow create: if canCreatePositions();
      allow update: if canEditPositions() || canApprovePositions();
      allow delete: if canDeletePositions();
    }
    match /positions/{positionId}/{document=**} {
      allow read:   if canReadPositions();
      allow create: if canCreatePositions();
      allow update: if canEditPositions() || canApprovePositions();
      allow delete: if canDeletePositions();
    }
    match /office_staff/{id} {
      allow read, write: if canFullOfficeStaff();
    }
    match /worker_document_catalog/{id} {
      allow read:   if canReadWorkerDocCatalog();
      allow create: if canCreateWorkerDocCatalog();
      allow update: if canEditWorkerDocCatalog() || canApproveWorkerDocCatalog();
      allow delete: if canDeleteWorkerDocCatalog();
    }
    match /labor_cost_contract_terms/{id} {
      allow read, write: if canFullLaborCostContractTerms();
    }
    match /exception_requests/{id} {
      allow read:   if canReadTimesheets();
      allow create: if canCreateTimesheets();
      allow update: if canEditTimesheets() || canApproveTimesheets();
      allow delete: if canDeleteTimesheets();
    }
    match /wave_month_timesheet_reviews/{id} {
      allow read:   if canReadTimesheets();
      allow create: if canCreateTimesheets();
      allow update: if canEditTimesheets() || canApproveTimesheets();
      allow delete: if canDeleteTimesheets();
    }
    match /po_month_timesheet_reviews/{id} {
      allow read:   if canReadTimesheets();
      allow create: if canCreateTimesheets();
      allow update: if canEditTimesheets() || canApproveTimesheets();
      allow delete: if canDeleteTimesheets();
    }
    match /po_location_month_timesheets/{id} {
      allow read:   if canReadTimesheets();
      allow create: if canCreateTimesheets();
      allow update: if canEditTimesheets() || canApproveTimesheets();
      allow delete: if canDeleteTimesheets();
    }
    match /monthly_timesheet_documents/{id} {
      allow read:   if canReadTimesheets();
      allow create: if canCreateTimesheets();
      allow update: if canEditTimesheets() || canApproveTimesheets();
      allow delete: if canDeleteTimesheets();
    }
    match /payroll_runs/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_batches/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_batches/{batchId}/{document=**} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_periods/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_policies/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /worker_payment_profiles/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    match /payroll_wht_certificates/{id} {
      allow read, write: if canFullWorkerPayroll();
    }
    // NOTE: ทับซ้อน worker_payroll — เลือกใช้ฟังก์ชันใดฟังก์ชันหนึ่ง
    match /payroll_runs/{id} {
      allow read, write: if canFullPayrollRuns();
    }
    // NOTE: payslip = batch line
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read, write: if canFullPayslips();
    }
    match /office_payroll_runs/{id} {
      allow read, write: if canFullOfficePayroll();
    }
    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if canFullOfficePayroll();
    }
    match /office_payroll_runs/{runId}/{document=**} {
      allow read, write: if canFullOfficePayroll();
    }
    match /payment_export_batches/{id} {
      allow read, write: if canFullPaymentExportBatches();
    }
    match /hr_configuration/{docId} {
      allow read, write: if canFullHrHub();
    }
    // ===== Self / Overview — Match blocks =====
    // [overview_dashboard] — แดชบอร์ดหลัก: ไม่มี Firestore path (ไม่มี collection — เป็นแค่หน้า aggregate; ใช้ filter UI เท่านั้น)
    // ===== Accounting (บัญชี) — Match blocks =====
    // [accounting_dashboard] — แดชบอร์ดบัญชี: ไม่มี Firestore path (ไม่มี collection ผูกตรง — ใช้กรอง UI ในเมนูเท่านั้น)
    match /billing_notes/{id} {
      allow read, write: if canFullBillingNotes();
    }
    match /billing_notes/{billingNoteId}/lines/{lineId} {
      allow read, write: if canFullBillingNotes();
    }
    match /billing_notes/{billingNoteId}/{document=**} {
      allow read, write: if canFullBillingNotes();
    }
    match /tax_invoices/{id} {
      allow read:   if canReadTaxInvoices();
      allow create: if canCreateTaxInvoices();
      allow update: if canEditTaxInvoices() || canApproveTaxInvoices();
      allow delete: if canDeleteTaxInvoices();
    }
    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read:   if canReadTaxInvoices();
      allow create: if canCreateTaxInvoices();
      allow update: if canEditTaxInvoices() || canApproveTaxInvoices();
      allow delete: if canDeleteTaxInvoices();
    }
    match /receipts/{id} {
      allow read, write: if canFullReceipts();
    }
    match /ap_bills/{id} {
      allow read, write: if canFullApBills();
    }
    match /accounts_receivable/{id} {
      allow read, write: if canFullAccountsReceivable();
    }
    match /accounts_payable/{id} {
      allow read, write: if canFullAccountsPayable();
    }
    match /withholding_at_source_items/{id} {
      allow read, write: if canFullWithholdingTaxItems();
    }
    match /withholding_certificate_issues/{id} {
      allow read, write: if canFullWithholdingTaxItems();
    }
    match /cashbook_entries/{id} {
      allow read, write: if canFullCashbook();
    }
    match /bank_accounts/{id} {
      allow read, write: if canFullBankAccounts();
    }
    match /executive_payroll_runs/{id} {
      allow read, write: if canFullExecutivePayroll();
    }
    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if canFullExecutivePayroll();
    }
    match /executive_payroll_runs/{runId}/{document=**} {
      allow read, write: if canFullExecutivePayroll();
    }
    match /executive_payroll_staff/{id} {
      allow read, write: if canFullExecutivePayroll();
    }
    // ===== Administration (ระบบ) — Match blocks =====
    match /roles_system_admin/{id} {
      allow read, write: if isAdmin();
    }
    match /permission_profiles/{id} {
      allow read, write: if isAdmin();
    }
    // ===== Client Portal — Match blocks =====
    // =====================================================================
    // ⚠️ PRESERVED ORIGINAL LOGIC — ต้องคัดลอกจาก firestore.rules ปัจจุบันมาวางที่นี่
    //   collections เหล่านี้มี business logic ที่ matrix ไม่ครอบคลุม (portal scope,
    //   status guards, numbering, append-only validation ฯลฯ)
    // =====================================================================
        // ✅ PRESERVED from original (customers/{customerId}/{document=**})
    match /customers/{customerId}/{document=**} {
      allow read: if canReadCustomers();
      allow write: if canWriteCustomers();
        }
        // ✅ PRESERVED from original (purchase_orders/{id})
    match /purchase_orders/{id} {
      allow read: if canReadCommercialDocs() || portalOwnsResourceCustomerId();
      allow create, update: if canWriteCommercialDocs();
      allow delete: if isAdmin() || canDeleteOpsScheduling();
        }
        // ✅ PRESERVED from original (commercial_invoices/{id})
    match /commercial_invoices/{id} {
      allow read: if canReadCommercialInvoices()
        || (portalCustomerIdOk()
            && resource.data.customerId == userData().customerId
            && resource.data.status in ['DRAFT', 'PENDING_CUSTOMER', 'ISSUED', 'VOID']);
      allow create: if canWriteCommercialInvoicesInternal();
      allow update: if (commercialInvoiceTransitionToVoid() && isAdmin())
        || (
          !commercialInvoiceTransitionToVoid()
          && (
            canWriteCommercialInvoicesInternal()
            || (
              portalIsApprover()
              && portalOwnsResourceCustomerId()
              && resource.data.status == 'PENDING_CUSTOMER'
              && request.resource.data.status == 'ISSUED'
              && portalCommercialInvoiceConfirmKeysOnly()
            )
            || (
              portalIsApprover()
              && portalOwnsResourceCustomerId()
              && resource.data.status == 'PENDING_CUSTOMER'
              && request.resource.data.status == 'PENDING_CUSTOMER'
              && portalCommercialInvoiceRevisionRequestKeysOnly()
            )
            || (
              portalCommercialPaymentReportAllowed()
              && request.resource.data.status == 'ISSUED'
              && portalCommercialPaymentProofKeysOnly()
            )
          )
        );
      /** Admin cannot hard-delete ISSUED (confirmed billing); internal non-admin still only DRAFT. */
      allow delete: if (isAdmin() && resource.data.status != 'ISSUED')
        || (canWriteCommercialInvoicesInternal() && resource.data.status == 'DRAFT');
        }
        // ✅ PRESERVED from original (workers/{workerId})
    match /workers/{workerId} {
      allow read: if canReadWorkers()
        || (isEmployeeSelfPortalUser()
          && resource.data.keys().hasAll(['linkedUserId'])
          && resource.data.linkedUserId is string
          && resource.data.linkedUserId == request.auth.uid)
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/workers/$(workerId))
            && 'assignedCustomerIds' in get(/databases/$(database)/documents/workers/$(workerId)).data
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds is list
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds.hasAny([userData().customerId]));
      allow create, update: if canWriteWorkers() && !isEmployeeSelfPortalUser();
      allow delete: if canDeleteWorkers();
        }
        // ✅ PRESERVED from original (daily_timesheets/{id})
    match /daily_timesheets/{id} {
      allow read: if canReadTimesheetsInternal() || portalOwnsResourceCustomerId() || portalDailyTimesheetReadableViaWave() || portalDailyTimesheetReadableViaPo();
      allow create, delete: if canWriteDailyTimesheet();
      allow update: if canWriteDailyTimesheet()
        || (
          portalIsApprover()
          && portalOwnsResourceCustomerId()
          && resource.data.status != 'LOCKED'
          && request.resource.data.status == 'LOCKED'
          && portalTimesheetBillingLockKeysOnly()
        );
        }
        // ✅ PRESERVED from original (attendance_punches/{id})
    match /attendance_punches/{id} {
      allow read: if internalPayrollDataReader();
      allow create: if attendancePunchCreateValid();
      allow update, delete: if false;
        }
        // ✅ PRESERVED from original (attendance_correction_requests/{id})
    match /attendance_correction_requests/{id} {
      allow read: if internalPayrollDataReader();
      allow create: if attendanceCorrectionRequestCreateValid();
      allow update: if attendanceCorrectionRequestResolveValid();
      allow delete: if false;
        }
        // ✅ PRESERVED from original (attendance_day_overrides/{id})
    match /attendance_day_overrides/{id} {
      allow read: if internalPayrollDataReader();
      allow create: if attendanceDayOverrideCreateValid();
      allow update, delete: if false;
        }
        // ✅ PRESERVED from original (leave_requests/{id})
    match /leave_requests/{id} {
      allow read: if internalPayrollDataReader() || leaveRequestOwnedByCaller();
      allow create: if leaveRequestCreateValid();
      allow update: if leaveRequestSelfCancelValid() || leaveRequestManagerDecisionValid() || leaveRequestDraftUpdateValid();
      allow delete: if false;
        }
        // ✅ PRESERVED from original (payroll_correction_requests/{id})
    match /payroll_correction_requests/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow write: if canPreparePayroll();
        }
        // ✅ PRESERVED from original (cash_advance_requests/{id})
    match /cash_advance_requests/{id} {
      /** เงื่อนไขเจ้าของเรื่องมาก่อน — ไม่ต้องประเมิน privileged reader (หลีกเลี่ยง userData() ล้มเมื่อยังไม่มี users/{uid}) */
      allow read: if (
          isSignedIn()
          && resource.data.keys().hasAll(['subjectLinkedUserId'])
          && resource.data.subjectLinkedUserId is string
          && resource.data.subjectLinkedUserId == request.auth.uid
        )
        || cashAdvancePrivilegedReader()
        || cashAdvanceInternalQueueReader();
      allow create: if cashAdvancePrivilegedReader()
        || (
             (isInternalUser() || isInternalStaffDoc())
             && !isEmployeeSelfPortalUser()
             && !isHrOfficerRoleScalar()
           )
        || (isEmployeeSelfPortalUser() && cashAdvanceEmployeeSelfCreateValid());
      allow update: if cashAdvancePrivilegedReader()
        || (
          isSignedIn()
          && resource.data.keys().hasAll(['subjectLinkedUserId'])
          && resource.data.subjectLinkedUserId == request.auth.uid
          && resource.data.status == 'PENDING_SUBJECT_CONFIRMATION'
          && request.resource.data.status == 'PENDING_PAYROLL_REVIEW'
        );
      allow delete: if cashAdvancePrivilegedReader();
        }
        // ✅ PRESERVED from original (workers/{workerId})
    match /workers/{workerId} {
      allow read: if canReadWorkers()
        || (isEmployeeSelfPortalUser()
          && resource.data.keys().hasAll(['linkedUserId'])
          && resource.data.linkedUserId is string
          && resource.data.linkedUserId == request.auth.uid)
        || (portalCustomerIdOk()
            && exists(/databases/$(database)/documents/workers/$(workerId))
            && 'assignedCustomerIds' in get(/databases/$(database)/documents/workers/$(workerId)).data
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds is list
            && get(/databases/$(database)/documents/workers/$(workerId)).data.assignedCustomerIds.hasAny([userData().customerId]));
      allow create, update: if canWriteWorkers() && !isEmployeeSelfPortalUser();
      allow delete: if canDeleteWorkers();
        }
        // ✅ PRESERVED from original (withholding_certificate_documents/{id})
    match /withholding_certificate_documents/{id} {
      allow read: if canReadAccountingInternal() || canReadPurchases();
      allow create: if canWriteAccountingDocs();
      allow update: if canWriteAccountingDocs();
      /**
       * Delete: accounting/admin — plus internal cleanup when removing a purchase-linked cert during PO cascade
       * (UI gate still blocks paid vendor bills / paid milestones).
       */
      allow delete: if canWriteAccountingDocs()
        || (
          canWritePurchases()
          && resource.data != null
          && 'sourcePurchaseId' in resource.data
          && resource.data.sourcePurchaseId is string
          && resource.data.sourcePurchaseId.size() > 0
        );
        }
        // ✅ PRESERVED from original (users/{userId})
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId) || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
      allow list: if isAdmin() || isOperationsPillarExecutive();
      allow create: if isAdmin()
        || (isOwner(userId) && bootstrapUserCreateValid(userId))
        || (isOwner(userId) && selfRegistrationPendingCreateValid(userId))
        || (isOperationsPillarExecutive() && isCustomerPortalUserCreate(userId))
        || (isOperationsPillarExecutive() && isEmployeeSelfPortalUserCreate(userId));
      allow update: if isAdmin()
        || (isOwner(userId) && !userSecurityFieldChanges())
        || opsExecClientPortalUpdateOk();
      allow delete: if isAdmin()
        || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
        }
        // ✅ PRESERVED from original (system/{docId})
    match /system/{docId} {
      allow read: if systemDocReadOk(docId);
      allow create: if systemBootstrapCreateOk(docId);
      allow update, delete: if isAdmin();
        }
        // ✅ PRESERVED from original (number_sequences/{id})
    match /number_sequences/{id} {
      allow read: if isAdmin() || numberSequenceAllowsWrite(id);
      allow write: if numberSequenceAllowsWrite(id);
        }
        // ✅ PRESERVED from original (audit_logs/{id})
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if internalStaffFirestoreActor()
        || (clientPortalUserActive() && request.resource.data.actorUserId == request.auth.uid);
      allow update, delete: if isAdmin();
        }
        // ✅ PRESERVED from original (client_portal/{document=**})
    match /client_portal/{document=**} {
      allow read, write: if clientPortalUserActive();
        }
  }
}
