    }
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if rs0() || isInternalUser()
        || (isSignedIn() && resource.data.subjectLinkedUserId == request.auth.uid);
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /payroll_batches/{batchId}/{document=**} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /payroll_periods/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /payroll_policies/{id} {
      allow read: if isInternalUser();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /worker_payment_profiles/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /payroll_wht_certificates/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    // NOTE:  worker_payroll - 
    match /payroll_runs/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    // NOTE: payslip = batch line
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if rs0() || isInternalUser()
        || (isSignedIn() && resource.data.subjectLinkedUserId == request.auth.uid);
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /office_payroll_runs/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if rs0()
        || isInternalUser()
        || (isSignedIn() && resource.data.subjectLinkedUserId == request.auth.uid);
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /payment_export_batches/{id} {
      allow read: if rs0();
      allow write: if blockExecutiveWrite() && rs0();
    }
    match /hr_configuration/{docId} {
      allow read: if rs11();
      allow write: if blockExecutiveWrite() && rs11();
    }
    // ===== Self / Overview - Match blocks =====
    // [overview_dashboard] - :  Firestore path ( collection -  aggregate;  filter UI )
    // ===== Accounting - Match blocks =====
    // [accounting_dashboard] - :  Firestore path ( collection  -  UI )
    match /billing_notes/{id} {
      allow read: if rs19() || portalAccountingDocReadOk();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /billing_notes/{billingNoteId}/lines/{lineId} {
      allow read: if rs19() || portalBillingNoteOwned(billingNoteId);
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /billing_notes/{billingNoteId}/{document=**} {
      allow read: if rs19() || portalBillingNoteOwned(billingNoteId);
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /tax_invoices/{id} {
      allow read:   if rs6() || portalAccountingDocReadOk();
      allow create: if blockExecutiveWrite() && rs19();
      allow update: if blockExecutiveWrite() && (rs6() || rs19() || portalAccountingDocWriteOk());
      allow delete: if blockExecutiveWrite() && rs19();
    }
    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read:   if rs6() || portalTaxInvoiceOwned(taxInvoiceId);
      allow create: if blockExecutiveWrite() && rs19();
      allow update: if blockExecutiveWrite() && (rs6() || rs19() || portalTaxInvoiceOwned(taxInvoiceId));
      allow delete: if blockExecutiveWrite() && rs19();
    }
    match /receipts/{id} {
      allow read: if rs19() || portalAccountingDocReadOk();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /ap_bills/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /accounts_receivable/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /accounts_payable/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /withholding_at_source_items/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /withholding_certificate_issues/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /cashbook_entries/{id} {
      allow read: if isExecutiveViewer() || isAccountingManagerOrAdmin() || (isInternalUser() && userRole() == 'operations_manager');
      allow write: if isAccountingManagerOrAdmin() || (isInternalUser() && userRole() == 'operations_manager');
    }
    match /bank_accounts/{id} {
      allow read: if canReadBankAccountSensitiveDetails();
      allow write: if isAccountingManagerOrAdmin();
    }
    match /executive_payroll_runs/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /executive_payroll_runs/{runId}/{document=**} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    match /executive_payroll_staff/{id} {
      allow read: if rs19();
      allow write: if blockExecutiveWrite() && rs19();
    }
    // ===== Administration - Match blocks =====
    match /roles_system_admin/{id} {
      allow read, write: if isAdmin();
    }
    match /permission_profiles/{id} {
      allow read, write: if isAdmin();
    }
    // ===== Client Portal - Match blocks =====
    // =====================================================================
    // ! PRESERVED ORIGINAL LOGIC -  firestore.rules 
    //   collections  business logic  matrix  (portal scope,
    //   status guards, numbering, append-only validation )
    // =====================================================================
    // PRESERVED-PATH (simplified fallback): customers/{customerId}/{document=**}
    match /customers/{customerId}/{document=**} {
      allow read: if isInternalUser() || (isClientPortalUser() && customerId == userData().customerId);
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): commercial_invoices/{id}
    match /commercial_invoices/{id} {
      allow read: if isInternalUser() || portalAccountingDocReadOk();
      allow create: if internalWriteOk();
      allow update: if isInternalUser() || portalCommercialInvoiceCustomerActionOk();
      allow delete: if internalWriteOk();
    }
    // Client portal — รายงาน dispute / ต่อรอง (Open Dispute)
    match /customer_issues/{id} {
      allow read: if isInternalUser()
        || (isClientPortalUser()
            && portalCustomerIdOk()
            && resource.data.customerId == userData().customerId);
      allow create: if internalWriteOk()
        || (isClientPortalUser()
            && userRole() in ['client_user']
            && portalCustomerIdOk()
            && request.resource.data.customerId == userData().customerId
            && request.resource.data.status == 'OPEN'
            && request.resource.data.createdById == request.auth.uid);
      allow update, delete: if isInternalUser();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): daily_timesheets/{id}
    match /daily_timesheets/{id} {
      allow read: if isInternalUser() || portalDailyTimesheetReadOk();
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): attendance_correction_requests/{id}
    match /attendance_correction_requests/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): leave_requests/{id}
    match /leave_requests/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): cash_advance_requests/{id}
    match /cash_advance_requests/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): withholding_certificate_documents/{id}
    match /withholding_certificate_documents/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): system/{docId}
    match /system/{docId} {
      allow read, write: if isAdmin();
    }
    //    generated gate  path 
    // PRESERVED-PATH (simplified fallback): audit_logs/{id}
    match /audit_logs/{id} {
      allow read: if isInternalUser();
      allow create: if blockExecutiveWrite() && internalStaffFirestoreActor();
      allow update, delete: if isAdmin();
    }
    //    generated gate  path 
    // ===== Critical infrastructure paths (not in matrix) =====
    match /users/{userId} {
      allow get: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
        || isInternalUser()
      );
      allow list: if isAdmin() || isInternalUser();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    match /auth_register_pendings/{id} {
      allow read, write: if request.auth != null;
    }
    match /number_sequences/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /client_portal/{document=**} {
      allow read: if isInternalUser() || isClientPortalUser();
      allow write: if internalWriteOk() || isClientPortalUser();
    }
    match /workers/{workerId} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /attendance_kiosk_sessions/{token} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /attendance_punches/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /attendance_day_overrides/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /payroll_correction_requests/{id} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /withholding_certificate_documents/{docId}/audit_logs/{logId} {
      allow read: if isInternalUser();
      allow write: if blockExecutiveWrite() && internalStaffFirestoreActor();
    }
    match /withholding_certificate_documents/{docId}/xml_export_logs/{logId} {
      allow read: if isInternalUser();
      allow write: if blockExecutiveWrite() && internalStaffFirestoreActor();
    }
    match /purchase_orders/{purchaseOrderId}/po_lines/{lineId} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read: if isInternalUser();
      allow write: if internalWriteOk();
    }
    // bank_accounts / cashbook are owned by accounting, but operations_manager
    // needs READ access for the Petty Cash page (filtered client-side by accountType).
    // Operations manager may also UPDATE petty-cash bank accounts (currentBalance
    // increments) so they can post petty cash entries that adjust the fund balance.
    match /bank_accounts/{id} {
      allow read: if canReadBankAccountSensitiveDetails();
      allow create, delete: if isAccountingManagerOrAdmin();
      allow update: if isAccountingManagerOrAdmin() || (
        userRole() == 'operations_manager'
        && resource.data.accountType == 'PETTY_CASH'
      );
    }
    match /cashbook_entries/{id} {
      allow read: if isExecutiveViewer() || isAccountingManagerOrAdmin() || (isInternalUser() && userRole() == 'operations_manager');
      allow write: if isAccountingManagerOrAdmin() || (isInternalUser() && userRole() == 'operations_manager');
    }
    match /petty_cash_entries/{id} {
      allow read: if isInternalUser() && userRole() in ['system_admin', 'operations_manager', 'accounting_manager', 'accounting_officer'];
      allow write: if internalWriteOk() && userRole() in ['system_admin', 'operations_manager', 'accounting_manager', 'accounting_officer'];
    }
    // permission_profiles: every signed-in user reads their own role's profile
    // to compute UI permissions; only admin can edit role templates.
    match /permission_profiles/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    // menu_permission_overrides: same pattern - all users read effective
    // matrix to render UI; only admin writes overrides.
    match /menu_permission_overrides/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /system/company_profile {
      allow read: if isInternalUser() || isClientPortalUser();
      allow write: if isAdmin();
    }
    match /system/drug_test_panel {
      allow read: if isInternalUser();
      allow write: if isAdmin();
    }
    // My Profile — พนักงานทุก role อ่านปฏิทินวันหยุด/นโยบาย + index สลิปของตนเอง
    match /payroll_policies/{id} {
      allow read: if isInternalUser();
    }
    match /office_staff/{staffId}/self_payroll_lines/{lineId} {
      allow read: if isInternalUser()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/office_staff/$(staffId))
          && get(/databases/$(database)/documents/office_staff/$(staffId)).data.linkedUserId == request.auth.uid
        );
      allow write: if blockExecutiveWrite() && rs0() || rs14();
    }
    match /workers/{workerId}/self_payroll_lines/{lineId} {
      allow read: if isInternalUser()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/workers/$(workerId))
          && get(/databases/$(database)/documents/workers/$(workerId)).data.linkedUserId == request.auth.uid
        );
      allow write: if blockExecutiveWrite() && rs0() || rs14();
    }
    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if isInternalUser()
        || (isSignedIn() && resource.data.subjectLinkedUserId == request.auth.uid);
    }
    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read: if isInternalUser()
        || (isSignedIn() && resource.data.subjectLinkedUserId == request.auth.uid);
    }
    // ===== Broad READ fallback for internal staff =====
    // Matrix gates above narrow write access by role, but every internal
    // user needs READ visibility on core business collections to do their
    // jobs (officers below manager level still need to see contracts,
    // quotes, workers, positions, vendors, POs, assignments, etc.).
    // These blocks are evaluated independently from the matrix blocks;
    // either passing grants read. Writes remain matrix-constrained.
    match /main_contracts/{id} { allow read: if isInternalUser(); }
    match /main_contracts/{contractId}/position_rates/{rateId} { allow read: if isInternalUser(); }
    match /main_contracts/{contractId}/{document=**} { allow read: if isInternalUser(); }
    match /quotations/{id} { allow read: if isInternalUser(); }
    match /quotations/{quotationId}/lines/{lineId} { allow read: if isInternalUser(); }
    match /quotations/{quotationId}/{document=**} { allow read: if isInternalUser(); }
    match /vendors/{id} { allow read: if isInternalUser(); }
    match /positions/{id} { allow read: if isInternalUser(); }
    match /position_templates/{id} { allow read: if isInternalUser(); }
    match /assignments/{id} { allow read: if isInternalUser(); }
    match /waves/{id} { allow read: if isInternalUser(); }
    match /mobilization/{id} { allow read: if isInternalUser(); }
    match /purchase_orders/{id} { allow read: if isInternalUser(); }
    match /rate_conditions/{id} { allow read: if isInternalUser(); }
    match /profit_estimates/{id} { allow read: if isInternalUser(); }
    match /sales_contract_terms/{id} { allow read: if isInternalUser(); }
    match /tax_invoices/{id} { allow read: if isInternalUser() || portalAccountingDocReadOk(); }
    match /billing_notes/{id} { allow read: if isInternalUser() || portalAccountingDocReadOk(); }
    match /receipts/{id} { allow read: if isInternalUser() || portalAccountingDocReadOk(); }
    match /ap_bills/{id} { allow read: if isInternalUser(); }
    match /accounts_receivable/{id} { allow read: if isInternalUser(); }
    match /accounts_payable/{id} { allow read: if isInternalUser(); }
    match /withholding_tax_items/{id} { allow read: if isInternalUser(); }
    match /cashbook/{id} { allow read: if isInternalUser(); }
    match /payroll_runs/{id} { allow read: if isInternalUser(); }
    match /payslips/{id} { allow read: if isInternalUser(); }
    match /office_payroll/{id} { allow read: if isInternalUser(); }
    match /worker_payroll/{id} { allow read: if isInternalUser(); }
    match /payment_export_batches/{id} { allow read: if isInternalUser(); }
    match /employees/{id} { allow read: if isInternalUser(); }
    match /worker_documents/{id} { allow read: if isInternalUser(); }
    match /timesheets/{id} { allow read: if isInternalUser(); }
    match /hr_hub/{id} { allow read: if isInternalUser(); }
    match /store_inventory/{id} { allow read: if isInternalUser(); }
    match /vendor_bills/{id} { allow read: if isInternalUser(); }
    match /vendor_bills/{billId}/{document=**} { allow read: if isInternalUser(); }
    match /labor_cost_contract_terms/{id} { allow read: if isInternalUser(); }
    match /office_staff/{id} {
      allow read: if isInternalUser()
        || (isSignedIn() && resource.data.linkedUserId == request.auth.uid);
      allow create, update: if isInternalUser() && userRole() in ['system_admin', 'hr_manager', 'hr_officer', 'payroll_officer'];
      allow delete: if isAdmin() || (isInternalUser() && userRole() == 'hr_manager');
    }
    // Payroll subcollections: each batch/run has nested 'lines' read via collectionGroup
    match /{parent}/{batchId}/lines/{lineId} { allow read: if isInternalUser(); }
    // Document numbering / counters used by services across roles
    match /document_numbering/{id} { allow read: if isInternalUser(); allow write: if isAdmin(); }
    match /counters/{id} { allow read: if isInternalUser(); allow write: if isAdmin(); }
    // Master data / lookups used pervasively across UI
    match /bank_master/{id} { allow read: if isInternalUser(); }
    match /departments/{id} { allow read: if isInternalUser(); }
    match /branches/{id} { allow read: if isInternalUser(); }
    match /document_categories/{id} { allow read: if isInternalUser(); }
    match /worker_doc_catalog/{id} { allow read: if isInternalUser(); }
    match /sso_hospital_catalog/{id} {
      allow read: if rs11() || isInternalUser();
      allow create, update, delete: if blockExecutiveWrite() && rs11();
    }
  }
}
