rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Security Rules
     * 
     * Core Philosophy: Role-Based Access Control (RBAC) via DBAC (Database Access Control).
     * Staff roles are stored in dedicated collections: /roles_[role_name]/{uid}
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Role check helpers
    function isSystemAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_system_admin/$(request.auth.uid));
    }

    function isHRManager() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_hr_manager/$(request.auth.uid));
    }

    function isHROfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_hr_officer/$(request.auth.uid));
    }

    function isSalesOfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_sales_officer/$(request.auth.uid));
    }

    function isFinanceOfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_finance_officer/$(request.auth.uid));
    }

    function isPayrollOfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_payroll_officer/$(request.auth.uid));
    }

    function isStoreOfficer() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_store_officer/$(request.auth.uid));
    }

    // General Staff check (Anyone with a staff role)
    function isStaff() {
      return isSignedIn() && (
        isSystemAdmin() || 
        isHRManager() || 
        isHROfficer() || 
        isSalesOfficer() || 
        isFinanceOfficer() || 
        isPayrollOfficer() || 
        isStoreOfficer()
      );
    }

    // HR specific staff
    function isHRStaff() {
      return isSignedIn() && (isSystemAdmin() || isHRManager() || isHROfficer());
    }

    // User profiles - Explicitly allow listing for staff
    match /users {
      allow list: if isStaff();
      match /{userId} {
        allow get: if isSignedIn();
        allow write: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);
      }
    }

    // Workers & Records - Explicitly allow listing for staff
    match /workers {
      allow list: if isStaff();
      match /{workerId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        
        match /certificates/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /medical_records/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /drug_tests/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /documents/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    // Positions & Requirements
    match /positions {
      allow list: if isStaff();
      match /{positionId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        
        match /certificate_requirements/{id} { allow read, write: if isHRStaff(); }
        match /ppe_requirements/{id} { allow read, write: if isHRStaff(); }
        match /tool_requirements/{id} { allow read, write: if isHRStaff(); }
      }
    }

    // Commercial Hierarchy
    match /customers {
      allow list: if isStaff();
      match /{customerId} {
        allow get: if isStaff();
        allow write: if isSystemAdmin() || isSalesOfficer();
        
        match /contacts/{id} { allow read, write: if isStaff(); }
        
        match /main_contracts/{id} { 
          allow read: if isStaff();
          allow write: if isSystemAdmin() || isSalesOfficer();

          match /position_rates/{rateId} { allow read, write: if isStaff(); }
          
          match /purchase_orders/{poId} { 
            allow read: if isStaff();
            allow write: if isSystemAdmin() || isSalesOfficer();

            match /po_lines/{lineId} { 
              allow read: if isStaff();
              allow write: if isSystemAdmin() || isSalesOfficer();

              match /assignments/{asgnId} { allow read, write: if isStaff(); }
            }
          }
        }
      }
    }

    // Roles & System Bootstrap - READ allowed for signed in users to check their own role
    match /roles_hr_manager/{uid} { allow read: if isSignedIn(); }
    match /roles_hr_officer/{uid} { allow read: if isSignedIn(); }
    match /roles_system_admin/{uid} { allow read: if isSignedIn(); }
    match /roles_sales_officer/{uid} { allow read: if isSignedIn(); }
    match /roles_finance_officer/{uid} { allow read: if isSignedIn(); }
    match /roles_payroll_officer/{uid} { allow read: if isSignedIn(); }
    match /roles_store_officer/{uid} { allow read: if isSignedIn(); }
    
    match /system/bootstrap { allow read: if true; }

    // Collection Group support for global listing
    match /{path=**}/assignments/{asgnId} {
      allow read: if isStaff() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }
    match /{path=**}/purchase_orders/{poId} {
      allow read: if isStaff();
    }
    match /{path=**}/po_lines/{lineId} {
      allow read: if isStaff();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}