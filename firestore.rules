rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Security Rules
     * 
     * Core Philosophy: Role-Based Access Control (RBAC) via DBAC.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isHRManager() {
      return exists(/databases/$(database)/documents/roles_hr_manager/$(request.auth.uid));
    }

    function isSystemAdmin() {
      return exists(/databases/$(database)/documents/roles_system_admin/$(request.auth.uid));
    }

    function isAuthorizedStaff() {
      return isSignedIn() && (isHRManager() || isSystemAdmin());
    }

    // Positions & Requirements
    match /positions/{positionId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
      
      match /certificate_requirements/{id} { allow read, write: if isAuthorizedStaff(); }
      match /ppe_requirements/{id} { allow read, write: if isAuthorizedStaff(); }
      match /tool_requirements/{id} { allow read, write: if isAuthorizedStaff(); }
    }

    // Workers & Records
    match /workers/{workerId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAuthorizedStaff();
      
      match /certificates/{id} { allow read, write: if isAuthorizedStaff(); }
      match /medical_records/{id} { allow read, write: if isAuthorizedStaff(); }
      match /drug_tests/{id} { allow read, write: if isAuthorizedStaff(); }
      match /documents/{id} { allow read, write: if isAuthorizedStaff(); }
    }

    // Commercial
    match /customers/{customerId} {
      allow read, write: if isAuthorizedStaff() || (isSignedIn() && exists(/databases/$(database)/documents/roles_sales_officer/$(request.auth.uid)));
      
      match /contacts/{id} { allow read, write: if isAuthorizedStaff(); }
      match /main_contracts/{id} { 
        allow read, write: if isAuthorizedStaff(); 
        match /position_rates/{rateId} { allow read, write: if isAuthorizedStaff(); }
        match /purchase_orders/{poId} { 
          allow read, write: if isAuthorizedStaff();
          match /po_lines/{lineId} { 
            allow read, write: if isAuthorizedStaff();
            match /assignments/{asgnId} { allow read, write: if isAuthorizedStaff(); }
          }
        }
      }
    }

    // Roles & System
    match /roles_hr_manager/{uid} { allow read: if isSignedIn(); }
    match /roles_system_admin/{uid} { allow read: if isSignedIn(); }
    match /roles_sales_officer/{uid} { allow read: if isSignedIn(); }
    match /system/bootstrap { allow read: if true; }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}