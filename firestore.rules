rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Identity & user document
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return userExists() ? get(userDocPath()).data : null;
    }

    function isActiveUser() {
      let u = userData();
      return u != null && u.isActive == true && u.approvalStatus == 'ACTIVE';
    }

    function isInternalUser() {
      let u = userData();
      return u != null
        && u.userType != 'customer_portal'
        && u.accessGroup != 'client';
    }

    function isClientUser() {
      let u = userData();
      return u != null
        && isActiveUser()
        && (u.userType == 'customer_portal' || u.accessGroup == 'client' || u.department == 'client');
    }

    // -------------------------------------------------------------------------
    // Legacy compatibility — single resolver (accessGroup / departmentGroup / role / department)
    // -------------------------------------------------------------------------

    function legacyResolvedGroup() {
      let u = userData();
      return u == null ? null
        : u.assignedRoleKey == 'system_admin' ? 'admin'
        : u.assignedRoleKey == 'client_user' ? 'client'
        : (u.assignedRoleKey == 'accounting_manager' || u.assignedRoleKey == 'accounting_officer') ? 'accounting'
        : (u.assignedRoleKey == 'store_manager' || u.assignedRoleKey == 'store_officer') ? 'operation'
        : (u.assignedRoleKey == 'hr_manager' || u.assignedRoleKey == 'hr_officer') ? 'operation'
        : (u.assignedRoleKey == 'operations_manager' || u.assignedRoleKey == 'operations_officer') ? 'operation'
        : (u.assignedRoleKey == 'sales_manager' || u.assignedRoleKey == 'sales_officer') ? 'operation'
        : u.assignedRoleKey == 'payroll_officer' ? 'operation'
        : (u.roleIds != null && u.roleIds is list && u.roleIds.hasAny(['system_admin'])) ? 'admin'
        : (u.roleIds != null && u.roleIds is list && u.roleIds.hasAny(['client_user'])) ? 'client'
        : u.roleId == 'system_admin' ? 'admin'
        : u.roleId == 'client_user' ? 'client'
        : u.department == 'admin' ? 'admin'
        : u.department == 'client' ? 'client'
        : u.department == 'accounting' ? 'accounting'
        : u.department == 'store' ? 'operation'
        : (u.department == 'hr' || u.department == 'sales' || u.department == 'operations') ? 'operation'
        : null;
    }

    function userDepartmentGroup() {
      let u = userData();
      return u == null ? null
        : (u.accessGroup == 'admin' || u.accessGroup == 'operation' || u.accessGroup == 'accounting' || u.accessGroup == 'client') ? u.accessGroup
        : (u.departmentGroup == 'admin' || u.departmentGroup == 'operation' || u.departmentGroup == 'accounting' || u.departmentGroup == 'client') ? u.departmentGroup
        : legacyResolvedGroup();
    }

    function userAccessLevel() {
      let u = userData();
      return u != null && u.accessLevel != null ? u.accessLevel : u.level;
    }

    function assignedRoleKey() {
      let u = userData();
      return u != null ? u.assignedRoleKey : null;
    }

    function roleIds() {
      let u = userData();
      return u != null && u.roleIds != null && u.roleIds is list ? u.roleIds : [];
    }

    function userCustomerId() {
      let u = userData();
      return u != null ? u.customerId : null;
    }

    function sameCustomerId(customerId) {
      return isClientUser() && userCustomerId() != null && userCustomerId() == customerId;
    }

    // -------------------------------------------------------------------------
    // Group predicates (UI / permission-core aligned)
    // -------------------------------------------------------------------------

    function isAdminUser() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser()
        && (userDepartmentGroup() == 'admin'
            || assignedRoleKey() == 'system_admin'
            || (roleIds() != null && roleIds().hasAny(['system_admin'])));
    }

    function isOperationUser() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser()
        && userDepartmentGroup() == 'operation';
    }

    function isAccountingUser() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser()
        && userDepartmentGroup() == 'accounting';
    }

    function canManageSystem() {
      return isAdminUser();
    }

    // Domain gates
    function canAccessSales() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && (isOperationUser() || isAccountingUser()) && !isStoreOfficerUser());
    }

    function canAccessOperations() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && isOperationUser() && !isStoreOfficerUser());
    }

    function canAccessHR() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && (isOperationUser() || isAccountingUser()) && !isStoreOfficerUser());
    }

    /**
     * คลัง/จัดซื้อ: อิง department หรือ role โดยตรง (ไม่ผูกแค่ userDepartmentGroup == operation)
     * เพื่อกันผู้ใช้จริงที่เป็น store แต่เอกสาร users ยัง resolve กลุ่มไม่ตรง → อ่าน store_items ไม่ได้
     */
    function isStoreDomainUser() {
      let u = userData();
      return u != null && isActiveUser() && isInternalUser()
        && (
          u.department == 'store'
          || assignedRoleKey() == 'store_officer'
          || assignedRoleKey() == 'store_manager'
          || (u.roleIds != null && u.roleIds is list && u.roleIds.hasAny(['store_officer', 'store_manager']))
        );
    }

    function canAccessStore() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && (isOperationUser() || isAccountingUser()))
        || isStoreDomainUser();
    }

    function canWriteStore() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && isOperationUser())
        || isStoreDomainUser();
    }

    function canAccessAccounting() {
      return isAdminUser() || (isActiveUser() && isInternalUser() && isAccountingUser());
    }

    /** HR ฝั่งปฏิบัติการ (ไม่ใช่บัญชี) — คีย์ timesheet / เตรียม payroll */
    function canWriteHrPayrollOperationalData() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && canAccessHR() && userDepartmentGroup() != 'accounting');
    }

    function dailyTimesheetFinalized(data) {
      return data.status in ['LOCKED', 'CLIENT_APPROVED', 'VERIFIED_PAPER'];
    }

    function payrollBatchFinanciallyLocked(data) {
      return data.status in ['LOCKED', 'PAID'];
    }

    function officePayrollRunFrozen(data) {
      return data.status in ['FINANCE_APPROVED', 'PAID', 'LOCKED'];
    }

    /** บัญชีแก้เฉพาะ workflow หลัง HR อนุมัติ — ห้ามเปลี่ยนยอด snapshot */
    function accountingPayrollBatchSafeUpdate() {
      return isAccountingUser()
        && resource.data.status in ['HR_APPROVED', 'FINANCE_PREPARED']
        && request.resource.data.grossAmount == resource.data.grossAmount
        && request.resource.data.netAmount == resource.data.netAmount
        && request.resource.data.totalWorkers == resource.data.totalWorkers
        && request.resource.data.totalDeductions == resource.data.totalDeductions
        && request.resource.data.payrollPeriodId == resource.data.payrollPeriodId
        && request.resource.data.workModeScope == resource.data.workModeScope;
    }

    function accountingOfficePayrollSafeUpdate() {
      return isAccountingUser()
        && resource.data.status == 'HR_APPROVED'
        && request.resource.data.grossAmount == resource.data.grossAmount
        && request.resource.data.netAmount == resource.data.netAmount
        && request.resource.data.staffCount == resource.data.staffCount
        && request.resource.data.totalAllowances == resource.data.totalAllowances
        && request.resource.data.totalDeductions == resource.data.totalDeductions
        && request.resource.data.payrollMonth == resource.data.payrollMonth
        && request.resource.data.payrollRunNo == resource.data.payrollRunNo;
    }

    function payrollBatchSnapshot(batchId) {
      return get(/databases/$(database)/documents/payroll_batches/$(batchId)).data;
    }

    /** ทะเบียนคนงาน/ออฟฟิศ: แก้ได้ระดับ manager+ (และแอดมิน) — officer ดูอย่างเดียวตามนโยบาย HR */
    function canEditWorkerRegistry() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && canAccessHR() && userDepartmentGroup() != 'accounting'
            && (userAccessLevel() == 'manager' || userAccessLevel() == 'admin'));
    }

    /** คีย์ใน number_sequences — ต้องสอดคล้องกับ SEQUENCE_REGISTRY (numbering-service.ts) */
    function isAccountingSequenceId(seqId) {
      return seqId in [
        'billing_note', 'tax_invoice', 'receipt', 'ap_bill', 'ar', 'ap', 'cashbook_entry', 'bank_account',
        'executive_payroll_run'
      ];
    }
    function isHrSequenceId(seqId) {
      return seqId in [
        'office_staff', 'worker', 'position', 'payroll_run', 'office_payroll_run', 'cost_term'
      ];
    }
    function isSalesSequenceId(seqId) {
      return seqId in ['customer', 'customer_po', 'quotation', 'sales_term'];
    }
    function isOperationsSequenceId(seqId) {
      return seqId in ['wave', 'assignment'];
    }

    /** ลบทะเบียนคนงาน: ผู้ดูแลระบบ หรือ HR ระดับ manager/admin เท่านั้น */
    function canDeleteWorkerRecord() {
      return isAdminUser()
        || (isActiveUser() && isInternalUser() && canAccessHR()
            && (userAccessLevel() == 'manager' || userAccessLevel() == 'admin'));
    }

    function internalRead() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser();
    }

    /** เจ้าหน้าที่คลัง: จำกัดเฉพาะงานคลัง/จัดซื้อ (สอดคล้อง permissions.ts) */
    function isStoreOfficerUser() {
      let u = userData();
      return u != null && isActiveUser() && isInternalUser()
        && userDepartmentGroup() == 'operation'
        && userAccessLevel() == 'officer'
        && (
          u.assignedRoleKey == 'store_officer'
          || (u.roleIds != null && u.roleIds is list && u.roleIds.hasAny(['store_officer']))
          || u.department == 'store'
        );
    }

    function internalReadNonStoreOfficer() {
      return internalRead() && !isStoreOfficerUser();
    }

    /** อ่านข้อมูลภายใน + เจ้าหน้าที่คลัง (ต้องใช้พนักงาน/มอบหมายตอนเบิกจ่ายอุปกรณ์) */
    function internalReadOrStoreOfficer() {
      return internalReadNonStoreOfficer() || isStoreOfficerUser();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** สร้าง users/{uid} ครั้งแรกหลังลงทะเบียนด้วยตนเอง — ห้ามมีสิทธิ์ admin/โปรไฟล์จนกว่าแอดมินจะอนุมัติ (uid ต้องส่งจาก path) */
    function selfRegistrationUserCreateValid(uid) {
      let d = request.resource.data;
      return d.approvalStatus == 'PENDING'
        && d.isActive == false
        && d.userType == 'internal'
        && !d.keys().hasAny([
          'accessGroup', 'departmentGroup', 'assignedRoleKey', 'assignedRoleKeys',
          'permissionProfileKey', 'permissionProfileKeys', 'accessLevel', 'allowedModules',
          'portalRole', 'customerId'
        ])
        && d.roleIds is list
        && d.roleIds.size() == 0
        && d.id == uid;
    }

    function isModifyingSecurityFields() {
      let protectedFields = [
        'userType', 'accessGroup', 'accessLevel', 'departmentGroup', 'allowedModules',
        'customerId', 'portalRole', 'isActive', 'approvalStatus', 'mustResetPassword',
        'roleId', 'roleIds', 'assignedRoleKey', 'assignedRoleKeys',
        'permissionProfileKey', 'permissionProfileKeys',
        'department', 'level', 'dataAccess'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    function canReadOwnPermissionProfile(profileData) {
      let u = userData();
      return u != null && isActiveUser()
        && profileData.profileKey != null
        && (
          (u.permissionProfileKey != null && profileData.profileKey == u.permissionProfileKey)
          || (u.permissionProfileKeys != null && u.permissionProfileKeys is list && u.permissionProfileKeys.hasAny([profileData.profileKey]))
        );
    }

    /** Active main contract: allow costing sync + lifecycle transitions + supplemental inherit sync only */
    function mainContractCostingOnlyUpdate() {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['costingStatus', 'costingMissingPositionsCount', 'costingUpdatedAt', 'updatedAt']);
    }

    function mainContractActiveToClosedSync() {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'closed';
    }

    function mainContractActiveToRevisedParent() {
      return resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'supersededByContractId'])
        && request.resource.data.status == 'revised';
    }

    function mainContractSupplementalSyncFromMaster() {
      return resource.data.status == 'active'
        && resource.data.contractType == 'supplemental'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'startDate', 'endDate', 'currency', 'billingTerms', 'paymentTerms',
          'rateMultiplierPolicy', 'inheritTermsFromContractId', 'updatedAt'
        ]);
    }

    function mainContractUpdateWhenActiveAllowed() {
      return mainContractCostingOnlyUpdate()
        || mainContractActiveToClosedSync()
        || mainContractActiveToRevisedParent()
        || mainContractSupplementalSyncFromMaster();
    }

    function mobilizationCreateHasValidSalesTerm() {
      let m = request.resource.data;
      return m.keys().hasAll(['salesContractTermId', 'poId'])
        && m.salesContractTermId is string
        && m.salesContractTermId.size() > 0
        && exists(/databases/$(database)/documents/sales_contract_terms/$(m.salesContractTermId))
        && get(/databases/$(database)/documents/sales_contract_terms/$(m.salesContractTermId)).data.purchaseOrderId == m.poId
        && get(/databases/$(database)/documents/sales_contract_terms/$(m.salesContractTermId)).data.status == 'ACTIVE';
    }

    // -------------------------------------------------------------------------
    // USERS
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if canManageSystem() || isOwner(userId);
      allow list: if canManageSystem();
      allow create: if canManageSystem() || (isOwner(userId) && selfRegistrationUserCreateValid(userId));
      allow update: if canManageSystem() || (isOwner(userId) && !isModifyingSecurityFields());
      allow delete: if canManageSystem();
    }

    // -------------------------------------------------------------------------
    // Sales domain
    // -------------------------------------------------------------------------
    match /customers/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(id);
      allow write: if canAccessSales();
    }

    match /quotations/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessSales();
    }

    match /main_contracts/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow create: if internalReadNonStoreOfficer();
      allow update: if internalReadNonStoreOfficer()
        && (resource.data.status != 'active' || mainContractUpdateWhenActiveAllowed());
      allow delete: if internalReadNonStoreOfficer() && resource.data.status != 'active';
    }

    match /sales_contract_terms/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessSales();
    }

    match /purchase_orders/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessSales();
    }

    match /rate_conditions/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessSales();
    }

    match /profit_estimates/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessSales();
    }

    // -------------------------------------------------------------------------
    // Operations domain
    // -------------------------------------------------------------------------
    match /waves/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow create: if canAccessOperations() || canAccessSales();
      allow update, delete: if canAccessOperations();
    }

    match /mobilizations/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow create: if canAccessOperations() && mobilizationCreateHasValidSalesTerm();
      allow update, delete: if canAccessOperations();
    }

    // -------------------------------------------------------------------------
    // HR domain
    // -------------------------------------------------------------------------
    match /workers/{id} {
      allow read: if internalReadOrStoreOfficer() || isClientUser();
      allow create: if canEditWorkerRegistry();
      allow update: if canEditWorkerRegistry();
      allow delete: if canDeleteWorkerRecord();
    }

    match /positions/{id} {
      allow read: if internalReadOrStoreOfficer() || isClientUser();
      allow write: if canAccessHR();
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    match /office_staff/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow create, update: if canEditWorkerRegistry();
      allow delete: if isAdminUser() || canEditWorkerRegistry();
    }

    match /worker_document_catalog/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    match /payroll_runs/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    match /payroll_batches/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow create: if canWriteHrPayrollOperationalData();
      allow update: if isAdminUser()
        || (canWriteHrPayrollOperationalData() && !payrollBatchFinanciallyLocked(resource.data))
        || accountingPayrollBatchSafeUpdate();
      allow delete: if isAdminUser();
    }

    match /payroll_periods/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    /** D8 — นโยบาย payroll แบบ versioned (SSO / tax / allowance) */
    match /payroll_policies/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if isAdminUser() || canManageSystem();
    }

    /** D8 — คำขอแก้ไขหลัง approve/paid */
    match /payroll_correction_requests/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow create: if canWriteHrPayrollOperationalData();
      allow update: if canWriteHrPayrollOperationalData() || isAdminUser();
      allow delete: if isAdminUser();
    }

    match /office_payroll_runs/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow create: if canWriteHrPayrollOperationalData() || isAdminUser();
      allow update: if isAdminUser()
        || (canWriteHrPayrollOperationalData() && !officePayrollRunFrozen(resource.data))
        || accountingOfficePayrollSafeUpdate();
      allow delete: if isAdminUser();
    }

    match /executive_payroll_runs/{id} {
      allow read: if canAccessAccounting() || canManageSystem();
      allow write: if canAccessAccounting() || canManageSystem();
    }

    match /payment_export_batches/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    match /daily_timesheets/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow create: if canWriteHrPayrollOperationalData();
      allow update: if canWriteHrPayrollOperationalData()
        && (isAdminUser() || !dailyTimesheetFinalized(resource.data));
      allow delete: if isAdminUser();
    }

    match /exception_requests/{id} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if canAccessHR();
    }

    match /worker_wave_acceptances/{id} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessOperations();
    }

    // -------------------------------------------------------------------------
    // Store domain
    // -------------------------------------------------------------------------
    match /vendors/{id} {
      allow read: if internalRead();
      allow write: if canWriteStore();
    }

    match /purchases/{purchaseId} {
      allow read: if internalRead();
      allow write: if canWriteStore();
    }

    match /purchases/{purchaseId}/{document=**} {
      allow read: if internalRead();
      allow write: if canWriteStore();
    }

    match /store_items/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    match /store_transactions/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    match /store_receipts/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    match /store_issue_slips/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    match /store_return_slips/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    match /store_writeoffs/{id} {
      allow read: if canAccessStore();
      allow write: if canWriteStore();
    }

    // -------------------------------------------------------------------------
    // Accounting domain
    // -------------------------------------------------------------------------
    match /billing_notes/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /tax_invoices/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    // ใบเสร็จ: receivedAmount = ยอดตามใบกำกับ; cashDepositAmount / withholdingTaxAmount = หัก ณ คู่ใบกำกับ (ไม่ต้องแยก rule)
    match /receipts/{id} {
      allow get: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow list: if internalReadNonStoreOfficer() || (isSignedIn() && isClientUser() && resource.data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /receipts/{id}/allocations/{allocId} {
      allow read: if internalReadNonStoreOfficer()
        || (isSignedIn() && isClientUser() && userCustomerId() != null
            && get(/databases/$(database)/documents/receipts/$(id)).data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /ap_bills/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /accounts_receivable/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /accounts_payable/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /bank_accounts/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /cashbook_entries/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    // -------------------------------------------------------------------------
    // System collections
    // -------------------------------------------------------------------------
    match /number_sequences/{id} {
      // Admin manages all sequences.
      // Scoped read/write for generateNextDocumentCode: sales / HR / accounting / ops / store.
      allow read, write: if canManageSystem()
        || (internalReadNonStoreOfficer() && id == 'main_contract')
        || (canWriteStore() && id in ['vendor', 'purchase', 'store_receive', 'store_issue', 'store_return', 'store_writeoff'])
        || (canAccessAccounting() && isAccountingSequenceId(id))
        || (canAccessHR() && isHrSequenceId(id))
        || (canAccessSales() && isSalesSequenceId(id))
        || (canAccessOperations() && isOperationsSequenceId(id));
    }

    match /permission_profiles/{id} {
      allow get: if isSignedIn() && (canManageSystem() || canReadOwnPermissionProfile(resource.data));
      allow list: if canManageSystem();
      allow write: if canManageSystem();
    }

    match /roles_system_admin/{id} {
      allow read, write: if canManageSystem();
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow create: if canManageSystem()
        || (docId == 'bootstrap' && isSignedIn()
            && !exists(/databases/$(database)/documents/system/bootstrap));
      allow update, delete: if canManageSystem();
    }

    // -------------------------------------------------------------------------
    // Audit logs
    // -------------------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if canManageSystem() || internalReadNonStoreOfficer();
      allow create: if isSignedIn() && userExists();
      allow update, delete: if false;
    }

    match /approvals/{id} {
      allow read: if internalReadOrStoreOfficer() || isClientUser();
      allow write: if canAccessHR() || canAccessOperations() || canManageSystem();
    }

    match /client_portal/{document=**} {
      allow read: if canManageSystem() || isClientUser();
      allow write: if canManageSystem();
    }

    // -------------------------------------------------------------------------
    // Subcollections
    // -------------------------------------------------------------------------
    match /workers/{workerId}/{document=**} {
      allow read: if internalReadOrStoreOfficer() || isClientUser();
      allow write: if canEditWorkerRegistry();
    }

    match /positions/{positionId}/{document=**} {
      allow read: if internalReadOrStoreOfficer() || isClientUser();
      allow write: if canAccessHR();
    }

    match /customers/{customerId}/{document=**} {
      allow read: if internalReadOrStoreOfficer() || sameCustomerId(customerId);
      allow write: if canAccessSales();
    }

    match /main_contracts/{contractId}/{document=**} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if internalReadNonStoreOfficer();
    }

    match /quotations/{quotationId}/{document=**} {
      allow read: if internalReadOrStoreOfficer() || (
        isClientUser()
        && get(/databases/$(database)/documents/quotations/$(quotationId)).data.customerId == userCustomerId()
      );
      allow write: if canAccessSales();
    }

    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read: if internalReadOrStoreOfficer() || (
        isClientUser()
        && get(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)).data.customerId == userCustomerId()
      );
      allow write: if canAccessSales();
    }

    match /billing_notes/{billingNoteId}/{document=**} {
      allow read: if internalReadNonStoreOfficer() || (
        isClientUser()
        && get(/databases/$(database)/documents/billing_notes/$(billingNoteId)).data.customerId == userCustomerId()
      );
      allow write: if canAccessAccounting();
    }

    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read: if internalReadNonStoreOfficer() || (
        isClientUser()
        && get(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId)).data.customerId == userCustomerId()
      );
      allow write: if canAccessAccounting();
    }

    match /receipts/{receiptId}/{document=**} {
      allow read: if internalReadNonStoreOfficer() || (
        isClientUser()
        && get(/databases/$(database)/documents/receipts/$(receiptId)).data.customerId == userCustomerId()
      );
      allow write: if canAccessAccounting();
    }

    /**
     * Payroll line documents — path ชัดเจนเพื่อให้ collectionGroup('lines') + where ทำงาน
     * (recursive {document=**} ใต้ batch/run บางกรณีไม่ครอบคลุม list แบบ collection group)
     */
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if internalReadOrStoreOfficer() || canAccessAccounting();
      allow write: if isAdminUser()
        || (canWriteHrPayrollOperationalData()
            && !payrollBatchFinanciallyLocked(payrollBatchSnapshot(batchId)))
        || (isAccountingUser()
            && payrollBatchSnapshot(batchId).status in ['HR_APPROVED', 'FINANCE_PREPARED']);
    }

    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if internalReadOrStoreOfficer() || canAccessAccounting();
      allow write: if isAdminUser()
        || (canWriteHrPayrollOperationalData()
            && !officePayrollRunFrozen(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || (isAccountingUser()
            && get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data.status == 'HR_APPROVED');
    }

    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read: if canAccessAccounting() || canManageSystem();
      allow write: if canAccessAccounting() || canManageSystem();
    }

    match /payroll_batches/{batchId}/{document=**} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if isAdminUser()
        || (canWriteHrPayrollOperationalData()
            && !payrollBatchFinanciallyLocked(payrollBatchSnapshot(batchId)))
        || (isAccountingUser()
            && payrollBatchSnapshot(batchId).status in ['HR_APPROVED', 'FINANCE_PREPARED']);
    }

    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if isAdminUser()
        || (canWriteHrPayrollOperationalData()
            && !officePayrollRunFrozen(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || (isAccountingUser()
            && get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data.status == 'HR_APPROVED');
    }

    match /executive_payroll_runs/{runId}/{document=**} {
      allow read: if canAccessAccounting() || canManageSystem();
      allow write: if canAccessAccounting() || canManageSystem();
    }

    // -------------------------------------------------------------------------
    // Collection Groups
    // -------------------------------------------------------------------------
    match /{path=**}/po_lines/{lineId} {
      allow read: if internalReadOrStoreOfficer();
    }

    match /{path=**}/position_rates/{rateId} {
      allow read: if internalReadOrStoreOfficer();
      allow write: if internalReadNonStoreOfficer();
    }

    match /{document=**} {
      allow read, write: if canManageSystem();
    }
  }
}
