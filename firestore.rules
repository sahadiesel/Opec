rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * OPEC Manpower Supply - Security Rules
     * 
     * Core Philosophy: Role-Based Access Control (RBAC) via DBAC (Database Access Control).
     * Staff roles are stored in dedicated collections: /roles_[role_name]/{uid}
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // Generic Role Check
    function hasRole(role) {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_$(role)/$(request.auth.uid));
    }

    // Role check helpers
    function isSystemAdmin() { return hasRole('system_admin'); }
    function isHRManager() { return hasRole('hr_manager'); }
    function isHROfficer() { return hasRole('hr_officer'); }
    function isSalesOfficer() { return hasRole('sales_officer'); }
    function isFinanceOfficer() { return hasRole('finance_officer'); }
    function isPayrollOfficer() { return hasRole('payroll_officer'); }
    function isStoreOfficer() { return hasRole('store_officer'); }

    // General Staff check (Anyone with any staff role)
    function isStaff() {
      return isSignedIn() && (
        isSystemAdmin() || 
        isHRManager() || 
        isHROfficer() || 
        isSalesOfficer() || 
        isFinanceOfficer() || 
        isPayrollOfficer() || 
        isStoreOfficer()
      );
    }

    // HR specific staff (Admins and HR roles)
    function isHRStaff() {
      return isSignedIn() && (isSystemAdmin() || isHRManager() || isHROfficer());
    }

    // User profiles
    match /users {
      // Explicitly allow list if staff
      allow list: if isStaff();
      match /{userId} {
        // Anyone signed in can get their own or others can be gotten by staff
        allow get: if isStaff() || (isSignedIn() && request.auth.uid == userId);
        // Only system admins can create/update arbitrary profiles, users can update their own
        allow write: if isSystemAdmin() || (isSignedIn() && request.auth.uid == userId);
      }
    }

    // Workers & Records
    match /workers {
      allow list: if isStaff();
      match /{workerId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        
        match /certificates/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /medical_records/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /drug_tests/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
        match /documents/{id} { allow read: if isStaff(); allow write: if isHRStaff(); }
      }
    }

    // Positions & Requirements
    match /positions {
      allow list: if isStaff();
      match /{positionId} {
        allow get: if isStaff();
        allow write: if isHRStaff();
        
        match /certificate_requirements/{id} { allow read, write: if isHRStaff(); }
        match /ppe_requirements/{id} { allow read, write: if isHRStaff(); }
        match /tool_requirements/{id} { allow read, write: if isHRStaff(); }
      }
    }

    // Commercial Hierarchy
    match /customers {
      allow list: if isStaff();
      match /{customerId} {
        allow get: if isStaff();
        allow write: if isSystemAdmin() || isSalesOfficer();
        
        match /contacts/{id} { allow read, write: if isStaff(); }
        
        match /main_contracts/{id} { 
          allow read: if isStaff();
          allow write: if isSystemAdmin() || isSalesOfficer();

          match /position_rates/{rateId} { allow read, write: if isStaff(); }
          
          match /purchase_orders/{poId} { 
            allow read: if isStaff();
            allow write: if isSystemAdmin() || isSalesOfficer();

            match /po_lines/{lineId} { 
              allow read: if isStaff();
              allow write: if isSystemAdmin() || isSalesOfficer();

              match /assignments/{asgnId} { allow read, write: if isStaff(); }
            }
          }
        }
      }
    }

    // Roles & System Bootstrap - READ allowed for signed in users to check their own role status
    match /roles_hr_manager/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_hr_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_system_admin/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_sales_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_finance_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_payroll_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    match /roles_store_officer/{uid} { allow read: if isSignedIn() && request.auth.uid == uid; }
    
    match /system/bootstrap { allow read: if true; }

    // Collection Group support for global listing
    match /{path=**}/assignments/{asgnId} { allow read: if isStaff(); }
    match /{path=**}/purchase_orders/{poId} { allow read: if isStaff(); }
    match /{path=**}/po_lines/{lineId} { allow read: if isStaff(); }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}