rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Basic identity
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return userExists() ? get(userDocPath()).data : null;
    }

    function isActiveUser() {
      let u = userData();
      return u != null
        && (!('isActive' in u) || u.isActive == true)
        && (!('approvalStatus' in u)
          || u.approvalStatus == 'ACTIVE'
          || u.approvalStatus == 'APPROVED'
          || u.approvalStatus == 'active');
    }

    function isInternalUser() {
      let u = userData();
      return u != null
        && u.userType != 'customer_portal'
        && u.accessGroup != 'client'
        && u.department != 'client';
    }

    function isEligibleInternal() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser();
    }

    function isClientUser() {
      let u = userData();
      return u != null
        && isActiveUser()
        && (u.userType == 'customer_portal' || u.accessGroup == 'client' || u.department == 'client');
    }

    function userCustomerId() {
      let u = userData();
      return u != null && ('customerId' in u) ? u.customerId : null;
    }

    function sameCustomerId(customerId) {
      return isClientUser() && userCustomerId() != null && userCustomerId() == customerId;
    }

    // ---------------------------------------------------------------------
    // Simple role helpers
    // ---------------------------------------------------------------------
    /**
     * Primary business role — align with app getPrimaryLegacyRole.
     * Many users only have permissionProfileKey (e.g. hr_officer) without assignedRoleKey/roleId.
     */
    function roleKey() {
      let u = userData();
      return u == null
        ? null
        : ('assignedRoleKey' in u && u.assignedRoleKey is string && u.assignedRoleKey.size() > 0
            ? u.assignedRoleKey
            : ('roleId' in u && u.roleId is string && u.roleId.size() > 0
                ? u.roleId
                : ('permissionProfileKey' in u && u.permissionProfileKey is string && u.permissionProfileKey.size() > 0
                    ? u.permissionProfileKey
                    : null)));
    }

    function userListsProfile(profileId) {
      let u = userData();
      return u != null
        && ('permissionProfileKeys' in u)
        && u.permissionProfileKeys is list
        && profileId in u.permissionProfileKeys;
    }

    /**
     * UI บันทึก permission profile key เป็นตัวพิมพ์ใหญ่ (HR_OFFICER) — แมตช์กับค่า canonical ตัวพิมพ์เล็กในกฎ
     */
    function normalizedRoleKey() {
      let k = roleKey();
      return k == null
        ? null
        : k == 'HR_OFFICER' || k == 'hr_officer' ? 'hr_officer'
        : k == 'HR_MANAGER' || k == 'hr_manager' ? 'hr_manager'
        : k == 'PAYROLL_OFFICER' || k == 'payroll_officer' ? 'payroll_officer'
        : k == 'SYSTEM_ADMIN' || k == 'system_admin' || k == 'ADMIN_ADMIN' || k == 'admin_admin' ? 'system_admin'
        : k == 'ACCOUNTING_MANAGER' || k == 'accounting_manager' ? 'accounting_manager'
        : k == 'ACCOUNTING_OFFICER' || k == 'accounting_officer' ? 'accounting_officer'
        : k == 'SALES_MANAGER' || k == 'sales_manager' ? 'sales_manager'
        : k == 'SALES_OFFICER' || k == 'sales_officer' ? 'sales_officer'
        : k == 'STORE_OFFICER' || k == 'store_officer' ? 'store_officer'
        : k == 'STORE_MANAGER' || k == 'store_manager' ? 'store_manager'
        : k == 'OPERATION_MANAGER' || k == 'operation_manager' ? 'operation_manager'
        : k == 'OPERATIONS_MANAGER' || k == 'operations_manager' ? 'operation_manager'
        : k == 'OPERATION_OFFICER' || k == 'operation_officer' ? 'operation_officer'
        : k == 'CLIENT_USER' || k == 'client_user' ? 'client_user'
        : k;
    }

    function departmentGroup() {
      let u = userData();
      return u != null && ('departmentGroup' in u) ? u.departmentGroup
        : (u != null && ('accessGroup' in u) ? u.accessGroup : null);
    }

    function department() {
      let u = userData();
      return u != null && ('department' in u) ? u.department : null;
    }

    function isAdminUser() {
      return isEligibleInternal()
        && (
          normalizedRoleKey() == 'system_admin'
          || departmentGroup() == 'admin'
          || department() == 'admin'
        );
    }

    function isAccountingUser() {
      return isEligibleInternal()
        && (
          normalizedRoleKey() == 'accounting_manager'
          || normalizedRoleKey() == 'accounting_officer'
          || departmentGroup() == 'accounting'
          || department() == 'accounting'
        );
    }

    function isSalesUser() {
      return isEligibleInternal()
        && (
          normalizedRoleKey() == 'sales_manager'
          || normalizedRoleKey() == 'sales_officer'
          || department() == 'sales'
        );
    }

    function isHrOfficer() {
      return isEligibleInternal()
        && normalizedRoleKey() != 'payroll_officer'
        && (
          normalizedRoleKey() == 'hr_officer'
          || department() == 'hr'
          || department() == 'HR'
          || userListsProfile('hr_officer')
          || userListsProfile('HR_OFFICER')
        );
    }

    /** HR Manager — แยกจาก hr_officer; ใช้ในเมนูทะเบียน/แดชบอร์ด HR และอ่านงวด payroll */
    function isHrManager() {
      return isEligibleInternal()
        && (
          normalizedRoleKey() == 'hr_manager'
          || userListsProfile('hr_manager')
          || userListsProfile('HR_MANAGER')
        );
    }

    function isPayrollOfficer() {
      return isEligibleInternal()
        && normalizedRoleKey() == 'payroll_officer';
    }

    function isStoreOfficer() {
      return isEligibleInternal()
        && (
          normalizedRoleKey() == 'store_officer'
          || department() == 'store'
        );
    }

    function isOperationManager() {
      return isEligibleInternal()
        && normalizedRoleKey() == 'operation_manager';
    }

    function internalRead() {
      return isEligibleInternal();
    }

    function internalReadNonStoreOfficer() {
      return internalRead() && !isStoreOfficer();
    }

    // ---------------------------------------------------------------------
    // Domain access model
    // ---------------------------------------------------------------------
    function canManageSystem() {
      return isAdminUser();
    }

    /** Own permission matrix row — used by client hooks (onSnapshot by doc id). List stays admin-only. */
    function userMayReadOwnPermissionProfile(profileDocId) {
      let u = userData();
      return isEligibleInternal()
        && u != null
        && (
          (('permissionProfileKey' in u) && u.permissionProfileKey == profileDocId)
          || (('permissionProfileKeys' in u)
            && u.permissionProfileKeys is list
            && profileDocId in u.permissionProfileKeys)
        );
    }

    function canAccessSales() {
      return isAdminUser() || isSalesUser() || isOperationManager();
    }

    function canAccessOperations() {
      return isAdminUser() || isOperationManager() || isHrManager() || isHrOfficer();
    }

    function canAccessHR() {
      return isAdminUser() || isOperationManager() || isHrManager() || isHrOfficer() || isPayrollOfficer();
    }

    function canAccessStore() {
      return isAdminUser() || isOperationManager() || isStoreOfficer();
    }

    function canAccessAccounting() {
      return isAdminUser() || isAccountingUser();
    }

    /**
     * HR master writes — ต้องสอดคล้องกับ ROLE_PERMISSION_MATRIX ใน src/lib/permissions.ts
     * (โมดูล UI: positions, workers, office_staff, worker_documents ↔ collections นี้)
     */
    function canManageHrMasterData() {
      return isAdminUser() || isOperationManager() || isHrManager() || isHrOfficer();
    }

    function canManageWorkers() {
      return canManageHrMasterData();
    }

    function canManagePositions() {
      return canManageHrMasterData();
    }

    function canDeleteHrMaster() {
      return isAdminUser() || isOperationManager();
    }

    function canPreparePayroll() {
      return isAdminUser() || isOperationManager() || isPayrollOfficer();
    }

    function canApprovePayroll() {
      return isAdminUser() || isOperationManager();
    }

    function canManagePayrollFinancial() {
      return isAdminUser() || isAccountingUser();
    }

    /** อ่าน payroll_runs / batches / office runs / policies — HR ต้องเห็นในแดชบอร์ด HR */
    function canViewPayroll() {
      return isAdminUser() || isOperationManager() || isPayrollOfficer() || isAccountingUser()
        || isHrManager()
        || isHrOfficer();
    }

    function payrollBatchLocked(data) {
      return data.status in ['LOCKED', 'PAID'];
    }

    function officePayrollRunLocked(data) {
      return data.status in ['FINANCE_APPROVED', 'PAID', 'LOCKED'];
    }

    function dailyTimesheetLocked(data) {
      return data.status in ['LOCKED', 'CLIENT_APPROVED', 'VERIFIED_PAPER'];
    }

    function managerOnlyPayrollStatus(status) {
      return status in ['HR_APPROVED', 'FINANCE_PREPARED', 'FINANCE_APPROVED', 'PAID', 'LOCKED'];
    }

    function payrollUpdateAllowedForPreparer() {
      let nextStatus = 'status' in request.resource.data ? request.resource.data.status : null;
      return nextStatus == null || !managerOnlyPayrollStatus(nextStatus);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function selfRegistrationUserCreateValid(uid) {
      let d = request.resource.data;
      return d.approvalStatus == 'PENDING'
        && d.isActive == false
        && d.userType == 'internal'
        && !d.keys().hasAny([
          'accessGroup', 'departmentGroup', 'assignedRoleKey', 'assignedRoleKeys',
          'permissionProfileKey', 'permissionProfileKeys', 'accessLevel', 'allowedModules',
          'portalRole', 'customerId'
        ])
        && d.roleIds is list
        && d.roleIds.size() == 0
        && d.id == uid;
    }

    function isModifyingSecurityFields() {
      let protectedFields = [
        'userType', 'accessGroup', 'accessLevel', 'departmentGroup', 'allowedModules',
        'customerId', 'portalRole', 'isActive', 'approvalStatus', 'mustResetPassword',
        'roleId', 'roleIds', 'assignedRoleKey', 'assignedRoleKeys',
        'permissionProfileKey', 'permissionProfileKeys',
        'department', 'level', 'dataAccess'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // ---------------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow get: if canManageSystem() || isOwner(userId);
      allow list: if canManageSystem();
      allow create: if canManageSystem() || (isOwner(userId) && selfRegistrationUserCreateValid(userId));
      allow update: if canManageSystem() || (isOwner(userId) && !isModifyingSecurityFields());
      allow delete: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // SALES
    // ---------------------------------------------------------------------
    match /customers/{id} {
      allow read: if internalRead() || sameCustomerId(id);
      allow write: if canAccessSales();
    }

    match /quotations/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessSales();
    }

    match /main_contracts/{id} {
      allow read: if internalRead();
      allow write: if canAccessSales();
    }

    match /sales_contract_terms/{id} {
      allow read: if internalRead();
      allow write: if canAccessSales();
    }

    match /purchase_orders/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessSales();
    }

    match /rate_conditions/{id} {
      allow read: if internalRead();
      allow write: if canAccessSales();
    }

    match /profit_estimates/{id} {
      allow read: if internalRead();
      allow write: if canAccessSales();
    }

    // ---------------------------------------------------------------------
    // OPERATIONS
    // ---------------------------------------------------------------------
    match /waves/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow create: if canAccessOperations() || canAccessSales();
      allow update, delete: if canAccessOperations();
    }

    match /mobilizations/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessOperations();
    }

    match /assignments/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessOperations();
    }

    match /worker_wave_acceptances/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessOperations();
    }

    // ---------------------------------------------------------------------
    // HR / PAYROLL
    // ---------------------------------------------------------------------
    match /workers/{id} {
      allow read: if internalRead() || isClientUser();
      allow create, update: if canManageWorkers();
      allow delete: if canDeleteHrMaster();
    }

    match /positions/{id} {
      allow read: if internalRead() || isClientUser();
      allow create, update: if canManagePositions();
      allow delete: if canDeleteHrMaster();
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if internalRead();
      allow write: if canAccessHR();
    }

    match /office_staff/{id} {
      allow read: if internalRead();
      allow create, update: if canManageHrMasterData();
      allow delete: if canDeleteHrMaster();
    }

    match /worker_document_catalog/{id} {
      allow read: if internalRead();
      allow write: if canManageHrMasterData();
    }

    match /payroll_runs/{id} {
      allow read: if canViewPayroll();
      allow create: if canPreparePayroll();
      allow update: if canApprovePayroll() || (canPreparePayroll() && payrollUpdateAllowedForPreparer());
      allow delete: if canApprovePayroll();
    }

    match /payroll_batches/{id} {
      allow read: if canViewPayroll();
      allow create: if canPreparePayroll();
      allow update: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(resource.data) && payrollUpdateAllowedForPreparer())
        || canManagePayrollFinancial();
      allow delete: if canApprovePayroll();
    }

    match /payroll_periods/{id} {
      allow read: if canViewPayroll();
      allow write: if canPreparePayroll() || canApprovePayroll();
    }

    match /payroll_policies/{id} {
      allow read: if canViewPayroll();
      /** HR / payroll ปรับอัตราประกันสังคมและขั้นบันไดภาษี — อิงเมนูตั้งค่า HR */
      allow write: if canManageSystem()
        || canPreparePayroll()
        || canApprovePayroll()
        || (isEligibleInternal()
            && (normalizedRoleKey() == 'hr_manager' || normalizedRoleKey() == 'hr_officer'));
    }

    match /payroll_correction_requests/{id} {
      allow read: if canViewPayroll();
      allow create, update: if canPreparePayroll() || canApprovePayroll() || canManagePayrollFinancial();
      allow delete: if canManageSystem();
    }

    match /office_payroll_runs/{id} {
      allow read: if canViewPayroll();
      allow create: if canPreparePayroll() || canApprovePayroll();
      allow update: if canApprovePayroll()
        || (canPreparePayroll() && !officePayrollRunLocked(resource.data) && payrollUpdateAllowedForPreparer())
        || canManagePayrollFinancial();
      allow delete: if canApprovePayroll();
    }

    match /executive_payroll_runs/{id} {
      allow read, write: if canManagePayrollFinancial() || canManageSystem();
    }

    match /payment_export_batches/{id} {
      allow read: if canViewPayroll();
      allow write: if canManagePayrollFinancial() || canApprovePayroll();
    }

    match /daily_timesheets/{id} {
      allow read: if internalRead() || sameCustomerId(resource.data.customerId);
      allow create: if canAccessHR();
      allow update: if canAccessHR() && !dailyTimesheetLocked(resource.data);
      allow delete: if canApprovePayroll();
    }

    match /exception_requests/{id} {
      allow read: if internalRead();
      allow write: if canAccessHR();
    }

    // ---------------------------------------------------------------------
    // STORE
    // ---------------------------------------------------------------------
    match /vendors/{id} {
      allow read: if internalRead();
      allow write: if canAccessStore();
    }

    match /purchases/{purchaseId} {
      allow read: if internalRead();
      allow write: if canAccessStore();
    }

    match /purchases/{purchaseId}/{document=**} {
      allow read: if internalRead();
      allow write: if canAccessStore();
    }

    match /store_items/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    match /store_transactions/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    match /store_receipts/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    match /store_issue_slips/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    match /store_return_slips/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    match /store_writeoffs/{id} {
      allow read: if canAccessStore();
      allow write: if canAccessStore();
    }

    // ---------------------------------------------------------------------
    // ACCOUNTING
    // ---------------------------------------------------------------------
    match /billing_notes/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /tax_invoices/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /receipts/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /receipts/{id}/allocations/{allocId} {
      allow read: if internalReadNonStoreOfficer()
        || (isClientUser()
            && get(/databases/$(database)/documents/receipts/$(id)).data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /ap_bills/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /accounts_receivable/{id} {
      allow read: if internalReadNonStoreOfficer() || sameCustomerId(resource.data.customerId);
      allow write: if canAccessAccounting();
    }

    match /accounts_payable/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /bank_accounts/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    match /cashbook_entries/{id} {
      allow read: if internalReadNonStoreOfficer();
      allow write: if canAccessAccounting();
    }

    // ---------------------------------------------------------------------
    // SYSTEM
    // ---------------------------------------------------------------------
    match /number_sequences/{id} {
      allow read, write: if canManageSystem()
        || (canAccessSales() && id in ['customer', 'customer_po', 'quotation', 'sales_term'])
        || (canAccessOperations() && id in ['wave', 'assignment'])
        || (canAccessHR() && id in ['worker', 'office_staff', 'position', 'payroll_run', 'office_payroll_run', 'cost_term'])
        || (canAccessAccounting() && id in ['billing_note', 'tax_invoice', 'receipt', 'ap_bill', 'ar', 'ap', 'cashbook_entry', 'bank_account', 'executive_payroll_run'])
        || (canAccessStore() && id in ['vendor', 'purchase', 'store_receive', 'store_issue', 'store_return', 'store_writeoff'])
        || (internalReadNonStoreOfficer() && id == 'main_contract');
    }

    match /permission_profiles/{id} {
      allow get: if canManageSystem() || userMayReadOwnPermissionProfile(id);
      allow list: if canManageSystem();
      allow write: if canManageSystem();
    }

    match /roles_system_admin/{id} {
      allow read, write: if canManageSystem();
    }

    match /system/{docId} {
      allow read: if isSignedIn();
      allow create: if canManageSystem()
        || (docId == 'bootstrap' && isSignedIn()
            && !exists(/databases/$(database)/documents/system/bootstrap));
      allow update, delete: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // AUDIT / APPROVALS / CLIENT PORTAL
    // ---------------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if canManageSystem() || internalReadNonStoreOfficer();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /approvals/{id} {
      allow read: if internalRead() || isClientUser();
      allow write: if canAccessHR() || canAccessOperations() || canManageSystem();
    }

    match /client_portal/{document=**} {
      allow read: if canManageSystem() || isClientUser();
      allow write: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // SUBCOLLECTIONS
    // ---------------------------------------------------------------------
    match /workers/{workerId}/{document=**} {
      allow read: if internalRead() || isClientUser();
      allow write: if canManageWorkers();
    }

    match /positions/{positionId}/{document=**} {
      allow read: if internalRead() || isClientUser();
      allow write: if canManagePositions();
    }

    match /customers/{customerId}/{document=**} {
      allow read: if internalRead() || sameCustomerId(customerId);
      allow write: if canAccessSales();
    }

    match /main_contracts/{contractId}/{document=**} {
      allow read: if internalRead();
      allow write: if canAccessSales();
    }

    match /quotations/{quotationId}/{document=**} {
      allow read: if internalRead()
        || (isClientUser()
            && get(/databases/$(database)/documents/quotations/$(quotationId)).data.customerId == userCustomerId());
      allow write: if canAccessSales();
    }

    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read: if internalRead()
        || (isClientUser()
            && get(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)).data.customerId == userCustomerId());
      allow write: if canAccessSales();
    }

    match /billing_notes/{billingNoteId}/{document=**} {
      allow read: if internalReadNonStoreOfficer()
        || (isClientUser()
            && get(/databases/$(database)/documents/billing_notes/$(billingNoteId)).data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read: if internalReadNonStoreOfficer()
        || (isClientUser()
            && get(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId)).data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /receipts/{receiptId}/{document=**} {
      allow read: if internalReadNonStoreOfficer()
        || (isClientUser()
            && get(/databases/$(database)/documents/receipts/$(receiptId)).data.customerId == userCustomerId());
      allow write: if canAccessAccounting();
    }

    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if canViewPayroll();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(get(/databases/$(database)/documents/payroll_batches/$(batchId)).data))
        || canManagePayrollFinancial();
    }

    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if canViewPayroll();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !officePayrollRunLocked(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || canManagePayrollFinancial();
    }

    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if canAccessAccounting() || canManageSystem();
    }

    match /payroll_batches/{batchId}/{document=**} {
      allow read: if canViewPayroll();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(get(/databases/$(database)/documents/payroll_batches/$(batchId)).data))
        || canManagePayrollFinancial();
    }

    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if canViewPayroll();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !officePayrollRunLocked(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || canManagePayrollFinancial();
    }

    match /executive_payroll_runs/{runId}/{document=**} {
      allow read, write: if canAccessAccounting() || canManageSystem();
    }

    // ---------------------------------------------------------------------
    // COLLECTION GROUPS
    // ---------------------------------------------------------------------
    match /{path=**}/po_lines/{lineId} {
      allow read: if internalRead();
    }

    match /{path=**}/position_rates/{rateId} {
      allow read: if internalRead();
      allow write: if internalReadNonStoreOfficer();
    }

    match /{document=**} {
      allow read, write: if canManageSystem();
    }
  }
}

