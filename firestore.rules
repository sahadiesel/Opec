rules_version = '2';
// 3-tier model: admin | accounting | internal (default). ASCII-only comments (Console publish).
// Supports both snake_case (status, user_type, role) and legacy camelCase (approvalStatus, userType, assignedRoleKey).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return isSignedIn() && exists(userRef());
    }

    function userData() {
      return get(userRef()).data;
    }

    function isActiveStatus(d) {
      return d != null && (
        ('status' in d && (d.status == 'active' || d.status == 'ACTIVE'))
        || ('approvalStatus' in d && (d.approvalStatus == 'ACTIVE' || d.approvalStatus == 'APPROVED' || d.approvalStatus == 'active'))
        || ((!('status' in d) || d.status == null) && (!('approvalStatus' in d) || d.approvalStatus == null) && d.isActive == true)
      );
    }

    function isInternalTypeData(d) {
      return d != null
        && !isCustomerPortalData(d)
        && (
          ('user_type' in d && (d.user_type == 'internal' || d.user_type == 'INTERNAL'))
          || ('userType' in d && d.userType == 'internal')
          || (!('user_type' in d) && !('userType' in d))
        );
    }

    function isCustomerPortalData(d) {
      return d != null && (
        ('user_type' in d && (d.user_type == 'customer_portal' || d.user_type == 'CUSTOMER_PORTAL'))
        || ('userType' in d && d.userType == 'customer_portal')
      );
    }

    function effectiveRole(d) {
      return (d != null && 'role' in d && d.role is string && d.role.size() > 0)
        ? d.role.lower()
        : (d != null && 'assignedRoleKey' in d && d.assignedRoleKey is string && d.assignedRoleKey.size() > 0
          ? d.assignedRoleKey.lower()
          : null);
    }

    function isInternalUser() {
      return hasUserDoc()
        && isInternalTypeData(userData())
        && !isCustomerPortalData(userData())
        && isActiveStatus(userData());
    }

    function isAdmin() {
      return isInternalUser() && effectiveRole(userData()) == 'system_admin';
    }

    function isAccounting() {
      return isInternalUser()
        && effectiveRole(userData()) != null
        && (effectiveRole(userData()) == 'accounting_manager' || effectiveRole(userData()) == 'accounting_officer');
    }

    function isAccountingOrAdmin() {
      return isAdmin() || isAccounting();
    }

    // Head of commercial/ops/HR pillar (not system_admin): broad internal business access in app + rules.
    function isOperationsPillarExecutive() {
      let d = userData();
      return isInternalUser()
        && (
          effectiveRole(d) == 'operations_manager'
          || effectiveRole(d) == 'hr_manager'
          || effectiveRole(d) == 'sales_manager'
          || (
            d != null
            && (
              ('accessGroup' in d && (d.accessGroup == 'operations' || d.accessGroup == 'operation'))
              || ('departmentGroup' in d && (d.departmentGroup == 'operations' || d.departmentGroup == 'operation'))
            )
            && ('accessLevel' in d && d.accessLevel == 'manager')
          )
        );
    }

    function isCustomerPortalUserCreate(userId) {
      let c = request.resource.data;
      return c.id == userId
        && c.userType == 'customer_portal'
        && c.assignedRoleKey == 'client_user'
        && ('customerId' in c)
        && c.customerId is string
        && c.customerId.size() > 0
        && ('email' in c)
        && c.email is string;
    }

    function opsExecClientPortalUpdateOk() {
      let before = resource.data;
      let after = request.resource.data;
      return isOperationsPillarExecutive()
        && before.userType == 'customer_portal'
        && after.userType == 'customer_portal'
        && before.assignedRoleKey == 'client_user'
        && after.assignedRoleKey == 'client_user'
        && before.customerId == after.customerId
        && before.id == after.id;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userSecurityFieldChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'userType', 'user_type', 'status', 'approvalStatus', 'isActive',
        'assignedRoleKey', 'assignedRoleKeys', 'role',
        'permissionProfileKey', 'permissionProfileKeys',
        'accessGroup', 'departmentGroup', 'department', 'level', 'roleId', 'roleIds',
        'customerId', 'portalRole', 'mustResetPassword'
      ]);
    }

    function bootstrapUserCreateValid(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && d.id == uid
        && (d.userType == 'internal' || (('user_type' in d) && (d.user_type == 'internal' || d.user_type == 'INTERNAL')))
        && (d.isActive == true || (('status' in d) && (d.status == 'active' || d.status == 'ACTIVE')))
        && (d.approvalStatus == 'ACTIVE' || (('status' in d) && (d.status == 'active' || d.status == 'ACTIVE')));
    }

    function clientPortalUserActive() {
      return hasUserDoc()
        && isCustomerPortalData(userData())
        && isActiveStatus(userData());
    }

    // ---------- Admin-only (no overlapping permissive catch-all) ----------
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId) || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
      allow list: if isAdmin() || isOperationsPillarExecutive();
      allow create: if isAdmin()
        || (isOwner(userId) && bootstrapUserCreateValid(userId))
        || (isOperationsPillarExecutive() && isCustomerPortalUserCreate(userId));
      allow update: if isAdmin()
        || (isOwner(userId) && !userSecurityFieldChanges())
        || opsExecClientPortalUpdateOk();
      allow delete: if isAdmin()
        || (isOperationsPillarExecutive() && resource.data.userType == 'customer_portal');
    }

    match /roles_system_admin/{id} {
      allow read, write: if isAdmin();
    }

    match /permission_profiles/{id} {
      allow read: if isInternalUser() || clientPortalUserActive();
      allow list: if isInternalUser() || clientPortalUserActive();
      allow write: if isAdmin();
    }

    // UI list: admin only; app services append entries as any internal user.
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isInternalUser();
      allow update, delete: if isAdmin();
    }

    // Document codes (customers, workers, POs, etc.) - any active internal user must read/write.
    match /number_sequences/{id} {
      allow read, write: if isInternalUser();
    }

    // ---------- Accounting-only modules ----------
    match /billing_notes/{id} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /billing_notes/{billingNoteId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /tax_invoices/{id} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /receipts/{id} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /receipts/{id}/allocations/{allocId} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /receipts/{receiptId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /ap_bills/{id} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /accounts_receivable/{id} {
      allow read, write: if isAccountingOrAdmin();
    }

    // Internal users may create rows from store workflow (vendor bill); accounting still controls payment in UI.
    match /accounts_payable/{id} {
      allow read, write: if isInternalUser();
    }

    match /purchase_vendor_bills/{id} {
      allow read, write: if isInternalUser();
    }

    match /bank_accounts/{id} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /cashbook_entries/{id} {
      allow read, write: if isAccountingOrAdmin();
    }

    match /executive_payroll_runs/{id} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if isAccountingOrAdmin();
    }
    match /executive_payroll_runs/{runId}/{document=**} {
      allow read, write: if isAccountingOrAdmin();
    }

    // ---------- System docs (read widened where app needs) ----------
    match /system/{docId} {
      allow read: if isAdmin()
        || (docId == 'bootstrap' && isSignedIn())
        || (docId == 'company_profile' && isInternalUser())
        || (docId == 'drug_test_panel' && isInternalUser());
      allow write: if isAdmin();
    }

    match /approvals/{id} {
      allow read, write: if isInternalUser();
    }

    // ---------- Client portal ----------
    match /client_portal/{document=**} {
      allow read, write: if clientPortalUserActive();
    }

    // ---------- Core operations (all active internal) ----------
    match /customers/{id} {
      allow read, write: if isInternalUser();
    }
    match /customers/{customerId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /quotations/{id} {
      allow read, write: if isInternalUser();
    }
    match /quotations/{quotationId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /main_contracts/{id} {
      allow read, write: if isInternalUser();
    }
    match /main_contracts/{contractId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /sales_contract_terms/{id} {
      allow read, write: if isInternalUser();
    }

    match /purchase_orders/{id} {
      allow read, write: if isInternalUser();
    }
    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /rate_conditions/{id} {
      allow read, write: if isInternalUser();
    }

    match /profit_estimates/{id} {
      allow read, write: if isInternalUser();
    }

    match /waves/{id} {
      allow read, write: if isInternalUser();
    }

    match /mobilizations/{id} {
      allow read, write: if isInternalUser();
    }

    match /assignments/{id} {
      allow read, write: if isInternalUser();
    }

    match /worker_wave_acceptances/{id} {
      allow read, write: if isInternalUser();
    }

    match /workers/{id} {
      allow read, write: if isInternalUser();
    }
    match /workers/{workerId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /positions/{id} {
      allow read, write: if isInternalUser();
    }
    match /positions/{positionId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /labor_cost_contract_terms/{id} {
      allow read, write: if isInternalUser();
    }

    match /office_staff/{id} {
      allow read, write: if isInternalUser();
    }

    match /worker_document_catalog/{id} {
      allow read, write: if isInternalUser();
    }

    match /payroll_runs/{id} {
      allow read, write: if isInternalUser();
    }

    match /payroll_batches/{id} {
      allow read, write: if isInternalUser();
    }
    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read, write: if isInternalUser();
    }
    match /payroll_batches/{batchId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /payroll_periods/{id} {
      allow read, write: if isInternalUser();
    }

    match /payroll_policies/{id} {
      allow read, write: if isInternalUser();
    }

    match /payroll_correction_requests/{id} {
      allow read, write: if isInternalUser();
    }

    match /office_payroll_runs/{id} {
      allow read, write: if isInternalUser();
    }
    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if isInternalUser();
    }
    match /office_payroll_runs/{runId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /payment_export_batches/{id} {
      allow read, write: if isInternalUser();
    }

    match /daily_timesheets/{id} {
      allow read, write: if isInternalUser();
    }

    match /exception_requests/{id} {
      allow read, write: if isInternalUser();
    }

    match /worker_payment_profiles/{id} {
      allow read, write: if isInternalUser();
    }

    match /vendors/{id} {
      allow read, write: if isInternalUser();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isInternalUser();
    }
    match /purchases/{purchaseId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /store_items/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_transactions/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_receipts/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_issue_slips/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_return_slips/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_writeoffs/{id} {
      allow read, write: if isInternalUser();
    }

    match /store_receipts/{receiptId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /store_issue_slips/{slipId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /store_return_slips/{returnId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /store_writeoffs/{writeoffId}/{document=**} {
      allow read, write: if isInternalUser();
    }

    match /{path=**}/po_lines/{lineId} {
      allow read, write: if isInternalUser();
    }

    match /{path=**}/position_rates/{rateId} {
      allow read, write: if isInternalUser();
    }

    match /{path=**}/lines/{lineId} {
      allow read, write: if isInternalUser();
    }

    // Deny by default (no broad catch-all OR with admin paths).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
