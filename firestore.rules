rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return exists(/databases/$(database)/documents/roles_system_admin/$(request.auth.uid)); }
    function isSales() { return exists(/databases/$(database)/documents/roles_sales_officer/$(request.auth.uid)) || isAdmin(); }
    function isHR() { 
      return exists(/databases/$(database)/documents/roles_hr_manager/$(request.auth.uid)) || 
             exists(/databases/$(database)/documents/roles_hr_officer/$(request.auth.uid)) || 
             isAdmin(); 
    }
    function isFinance() {
      return exists(/databases/$(database)/documents/roles_finance_officer/$(request.auth.uid)) || isAdmin();
    }
    function isClient(customerId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId == customerId;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /roles_system_admin/{userId} {
      allow read: if isSignedIn();
      allow create: if !exists(/databases/$(database)/documents/system/bootstrap) || isAdmin();
    }

    match /positions/{posId} {
      allow read: if isSignedIn();
      allow write: if isHR();
      match /{allSub=**} { allow read: if isSignedIn(); allow write: if isHR(); }
    }

    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if isHR();
      match /{allSub=**} { allow read: if isSignedIn(); allow write: if isHR(); }
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSales();
      
      match /contacts/{contactId} { allow read: if isSignedIn(); allow write: if isSales(); }
      
      match /main_contracts/{contractId} {
        allow read: if isSignedIn() && (isSales() || isFinance() || isClient(customerId));
        allow write: if isSales();
        
        match /position_rates/{rateId} { allow read: if isSignedIn(); allow write: if isSales(); }
        
        match /purchase_orders/{poId} {
          allow read: if isSignedIn() && (isSales() || isFinance() || isClient(customerId));
          allow write: if isSales();
          
          match /po_lines/{lineId} { 
            allow read: if isSignedIn(); 
            allow write: if isSales(); 
            
            match /assignments/{asgnId} { 
              allow read: if isSignedIn() && (isHR() || isSales() || isClient(customerId)); 
              allow write: if isHR() || isSales() || isClient(customerId); 
            }
          }
        }
      }
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
    
    match /system/bootstrap {
      allow get: if true;
      allow create: if !exists(/databases/$(database)/documents/system/bootstrap);
    }
  }
}
