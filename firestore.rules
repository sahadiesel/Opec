rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // CORE HELPERS
    // =========================
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userPath());
    }

    function userData() {
      return userExists() ? get(userPath()).data : null;
    }

    function isActiveInternalUser() {
      let u = userData();
      return u != null
        && u.userType != 'customer_portal'
        && u.isActive == true
        && u.approvalStatus == 'ACTIVE';
    }

    function isActiveClientUser() {
      let u = userData();
      return u != null
        && u.userType == 'customer_portal'
        && u.isActive == true
        && u.approvalStatus == 'ACTIVE'
        && u.customerId != null;
    }

    function accessGroup() {
      let u = userData();
      return u != null ? u.accessGroup : null;
    }

    function accessLevel() {
      let u = userData();
      return u != null ? u.accessLevel : null;
    }

    function isAdmin() {
      return isActiveInternalUser()
        && accessGroup() == 'admin';
    }

    function isOperation() {
      return isActiveInternalUser()
        && accessGroup() == 'operation';
    }

    function isAccounting() {
      return isActiveInternalUser()
        && accessGroup() == 'accounting';
    }

    function isManager() {
      return accessLevel() == 'manager' || accessLevel() == 'admin';
    }

    function isOfficer() {
      return accessLevel() == 'officer';
    }

    function hasAllowedModule(moduleKey) {
      let u = userData();
      return u != null
        && u.allowedModules != null
        && u.allowedModules.hasAny([moduleKey]);
    }

    function isInternalUser() {
      return isActiveInternalUser();
    }

    function isClient() {
      return isActiveClientUser();
    }

    function isClientOf(customerId) {
      return isActiveClientUser() && userData().customerId == customerId;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isModifyingSecurityFields() {
      let protectedFields = [
        'userType',
        'accessGroup',
        'accessLevel',
        'allowedModules',
        'customerId',
        'portalRole',
        'isActive',
        'approvalStatus',
        'mustResetPassword',

        // legacy fields also protected
        'roleId',
        'roleIds',
        'assignedRoleKey',
        'assignedRoleKeys',
        'permissionProfileKey',
        'permissionProfileKeys',
        'department',
        'level',
        'dataAccess'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // =========================
    // MODULE ACCESS HELPERS
    // =========================

    // operation group = sales + hr + operations
    function canOperationModule(moduleKey) {
      return isAdmin() || (
        isOperation() && (
          isManager()
          || (isOfficer() && hasAllowedModule(moduleKey))
          || (isOfficer() && userData().allowedModules == null) // transitional default to prevent lockout
        )
      );
    }

    // accounting group = sales + hr + store + accounting
    function canAccountingModule(moduleKey) {
      return isAdmin() || (
        isAccounting() && (
          isManager()
          || (isOfficer() && hasAllowedModule(moduleKey))
          || (isOfficer() && userData().allowedModules == null) // transitional default to prevent lockout
        )
      );
    }

    // =========================
    // USERS
    // =========================
    match /users/{userId} {
      allow get: if isAdmin() || isOwner(userId);
      allow list: if isAdmin();
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && !isModifyingSecurityFields());
      allow delete: if isAdmin();
    }

    // =========================
    // SHARED INTERNAL MODULES
    // =========================

    match /customers/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('customers') || canAccountingModule('customers');
    }

    match /quotations/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('quotations') || canAccountingModule('quotations');
    }

    match /main_contracts/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('main_contracts') || canAccountingModule('main_contracts');
    }

    match /sales_contract_terms/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('sales_contract_terms') || canAccountingModule('sales_contract_terms');
    }

    match /purchase_orders/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('customer_pos') || canAccountingModule('customer_pos');
    }

    match /rate_conditions/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('rate_conditions');
    }

    match /workers/{id} {
      allow read: if isInternalUser() || isClient();
      allow write: if canOperationModule('workers') || canAccountingModule('workers');
    }

    match /positions/{id} {
      allow read: if isInternalUser() || isClient();
      allow write: if canOperationModule('positions') || canAccountingModule('positions');
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('labor_cost_contract_terms') || canAccountingModule('labor_cost_contract_terms');
    }

    match /payroll_runs/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('worker_payroll') || canAccountingModule('worker_payroll');
    }

    match /payroll_batches/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('worker_payroll') || canAccountingModule('worker_payroll');
    }

    match /office_payroll_runs/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('office_payroll') || canAccountingModule('office_payroll');
    }

    match /payment_export_batches/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('payment_export_batches') || canAccountingModule('payment_export_batches');
    }

    match /waves/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('waves');
    }

    match /mobilizations/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('mobilization');
    }

    match /daily_timesheets/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canOperationModule('timesheets') || canAccountingModule('timesheets');
    }

    match /payroll_periods/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('worker_payroll') || canAccountingModule('worker_payroll');
    }

    match /office_staff/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('office_staff') || canAccountingModule('office_staff');
    }

    match /exception_requests/{id} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('timesheets');
    }

    match /worker_wave_acceptances/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow create: if canOperationModule('assignments') || isClientOf(request.resource.data.customerId);
      allow update: if canOperationModule('assignments') || isClientOf(resource.data.customerId);
      allow delete: if canOperationModule('assignments');
    }

    // =========================
    // ACCOUNTING / STORE
    // =========================

    match /vendors/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('vendors');
    }

    match /purchases/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('purchases');
    }

    match /purchases/{purchaseId}/{document=**} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('purchases');
    }

    match /store_items/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /store_transactions/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /store_receipts/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /store_issue_slips/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /store_return_slips/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /store_writeoffs/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('store_inventory');
    }

    match /billing_notes/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canAccountingModule('billing_notes');
    }

    match /tax_invoices/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canAccountingModule('tax_invoices');
    }

    match /receipts/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canAccountingModule('receipts');
    }

    match /ap_bills/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('ap_bills');
    }

    match /accounts_receivable/{id} {
      allow read: if isInternalUser() || isClientOf(resource.data.customerId);
      allow write: if canAccountingModule('accounts_receivable');
    }

    match /accounts_payable/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('accounts_payable');
    }

    match /bank_accounts/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('bank_accounts');
    }

    match /cashbook_entries/{id} {
      allow read: if isInternalUser();
      allow write: if canAccountingModule('cashbook');
    }

    // =========================
    // SUBCOLLECTIONS FOR CLIENT VISIBILITY
    // =========================

    match /workers/{workerId}/{document=**} {
      allow read: if isInternalUser() || isClient();
      allow write: if canOperationModule('workers') || canAccountingModule('workers');
    }

    match /positions/{positionId}/{document=**} {
      allow read: if isInternalUser() || isClient();
      allow write: if canOperationModule('positions') || canAccountingModule('positions');
    }

    match /customers/{customerId}/{document=**} {
      allow read: if isInternalUser() || isClientOf(customerId);
      allow write: if canOperationModule('customers') || canAccountingModule('customers');
    }

    match /main_contracts/{contractId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/main_contracts/$(contractId)).data.customerId == userData().customerId
      );
      allow write: if canOperationModule('main_contracts') || canAccountingModule('main_contracts');
    }

    match /quotations/{quotationId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/quotations/$(quotationId)).data.customerId == userData().customerId
      );
      allow write: if canOperationModule('quotations') || canAccountingModule('quotations');
    }

    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)).data.customerId == userData().customerId
      );
      allow write: if canOperationModule('customer_pos') || canAccountingModule('customer_pos');
    }

    match /billing_notes/{billingNoteId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/billing_notes/$(billingNoteId)).data.customerId == userData().customerId
      );
      allow write: if canAccountingModule('billing_notes');
    }

    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId)).data.customerId == userData().customerId
      );
      allow write: if canAccountingModule('tax_invoices');
    }

    match /receipts/{receiptId}/{document=**} {
      allow read: if isInternalUser() || (
        isClient() &&
        get(/databases/$(database)/documents/receipts/$(receiptId)).data.customerId == userData().customerId
      );
      allow write: if canAccountingModule('receipts');
    }

    match /payroll_batches/{batchId}/{document=**} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('worker_payroll') || canAccountingModule('worker_payroll');
    }

    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if isInternalUser();
      allow write: if canOperationModule('office_payroll') || canAccountingModule('office_payroll');
    }

    // =========================
    // ADMIN ONLY
    // =========================

    match /number_sequences/{id} {
      allow read, write: if isAdmin();
    }

    match /permission_profiles/{id} {
      allow read, write: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /roles_system_admin/{id} {
      allow read, write: if isAdmin();
    }

    match /system/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/system/bootstrap);
      allow update, delete: if isAdmin();
    }

    // =========================
    // CLIENT PORTAL
    // =========================

    match /client_portal/{document=**} {
      allow read, write: if isAdmin() || isActiveClientUser();
    }

    // =========================
    // DEFAULT FALLBACK
    // =========================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
