rules_version = '2';
// NOTE: Keep comments ASCII-only; Firebase Console "Publish" can fail with unknown error if rules contain Thai/special Unicode (paste/encoding).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Basic identity (Set 1: users + permission_profiles rely on these helpers)
    // ---------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isSignedIn() && exists(userDocPath());
    }

    function userData() {
      return userExists() ? get(userDocPath()).data : null;
    }

    function isActiveUser() {
      let u = userData();
      return u != null
        && (!('isActive' in u) || u.isActive == true)
        && (!('approvalStatus' in u)
          || u.approvalStatus == 'ACTIVE'
          || u.approvalStatus == 'APPROVED'
          || u.approvalStatus == 'active');
    }

    // Optional user fields: missing keys do not block internal check (migration-safe).
    function isInternalUser() {
      let u = userData();
      return u != null
        && (!('userType' in u) || u.userType != 'customer_portal')
        && (!('accessGroup' in u) || u.accessGroup != 'client')
        && (!('department' in u) || u.department != 'client');
    }

    function isEligibleInternal() {
      return isSignedIn() && userExists() && isActiveUser() && isInternalUser();
    }

    function userCustomerId() {
      let u = userData();
      return u != null && ('customerId' in u) ? u.customerId : null;
    }

    // ---------------------------------------------------------------------
    // Simple role helpers
    // ---------------------------------------------------------------------
    /**
     * Business role for rules: users/{uid}.assignedRoleKey only (lowercase canonical; app normalizes on write).
     * Do not derive role from roleId, permissionProfileKey(s), or list order here.
     */
    function roleKey() {
      let u = userData();
      return u == null
        ? null
        : ('assignedRoleKey' in u && u.assignedRoleKey is string && u.assignedRoleKey.size() > 0
            ? u.assignedRoleKey
            : null);
    }

    // Scalar permissionProfileKey OR permissionProfileKeys list (align isSystemAdmin / profile binding in app).
    function userReferencesProfileDocId(profileId) {
      let u = userData();
      return u != null
        && (
          (('permissionProfileKey' in u) && u.permissionProfileKey == profileId)
          || (('permissionProfileKeys' in u)
            && u.permissionProfileKeys is list
            && profileId in u.permissionProfileKeys)
        );
    }

    // Client portal: userType + accessGroup + assignedRoleKey == client_user (no legacy role synonyms in rules).
    function isClientUser() {
      let u = userData();
      return u != null
        && isActiveUser()
        && u.userType == 'customer_portal'
        && ('accessGroup' in u) && u.accessGroup == 'client'
        && roleKey() == 'client_user';
    }

    function sameCustomerId(customerId) {
      return isClientUser() && userCustomerId() != null && userCustomerId() == customerId;
    }

    // departmentGroup field, else accessGroup; legacy singular "operation" coerces to "operations" (align permission-core).
    function departmentGroup() {
      let u = userData();
      let raw = u != null && ('departmentGroup' in u) ? u.departmentGroup
        : (u != null && ('accessGroup' in u) ? u.accessGroup : null);
      return raw == 'operation' ? 'operations' : raw;
    }

    function department() {
      let u = userData();
      let d = u != null && ('department' in u) ? u.department : null;
      return d == 'operation' ? 'operations' : d;
    }

    function isAdminUser() {
      return isEligibleInternal()
        && (
          roleKey() == 'system_admin'
          || departmentGroup() == 'admin'
          || department() == 'admin'
          || userReferencesProfileDocId('system_admin')
          || userReferencesProfileDocId('admin_admin')
        );
    }

    function isAccountingUser() {
      return isEligibleInternal()
        && (
          roleKey() == 'accounting_manager'
          || roleKey() == 'accounting_officer'
          || departmentGroup() == 'accounting'
          || department() == 'accounting'
        );
    }

    function isSalesUser() {
      return isEligibleInternal()
        && (
          roleKey() == 'sales_manager'
          || roleKey() == 'sales_officer'
          || department() == 'sales'
        );
    }

    function isSalesManager() {
      return isEligibleInternal()
        && (
          roleKey() == 'sales_manager'
          || userReferencesProfileDocId('sales_manager')
        );
    }

    // HR officer: workers/positions/worker_document_catalog + ops scheduling (waves/mobilizations/assignments) create/edit per ROLE_PERMISSION_MATRIX.
    function isHrOfficer() {
      return isEligibleInternal()
        && roleKey() != 'payroll_officer'
        && (
          roleKey() == 'hr_officer'
          || department() == 'hr'
          || userReferencesProfileDocId('hr_officer')
        );
    }

    // HR Manager (distinct from hr_officer); HR master + payroll visibility.
    function isHrManager() {
      return isEligibleInternal()
        && (
          roleKey() == 'hr_manager'
          || userReferencesProfileDocId('hr_manager')
        );
    }

    function isPayrollOfficer() {
      return isEligibleInternal()
        && roleKey() == 'payroll_officer';
    }

    function isStoreOfficer() {
      return isEligibleInternal()
        && (
          roleKey() == 'store_officer'
          || department() == 'store'
        );
    }

    function isOperationManager() {
      return isEligibleInternal()
        && (
          roleKey() == 'operations_manager'
          || userReferencesProfileDocId('operations_manager')
        );
    }

    function isOperationsOfficer() {
      return isEligibleInternal()
        && (
          roleKey() == 'operations_officer'
          || userReferencesProfileDocId('operations_officer')
        );
    }

    function isOperationsPillarStaff() {
      return isOperationManager() || isOperationsOfficer();
    }

    function internalRead() {
      return isEligibleInternal();
    }

    function internalReadNonStoreOfficer() {
      return internalRead() && !isStoreOfficer();
    }

    // ---------------------------------------------------------------------
    // Domain access model
    // ---------------------------------------------------------------------
    function canManageSystem() {
      return isAdminUser();
    }

    // Own permission matrix row; internal + client portal onSnapshot by doc id (exact profile doc id match only).
    function userMayReadOwnPermissionProfile(profileDocId) {
      let u = userData();
      let owns =
        u != null
        && (
          (('permissionProfileKey' in u) && u.permissionProfileKey == profileDocId)
          || (('permissionProfileKeys' in u)
            && u.permissionProfileKeys is list
            && profileDocId in u.permissionProfileKeys)
        );
      return owns && (isEligibleInternal() || isClientUser());
    }

    function canAccessSales() {
      return isAdminUser() || isSalesUser() || isOperationsPillarStaff();
    }

    function canAccessOperations() {
      return isAdminUser() || isOperationsPillarStaff() || isHrManager() || isHrOfficer();
    }

    function canAccessHR() {
      return isAdminUser() || isOperationsPillarStaff() || isHrManager() || isHrOfficer() || isPayrollOfficer();
    }

    function canAccessAccounting() {
      return isAdminUser() || isAccountingUser();
    }

    // ---------------------------------------------------------------------
    // Set 2 — Sales collections (align ROLE_PERMISSION_MATRIX rows)
    // ---------------------------------------------------------------------
    function isAccountingManager() {
      return isEligibleInternal()
        && (
          roleKey() == 'accounting_manager'
          || userReferencesProfileDocId('accounting_manager')
        );
    }

    function isAccountingOfficer() {
      return isEligibleInternal()
        && (
          roleKey() == 'accounting_officer'
          || userReferencesProfileDocId('accounting_officer')
        );
    }

    /** customers.view — excludes store_officer, accounting_officer (matrix P_NONE). */
    function canReadCustomers() {
      return isAdminUser()
        || (isEligibleInternal() && (
          canAccessSales()
          || isHrManager()
          || isHrOfficer()
          || isPayrollOfficer()
          || isAccountingManager()
        ));
    }

    /** customers create/edit — hr_officer/payroll_officer view-only on matrix. */
    function canWriteCustomers() {
      return isAdminUser()
        || canAccessSales()
        || isHrManager()
        || isAccountingManager();
    }

    /** quotations.view — includes accounting_officer (matrix P_VIEW). */
    function canReadQuotationsInternal() {
      return isAdminUser()
        || (isEligibleInternal() && (
          canAccessSales()
          || isHrManager()
          || isHrOfficer()
          || isPayrollOfficer()
          || isAccountingManager()
          || isAccountingOfficer()
        ));
    }

    /**
     * quotations write — sales_manager row has quotations P_NONE;
     * ops pillar + hr_manager + sales_officer (and other sales dept) keep write via isSalesUser edge cases.
     */
    function canWriteQuotations() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || (isSalesUser() && roleKey() != 'sales_manager');
    }

    /**
     * main_contracts, sales_contract_terms, rate_conditions, profit_estimates, purchase_orders (maps to customer_pos):
     * read like quotations; write excludes view-only HR/payroll/accounting_officer (matrix).
     */
    function canReadCommercialDocuments() {
      return canReadQuotationsInternal();
    }

    function canWriteCommercialDocuments() {
      return isAdminUser()
        || canAccessSales()
        || isHrManager()
        || isAccountingManager();
    }

    // ---------------------------------------------------------------------
    // Set 3 — Operations scheduling (waves, mobilizations, assignments, worker_wave_acceptances)
    // Matrix modules waves | assignments | mobilization (ROLE_PERMISSION_MATRIX in permissions.ts).
    // store_officer P_NONE; payroll_officer / accounting_officer view-only; sales_manager edit but no delete.
    // ---------------------------------------------------------------------
    function canReadOpsScheduling() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isSalesUser()
            || isOperationsPillarStaff()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    function canCreateOpsScheduling() {
      return isAdminUser()
        || isSalesUser()
        || isOperationsPillarStaff()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    function canEditOpsScheduling() {
      return isAdminUser()
        || isSalesUser()
        || isOperationsPillarStaff()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    /** delete: operations_manager, hr_manager, accounting_manager (+ admin); not officer/sales P_VCE rows. */
    function canDeleteOpsScheduling() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    // ---------------------------------------------------------------------
    // Set 4 — HR master (workers, positions, labor_cost_contract_terms, office_staff, worker_document_catalog)
    // ROLE_PERMISSION_MATRIX rows in src/lib/permissions.ts (incl. sales_manager workers view-only, store_officer workers none).
    // ---------------------------------------------------------------------
    function canReadWorkers() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isSalesManager()
            || isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    function canCreateWorkers() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    function canEditWorkers() {
      return canCreateWorkers();
    }

    function canDeleteWorkers() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isHrOfficer();
    }

    function canReadPositions() {
      return isAdminUser()
        || (isEligibleInternal() && (
          isStoreOfficer()
          || isOperationManager()
          || isOperationsOfficer()
          || isHrManager()
          || isHrOfficer()
          || isPayrollOfficer()
          || isSalesManager()
          || isAccountingManager()
        ));
    }

    function canCreatePositions() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isSalesManager()
        || isAccountingManager();
    }

    function canEditPositions() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    function canDeletePositions() {
      return isAdminUser() || isOperationManager() || isHrManager();
    }

    function canReadLaborCostContractTerms() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isSalesManager()
            || isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    function canCreateLaborCostContractTerms() {
      return isAdminUser()
        || isSalesManager()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    function canEditLaborCostContractTerms() {
      return canCreateLaborCostContractTerms();
    }

    function canDeleteLaborCostContractTerms() {
      return isAdminUser()
        || isSalesManager()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    function canReadOfficeStaff() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer() && !isSalesManager()
          && (
            isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    function canCreateOfficeStaff() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isAccountingManager();
    }

    function canEditOfficeStaff() {
      return canCreateOfficeStaff();
    }

    function canDeleteOfficeStaff() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    /** worker_documents module; accounting_manager row has no key -> deny (matches getPermissions). */
    function canReadWorkerDocumentCatalog() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer() && !isSalesManager() && !isAccountingManager()
          && (
            isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingOfficer()
          )
        );
    }

    function canCreateWorkerDocumentCatalog() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer();
    }

    function canEditWorkerDocumentCatalog() {
      return canCreateWorkerDocumentCatalog();
    }

    function canDeleteWorkerDocumentCatalog() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isHrOfficer();
    }

    // Prepare worker payroll (batches/runs/periods): matrix + permission-payroll-matrix — includes HR officer/manager (not sales_manager).
    function canPreparePayroll() {
      return isAdminUser()
        || isOperationsPillarStaff()
        || isPayrollOfficer()
        || isHrManager()
        || isHrOfficer();
    }

    // Approve / delete payroll cycles: admin, operations_manager, hr_manager (not operations_officer).
    function canApprovePayroll() {
      return isAdminUser() || isOperationManager() || isHrManager();
    }

    function canManagePayrollFinancial() {
      return isAdminUser() || isAccountingUser();
    }

    // ---------------------------------------------------------------------
    // Set 5 — Payroll / timesheets / exports (ROLE_PERMISSION_MATRIX + permission-payroll-matrix)
    // ---------------------------------------------------------------------
    /** Worker payroll_runs, payroll_batches, payroll_periods, correction requests — not office payroll or bank export. */
    function canReadWorkerPayrollStack() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isSalesManager()
            || isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    /** office_payroll_runs: matrix P_NONE for sales_manager + operations pillar. */
    function canReadOfficePayrollRuns() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    /** payment_export_batches: matrix P_NONE for sales_manager. accounting_officer: view-only in matrix. */
    function canReadPaymentExportBatches() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    function canReadPayrollPolicies() {
      return canReadWorkerPayrollStack()
        || canReadOfficePayrollRuns()
        || canReadPaymentExportBatches();
    }

    /** Create/update office payroll runs when unlocked — not operations_manager (matrix office_payroll P_NONE for ops pillar). */
    function canPrepareOfficePayrollRunDoc() {
      return isAdminUser()
        || isHrManager()
        || isHrOfficer()
        || isPayrollOfficer();
    }

    /** Internal read daily_timesheets — payroll matrix: payroll_officer view-only but may list; store_officer excluded. */
    function canReadTimesheetsInternal() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer()
          && (
            isSalesManager()
            || isOperationManager()
            || isOperationsOfficer()
            || isHrManager()
            || isHrOfficer()
            || isPayrollOfficer()
            || isAccountingManager()
            || isAccountingOfficer()
          )
        );
    }

    /** Timesheet create/edit: matrix denies payroll_officer + accounting on non-view actions. */
    function canCreateDailyTimesheet() {
      return isAdminUser()
        || isSalesManager()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer();
    }

    function canUpdateDailyTimesheet() {
      return canCreateDailyTimesheet();
    }

    /** payment_export_batches write — exclude accounting_officer (matrix P_VIEW). */
    function canWritePaymentExportBatches() {
      return isAdminUser()
        || isAccountingManager()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isPayrollOfficer();
    }

    // ---------------------------------------------------------------------
    // Set 6 — Store & procurement (vendors, purchases, store_*)
    // ROLE_PERMISSION_MATRIX: vendors | purchases | store_inventory.
    // ---------------------------------------------------------------------
    function canReadVendors() {
      return isAdminUser()
        || (isEligibleInternal() && (
          isSalesManager()
          || isOperationManager()
          || isOperationsOfficer()
          || isHrManager()
          || isStoreOfficer()
          || isAccountingManager()
        ));
    }

    function canCreateVendors() {
      return isAdminUser()
        || isSalesManager()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isStoreOfficer()
        || isAccountingManager();
    }

    /** sales_manager: create vendor only (matrix edit false). */
    function canEditVendors() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isStoreOfficer()
        || isAccountingManager();
    }

    function canDeleteVendors() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    /** purchases: matrix P_NONE for sales_manager, payroll_officer; accounting_officer view-only. */
    function canReadPurchases() {
      return isAdminUser()
        || (isEligibleInternal() && (
          isOperationManager()
          || isOperationsOfficer()
          || isHrManager()
          || isHrOfficer()
          || isStoreOfficer()
          || isAccountingManager()
          || isAccountingOfficer()
        ));
    }

    function canCreatePurchases() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isStoreOfficer()
        || isAccountingManager();
    }

    function canEditPurchases() {
      return canCreatePurchases();
    }

    function canDeletePurchases() {
      return isAdminUser()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    /** store_items, store_transactions, receipts, issue/return/writeoff — matrix store_inventory. */
    function canReadStoreInventory() {
      return isAdminUser()
        || (isEligibleInternal() && (
          isOperationManager()
          || isOperationsOfficer()
          || isHrManager()
          || isHrOfficer()
          || isStoreOfficer()
          || isAccountingManager()
          || isAccountingOfficer()
        ));
    }

    function canCreateStoreInventory() {
      return isAdminUser()
        || isOperationManager()
        || isOperationsOfficer()
        || isHrManager()
        || isHrOfficer()
        || isStoreOfficer()
        || isAccountingManager();
    }

    function canEditStoreInventory() {
      return canCreateStoreInventory();
    }

    function canDeleteStoreInventory() {
      return isAdminUser()
        || isStoreOfficer()
        || isOperationManager()
        || isHrManager()
        || isAccountingManager();
    }

    // ---------------------------------------------------------------------
    // Set 7 — Accounting (billing_notes, tax_invoices, receipts, AR/AP, bank, cashbook)
    // ROLE_PERMISSION_MATRIX: ops/sales/HR/payroll rows P_NONE or omit accounting modules; store_officer excluded from read.
    // Read: isAccountingUser (+ admin), not store_officer. Write: accounting staff except officer (manager + legacy dept accounting).
    // ---------------------------------------------------------------------
    function canReadAccountingInternal() {
      return isAdminUser()
        || (isEligibleInternal() && !isStoreOfficer() && isAccountingUser());
    }

    /** Create/update/delete accounting docs — accounting_officer matrix view-only; manager + non-officer accounting dept. */
    function canWriteAccountingDocs() {
      return isAdminUser()
        || (isAccountingUser() && !isAccountingOfficer());
    }

    function payrollBatchLocked(data) {
      return data.status in ['LOCKED', 'PAID'];
    }

    function officePayrollRunLocked(data) {
      return data.status in ['FINANCE_APPROVED', 'PAID', 'LOCKED'];
    }

    function dailyTimesheetLocked(data) {
      return data.status in ['LOCKED', 'CLIENT_APPROVED', 'VERIFIED_PAPER'];
    }

    function managerOnlyPayrollStatus(status) {
      return status in ['HR_APPROVED', 'FINANCE_PREPARED', 'FINANCE_APPROVED', 'PAID', 'LOCKED'];
    }

    function payrollUpdateAllowedForPreparer() {
      let nextStatus = 'status' in request.resource.data ? request.resource.data.status : null;
      return nextStatus == null || !managerOnlyPayrollStatus(nextStatus);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function selfRegistrationUserCreateValid(uid) {
      let d = request.resource.data;
      return d.approvalStatus == 'PENDING'
        && d.isActive == false
        && d.userType == 'internal'
        && !d.keys().hasAny([
          'accessGroup', 'departmentGroup', 'assignedRoleKey', 'assignedRoleKeys',
          'permissionProfileKey', 'permissionProfileKeys', 'accessLevel', 'allowedModules',
          'portalRole', 'customerId'
        ])
        && !('roleId' in d)
        && d.roleIds is list
        && d.roleIds.size() == 0
        && d.id == uid;
    }

    function isModifyingSecurityFields() {
      let protectedFields = [
        'userType', 'accessGroup', 'accessLevel', 'departmentGroup', 'allowedModules',
        'customerId', 'portalRole', 'isActive', 'approvalStatus', 'mustResetPassword',
        'roleId', 'roleIds', 'assignedRoleKey', 'assignedRoleKeys',
        'permissionProfileKey', 'permissionProfileKeys',
        'department', 'level', 'dataAccess'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }

    // ---------------------------------------------------------------------
    // USERS (Set 1: list/get/update rules; self-reg create shape above)
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow get: if canManageSystem() || isOwner(userId);
      allow list: if canManageSystem();
      allow create: if canManageSystem() || (isOwner(userId) && selfRegistrationUserCreateValid(userId));
      allow update: if canManageSystem() || (isOwner(userId) && !isModifyingSecurityFields());
      allow delete: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // SALES (Set 2: ROLE_PERMISSION_MATRIX — not blanket internalRead)
    // ---------------------------------------------------------------------
    match /customers/{id} {
      allow read: if canReadCustomers() || sameCustomerId(id);
      allow write: if canWriteCustomers();
    }

    match /quotations/{id} {
      allow read: if canReadQuotationsInternal() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteQuotations();
    }

    match /main_contracts/{id} {
      allow read: if canReadCommercialDocuments();
      allow write: if canWriteCommercialDocuments();
    }

    match /sales_contract_terms/{id} {
      allow read: if canReadCommercialDocuments();
      allow write: if canWriteCommercialDocuments();
    }

    match /purchase_orders/{id} {
      allow read: if canReadCommercialDocuments() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteCommercialDocuments();
    }

    match /rate_conditions/{id} {
      allow read: if canReadCommercialDocuments();
      allow write: if canWriteCommercialDocuments();
    }

    match /profit_estimates/{id} {
      allow read: if canReadCommercialDocuments();
      allow write: if canWriteCommercialDocuments();
    }

    // ---------------------------------------------------------------------
    // OPERATIONS scheduling (Set 3: matrix — not blanket internalRead)
    // ---------------------------------------------------------------------
    match /waves/{id} {
      allow read: if canReadOpsScheduling() || sameCustomerId(resource.data.customerId);
      allow create: if canCreateOpsScheduling();
      allow update: if canEditOpsScheduling();
      allow delete: if canDeleteOpsScheduling();
    }

    match /mobilizations/{id} {
      allow read: if canReadOpsScheduling() || sameCustomerId(resource.data.customerId);
      allow create: if canCreateOpsScheduling();
      allow update: if canEditOpsScheduling();
      allow delete: if canDeleteOpsScheduling();
    }

    match /assignments/{id} {
      allow read: if canReadOpsScheduling() || sameCustomerId(resource.data.customerId);
      allow create: if canCreateOpsScheduling();
      allow update: if canEditOpsScheduling();
      allow delete: if canDeleteOpsScheduling();
    }

    match /worker_wave_acceptances/{id} {
      allow read: if canReadOpsScheduling() || sameCustomerId(resource.data.customerId);
      allow create: if canCreateOpsScheduling();
      allow update: if canEditOpsScheduling();
      allow delete: if canDeleteOpsScheduling();
    }

    // ---------------------------------------------------------------------
    // HR / PAYROLL
    // ---------------------------------------------------------------------
    match /workers/{id} {
      allow read: if canReadWorkers() || isClientUser();
      allow create: if canCreateWorkers();
      allow update: if canEditWorkers();
      allow delete: if canDeleteWorkers();
    }

    match /positions/{id} {
      allow read: if canReadPositions() || isClientUser();
      allow create: if canCreatePositions();
      allow update: if canEditPositions();
      allow delete: if canDeletePositions();
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if canReadLaborCostContractTerms();
      allow create: if canCreateLaborCostContractTerms();
      allow update: if canEditLaborCostContractTerms();
      allow delete: if canDeleteLaborCostContractTerms();
    }

    match /office_staff/{id} {
      allow read: if canReadOfficeStaff();
      allow create: if canCreateOfficeStaff();
      allow update: if canEditOfficeStaff();
      allow delete: if canDeleteOfficeStaff();
    }

    match /worker_document_catalog/{id} {
      allow read: if canReadWorkerDocumentCatalog();
      allow create: if canCreateWorkerDocumentCatalog();
      allow update: if canEditWorkerDocumentCatalog();
      allow delete: if canDeleteWorkerDocumentCatalog();
    }

    // --- Set 5: payroll / timesheets / exports (not blanket internalRead / canViewPayroll)
    match /payroll_runs/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow create: if canPreparePayroll();
      allow update: if canApprovePayroll() || (canPreparePayroll() && payrollUpdateAllowedForPreparer());
      allow delete: if canApprovePayroll();
    }

    match /payroll_batches/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow create: if canPreparePayroll();
      allow update: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(resource.data) && payrollUpdateAllowedForPreparer())
        || canManagePayrollFinancial();
      allow delete: if canApprovePayroll();
    }

    match /payroll_periods/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow write: if canPreparePayroll() || canApprovePayroll();
    }

    match /payroll_policies/{id} {
      allow read: if canReadPayrollPolicies();
      // permission-payroll-matrix: policy edit denied for hr_manager / operations personas — system admin only.
      allow write: if canManageSystem();
    }

    match /payroll_correction_requests/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow create, update: if canPreparePayroll() || canApprovePayroll() || canManagePayrollFinancial();
      allow delete: if canManageSystem();
    }

    match /office_payroll_runs/{id} {
      allow read: if canReadOfficePayrollRuns();
      allow create: if canPrepareOfficePayrollRunDoc();
      allow update: if canApprovePayroll()
        || (canPrepareOfficePayrollRunDoc()
          && !officePayrollRunLocked(resource.data)
          && payrollUpdateAllowedForPreparer())
        || canManagePayrollFinancial();
      // matrix: operations pillar has no office_payroll — do not let operations_manager delete office runs.
      allow delete: if isAdminUser() || isHrManager();
    }

    match /executive_payroll_runs/{id} {
      allow read, write: if canManagePayrollFinancial() || canManageSystem();
    }

    match /payment_export_batches/{id} {
      allow read: if canReadPaymentExportBatches();
      allow write: if canWritePaymentExportBatches();
    }

    match /daily_timesheets/{id} {
      allow read: if canReadTimesheetsInternal() || sameCustomerId(resource.data.customerId);
      allow create: if canCreateDailyTimesheet();
      allow update: if canUpdateDailyTimesheet() && !dailyTimesheetLocked(resource.data);
      allow delete: if canApprovePayroll();
    }

    match /exception_requests/{id} {
      allow read: if canReadTimesheetsInternal();
      allow write: if canAccessHR();
    }

    // Payroll prep reads profiles (payroll-service); HR may maintain — was unreachable under /{document=**} admin-only.
    match /worker_payment_profiles/{id} {
      allow read: if canReadWorkerPayrollStack();
      allow create, update: if canPreparePayroll() || canManagePayrollFinancial();
      allow delete: if canApprovePayroll() || canManageSystem();
    }

    // ---------------------------------------------------------------------
    // STORE (Set 6: ROLE_PERMISSION_MATRIX — granular vendors / purchases / store_inventory helpers)
    // ---------------------------------------------------------------------
    match /vendors/{id} {
      allow read: if canReadVendors();
      allow create: if canCreateVendors();
      allow update: if canEditVendors();
      allow delete: if canDeleteVendors();
    }

    match /purchases/{purchaseId} {
      allow read: if canReadPurchases();
      allow create: if canCreatePurchases();
      allow update: if canEditPurchases();
      allow delete: if canDeletePurchases();
    }

    match /purchases/{purchaseId}/{document=**} {
      allow read: if canReadPurchases();
      allow create: if canCreatePurchases();
      allow update: if canEditPurchases();
      allow delete: if canDeletePurchases();
    }

    match /store_items/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_transactions/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_receipts/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_issue_slips/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_return_slips/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_writeoffs/{id} {
      allow read: if canReadStoreInventory();
      allow create: if canCreateStoreInventory();
      allow update: if canEditStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    // Line items under slips (receive/issue/return/writeoff) — app writes subcollection "items"; was admin-only via catch-all.
    match /store_receipts/{receiptId}/{document=**} {
      allow read: if canReadStoreInventory();
      allow create, update: if canCreateStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_issue_slips/{slipId}/{document=**} {
      allow read: if canReadStoreInventory();
      allow create, update: if canCreateStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_return_slips/{returnId}/{document=**} {
      allow read: if canReadStoreInventory();
      allow create, update: if canCreateStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    match /store_writeoffs/{writeoffId}/{document=**} {
      allow read: if canReadStoreInventory();
      allow create, update: if canCreateStoreInventory();
      allow delete: if canDeleteStoreInventory();
    }

    // ---------------------------------------------------------------------
    // ACCOUNTING (Set 7: not internalReadNonStoreOfficer / not all isAccountingUser write)
    // ---------------------------------------------------------------------
    match /billing_notes/{id} {
      allow read: if canReadAccountingInternal() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteAccountingDocs();
    }

    match /tax_invoices/{id} {
      allow read: if canReadAccountingInternal() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteAccountingDocs();
    }

    match /receipts/{id} {
      allow read: if canReadAccountingInternal() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteAccountingDocs();
    }

    match /receipts/{id}/allocations/{allocId} {
      allow read: if canReadAccountingInternal()
        || (isClientUser()
            && get(/databases/$(database)/documents/receipts/$(id)).data.customerId == userCustomerId());
      allow write: if canWriteAccountingDocs();
    }

    match /ap_bills/{id} {
      allow read: if canReadAccountingInternal();
      allow write: if canWriteAccountingDocs();
    }

    match /accounts_receivable/{id} {
      allow read: if canReadAccountingInternal() || sameCustomerId(resource.data.customerId);
      allow write: if canWriteAccountingDocs();
    }

    match /accounts_payable/{id} {
      allow read: if canReadAccountingInternal();
      allow write: if canWriteAccountingDocs();
    }

    match /bank_accounts/{id} {
      allow read: if canReadAccountingInternal();
      allow write: if canWriteAccountingDocs();
    }

    match /cashbook_entries/{id} {
      allow read: if canReadAccountingInternal();
      allow write: if canWriteAccountingDocs();
    }

    // ---------------------------------------------------------------------
    // SYSTEM
    // ---------------------------------------------------------------------
    match /number_sequences/{id} {
      allow read, write: if canManageSystem()
        || (canAccessSales() && id in ['customer', 'customer_po', 'quotation', 'sales_term'])
        || (canAccessOperations() && id in ['wave', 'assignment'])
        || (id == 'worker' && canCreateWorkers())
        || (id == 'office_staff' && canCreateOfficeStaff())
        || (id == 'position' && canCreatePositions())
        || (id == 'cost_term' && canCreateLaborCostContractTerms())
        || (canAccessHR() && id in ['payroll_run', 'office_payroll_run'])
        || (canWriteAccountingDocs()
          && id in ['billing_note', 'tax_invoice', 'receipt', 'ap_bill', 'ar', 'ap', 'cashbook_entry', 'bank_account'])
        || (canManagePayrollFinancial() && id == 'executive_payroll_run')
        || (id == 'vendor' && canCreateVendors())
        || (id == 'purchase' && canCreatePurchases())
        || (id in ['store_receive', 'store_issue', 'store_return', 'store_writeoff'] && canCreateStoreInventory())
        || (id == 'main_contract' && canWriteCommercialDocuments());
    }

    // permission_profiles (Set 1: admin CRUD + own-row read for matrix onSnapshot)
    match /permission_profiles/{id} {
      allow get: if canManageSystem() || userMayReadOwnPermissionProfile(id);
      allow list: if canManageSystem();
      allow write: if canManageSystem();
    }

    match /roles_system_admin/{id} {
      allow read, write: if canManageSystem();
    }

    match /system/{docId} {
      // Known docs: bootstrap (setup), company_profile (quotations PDF/header), drug_test_panel (worker drug UI).
      allow read: if canManageSystem()
        || (docId == 'bootstrap' && isSignedIn())
        || (docId == 'company_profile' && canReadQuotationsInternal())
        || (docId == 'drug_test_panel' && (canReadWorkers() || isClientUser()));
      allow create: if canManageSystem()
        || (docId == 'bootstrap' && isSignedIn()
            && !exists(/databases/$(database)/documents/system/bootstrap));
      allow update, delete: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // AUDIT / APPROVALS / CLIENT PORTAL
    // ---------------------------------------------------------------------
    match /audit_logs/{id} {
      allow read: if canManageSystem() || internalReadNonStoreOfficer();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /approvals/{id} {
      allow read: if internalRead() || isClientUser();
      allow write: if canAccessHR() || canAccessOperations() || canManageSystem();
    }

    match /client_portal/{document=**} {
      allow read: if canManageSystem() || isClientUser();
      allow write: if canManageSystem();
    }

    // ---------------------------------------------------------------------
    // SUBCOLLECTIONS
    // ---------------------------------------------------------------------
    match /workers/{workerId}/{document=**} {
      allow read: if canReadWorkers() || isClientUser();
      allow create: if canCreateWorkers();
      allow update, delete: if canEditWorkers();
    }

    match /positions/{positionId}/{document=**} {
      allow read: if canReadPositions() || isClientUser();
      allow create: if canCreatePositions();
      allow update, delete: if canEditPositions();
    }

    match /customers/{customerId}/{document=**} {
      allow read: if canReadCustomers() || sameCustomerId(customerId);
      allow write: if canWriteCustomers();
    }

    match /main_contracts/{contractId}/{document=**} {
      allow read: if canReadCommercialDocuments();
      allow write: if canWriteCommercialDocuments();
    }

    match /quotations/{quotationId}/{document=**} {
      allow read: if canReadQuotationsInternal()
        || (isClientUser()
            && get(/databases/$(database)/documents/quotations/$(quotationId)).data.customerId == userCustomerId());
      allow write: if canWriteQuotations();
    }

    match /purchase_orders/{purchaseOrderId}/{document=**} {
      allow read: if canReadCommercialDocuments()
        || (isClientUser()
            && get(/databases/$(database)/documents/purchase_orders/$(purchaseOrderId)).data.customerId == userCustomerId());
      allow write: if canWriteCommercialDocuments();
    }

    match /billing_notes/{billingNoteId}/{document=**} {
      allow read: if canReadAccountingInternal()
        || (isClientUser()
            && get(/databases/$(database)/documents/billing_notes/$(billingNoteId)).data.customerId == userCustomerId());
      allow write: if canWriteAccountingDocs();
    }

    match /tax_invoices/{taxInvoiceId}/{document=**} {
      allow read: if canReadAccountingInternal()
        || (isClientUser()
            && get(/databases/$(database)/documents/tax_invoices/$(taxInvoiceId)).data.customerId == userCustomerId());
      allow write: if canWriteAccountingDocs();
    }

    match /receipts/{receiptId}/{document=**} {
      allow read: if canReadAccountingInternal()
        || (isClientUser()
            && get(/databases/$(database)/documents/receipts/$(receiptId)).data.customerId == userCustomerId());
      allow write: if canWriteAccountingDocs();
    }

    match /payroll_batches/{batchId}/lines/{lineId} {
      allow read: if canReadWorkerPayrollStack();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(get(/databases/$(database)/documents/payroll_batches/$(batchId)).data))
        || canManagePayrollFinancial();
    }

    match /office_payroll_runs/{runId}/lines/{lineId} {
      allow read: if canReadOfficePayrollRuns();
      allow write: if canApprovePayroll()
        || (canPrepareOfficePayrollRunDoc()
          && !officePayrollRunLocked(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || canManagePayrollFinancial();
    }

    match /executive_payroll_runs/{runId}/lines/{lineId} {
      allow read, write: if canManagePayrollFinancial() || canManageSystem();
    }

    match /payroll_batches/{batchId}/{document=**} {
      allow read: if canReadWorkerPayrollStack();
      allow write: if canApprovePayroll()
        || (canPreparePayroll() && !payrollBatchLocked(get(/databases/$(database)/documents/payroll_batches/$(batchId)).data))
        || canManagePayrollFinancial();
    }

    match /office_payroll_runs/{runId}/{document=**} {
      allow read: if canReadOfficePayrollRuns();
      allow write: if canApprovePayroll()
        || (canPrepareOfficePayrollRunDoc()
          && !officePayrollRunLocked(get(/databases/$(database)/documents/office_payroll_runs/$(runId)).data))
        || canManagePayrollFinancial();
    }

    match /executive_payroll_runs/{runId}/{document=**} {
      allow read, write: if canManagePayrollFinancial() || canManageSystem();
    }

    // ---------------------------------------------------------------------
    // COLLECTION GROUPS (Set 9: align with commercial / payroll helpers; not blanket internalRead)
    // ---------------------------------------------------------------------
    // App: only purchase_orders/{poId}/po_lines (waves/assignments collectionGroup).
    match /{path=**}/po_lines/{lineId} {
      allow read: if path.matches('^purchase_orders/[^/]+$')
        && (
          canReadCommercialDocuments()
          || (isClientUser()
            && get(/databases/$(database)/documents/$(path)).data.customerId == userCustomerId())
        );
    }

    // App: only main_contracts/{id}/position_rates (no collectionGroup query today; rule for parity + future).
    match /{path=**}/position_rates/{rateId} {
      allow read: if path.matches('^main_contracts/[^/]+$') && canReadCommercialDocuments();
      allow write: if path.matches('^main_contracts/[^/]+$') && canWriteCommercialDocuments();
    }

    // Subcollections named "lines": payslip history uses collectionGroup("lines") on payroll + office (+ executive).
    // Other parents (quotations, billing_notes, purchases) use direct path rules above, not this group.
    match /{path=**}/lines/{lineId} {
      allow read: if (path.matches('^payroll_batches/[^/]+$') && canReadWorkerPayrollStack())
        || (path.matches('^office_payroll_runs/[^/]+$') && canReadOfficePayrollRuns())
        || (path.matches('^executive_payroll_runs/[^/]+$') && (canManagePayrollFinancial() || canManageSystem()));
    }

    // Fallback: new top-level or nested paths must add an explicit match — never widen without matrix review.
    match /{document=**} {
      allow read, write: if canManageSystem();
    }
  }
}

