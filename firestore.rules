rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Fetches the user document. */
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    /** Checks if the user has a specific role (supports legacy roleId and new roleIds array). */
    function hasRole(roleName) {
      let user = getUserData();
      return isSignedIn() && (
        user.roleId == roleName || 
        (user.roleIds != null && user.roleIds.hasAny([roleName]))
      );
    }

    function isHRStaff() {
      return hasRole('hr_manager') || hasRole('hr_officer') || hasRole('system_admin');
    }

    function isStoreStaff() {
      return hasRole('store_officer') || hasRole('system_admin');
    }

    function isOperationsStaff() {
      return hasRole('operations_officer') || hasRole('system_admin');
    }

    function isFinanceStaff() {
      return hasRole('finance_officer') || hasRole('system_admin');
    }

    function isSalesStaff() {
      return hasRole('sales_officer') || hasRole('system_admin');
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isHRStaff();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || hasRole('system_admin');
      allow delete: if hasRole('system_admin');
    }

    match /roles/{roleId} {
      allow get, list: if isSignedIn();
      allow write: if hasRole('system_admin');
    }

    match /positions/{positionId} {
      allow get, list: if isSignedIn();
      allow write: if isHRStaff();

      match /certificate_requirements/{reqId} { allow get, list, write: if isHRStaff(); }
      match /ppe_requirements/{reqId} { allow get, list, write: if isHRStaff(); }
      match /tool_requirements/{reqId} { allow get, list, write: if isHRStaff(); }
    }

    match /mobilizations/{mobId} {
      allow get, list: if isSignedIn() && (isHRStaff() || isOperationsStaff() || isSalesStaff());
      allow write: if isSignedIn() && (isHRStaff() || isOperationsStaff());
    }

    match /waves/{waveId} {
      allow get, list: if isSignedIn();
      allow write: if isHRStaff() || isOperationsStaff();
    }

    match /customers/{customerId} {
      allow get, list: if isSignedIn();
      allow write: if isSalesStaff() || isFinanceStaff();
      
      match /contact_persons/{id} { allow get, list, write: if isSalesStaff(); }
    }

    match /main_contracts/{contractId} {
      allow get, list: if isSignedIn();
      allow write: if isSalesStaff() || isFinanceStaff();
      
      match /position_rates/{id} { allow get, list, write: if isSalesStaff() || isFinanceStaff(); }
    }

    match /purchase_orders/{poId} {
      allow get, list: if isSignedIn();
      allow write: if isSalesStaff() || isFinanceStaff() || isOperationsStaff();

      match /po_lines/{id} { allow get, list, write: if isSalesStaff() || isFinanceStaff() || isOperationsStaff(); }
    }

    // Collection Group rule for PO Lines (used in /waves list)
    match /{path=**}/po_lines/{id} {
      allow read: if isSignedIn();
      allow write: if isSalesStaff() || isFinanceStaff() || isOperationsStaff();
    }

    match /workers/{workerId} {
      allow get, list: if isHRStaff() || isOperationsStaff();
      allow write: if isHRStaff();

      match /certificates/{id} { allow get, list, write: if isHRStaff(); }
      match /medical_records/{id} { allow get, list, write: if isHRStaff(); }
      match /drug_tests/{id} { allow get, list, write: if isHRStaff(); }
      match /documents/{id} { allow get, list, write: if isHRStaff(); }
    }

    match /vendors/{vendorId} {
      allow get, list: if isSignedIn();
      allow write: if isStoreStaff() || isFinanceStaff() || isOperationsStaff();
    }

    match /purchases/{purchaseId} {
      allow get, list: if isSignedIn() && (isStoreStaff() || isOperationsStaff() || isFinanceStaff());
      allow write: if isStoreStaff() || isOperationsStaff();
      
      match /lines/{lineId} {
        allow get, list: if isSignedIn() && (isStoreStaff() || isOperationsStaff() || isFinanceStaff());
        allow write: if isStoreStaff() || isOperationsStaff();
      }
    }

    match /ap_bills/{billId} {
      allow get, list: if isFinanceStaff() || isStoreStaff();
      allow write: if isFinanceStaff();
    }

    match /store_items/{itemId} {
      allow get, list: if isSignedIn();
      allow write: if isStoreStaff();
    }

    match /store_transactions/{id} {
      allow get, list: if isSignedIn();
      allow create: if isStoreStaff();
    }

    match /billing_notes/{id} {
      allow get, list: if isFinanceStaff() || isSalesStaff();
      allow write: if isFinanceStaff() || isSalesStaff();
      match /lines/{lineId} { allow get, list, write: if isFinanceStaff() || isSalesStaff(); }
    }

    match /tax_invoices/{id} {
      allow get, list, write: if isFinanceStaff();
    }

    match /receipts/{id} {
      allow get, list, write: if isFinanceStaff();
      match /allocations/{allocId} { allow get, list, write: if isFinanceStaff(); }
    }

    match /bank_accounts/{id} {
      allow get, list, write: if isFinanceStaff();
    }

    match /cashbook_entries/{id} {
      allow get, list, write: if isFinanceStaff();
    }

    match /accounts_receivable/{id} {
      allow get, list, write: if isFinanceStaff();
    }

    match /accounts_payable/{id} {
      allow get, list, write: if isFinanceStaff();
    }

    match /audit_logs/{auditLogId} {
      allow create: if isSignedIn();
      allow get, list: if hasRole('system_admin');
    }
  }
}