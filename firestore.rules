
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Safely fetches the user document if it exists. */
    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    /** Checks if the user has a specific role. */
    function hasRole(roleName) {
      let user = getUserData();
      return isSignedIn() && user != null && (
        user.roleId == roleName || 
        (user.roleIds != null && user.roleIds.hasAny([roleName])) ||
        user.assignedRoleKey == roleName
      );
    }

    function isHRStaff() {
      return hasRole('hr_manager') || hasRole('hr_officer') || hasRole('system_admin');
    }

    function isOperationsStaff() {
      return hasRole('operations_officer') || hasRole('operations_manager') || hasRole('system_admin');
    }

    function isFinanceStaff() {
      return hasRole('accounting_manager') || hasRole('accounting_officer') || hasRole('finance_officer') || hasRole('system_admin');
    }

    function isSalesStaff() {
      return hasRole('sales_officer') || hasRole('sales_manager') || hasRole('system_admin');
    }

    function isStoreStaff() {
      return hasRole('store_officer') || hasRole('system_admin');
    }

    function isInternalStaff() {
      return isHRStaff() || isOperationsStaff() || isFinanceStaff() || isSalesStaff() || isStoreStaff();
    }

    function isClient() {
      return hasRole('client_approver') || hasRole('client_viewer') || hasRole('client') || hasRole('client_user');
    }

    function isClientOf(cid) {
      return isClient() && getUserData().customerId == cid;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isInternalStaff();
      allow create: if isOwner(userId) || hasRole('system_admin');
      allow update: if isOwner(userId) || hasRole('system_admin');
      allow delete: if hasRole('system_admin');
    }

    // Daily Activity Tracking
    match /daily_timesheets/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow create: if isOperationsStaff() || isHRStaff();
      allow update: if isOperationsStaff() || isHRStaff() || (isClientOf(resource.data.customerId) && hasRole('client_approver'));
      allow delete: if hasRole('system_admin');
    }

    // Payroll Periods
    match /payroll_periods/{id} {
      allow read: if isInternalStaff();
      allow write: if isHRStaff() || isFinanceStaff();
    }

    // Payroll Batches & Lines (Internal Financials)
    match /payroll_batches/{id} {
      allow read: if isHRStaff() || isFinanceStaff();
      allow write: if isHRStaff() || isFinanceStaff();
    }

    match /payroll_batches/{id}/lines/{lineId} {
      allow read: if isHRStaff() || isFinanceStaff();
      allow write: if isHRStaff() || isFinanceStaff();
    }

    // Worker Payment Profiles (Sensitive Bank Data)
    match /worker_payment_profiles/{id} {
      allow read: if isHRStaff() || isFinanceStaff();
      allow write: if isHRStaff();
    }

    // Payment Export Batches
    match /payment_export_batches/{id} {
      allow read: if isHRStaff() || isFinanceStaff();
      allow write: if isFinanceStaff() || hasRole('accounting_manager');
    }

    // Centralized Numbering System
    match /number_sequences/{id} {
      allow get: if isSignedIn();
      allow list: if isInternalStaff();
      allow create, update: if isInternalStaff();
      allow delete: if hasRole('system_admin');
    }

    // Audit Trail (Immutable once created)
    match /audit_logs/{id} {
      allow get: if isInternalStaff();
      allow list: if hasRole('system_admin');
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // Commercial & Sales
    match /customers/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff();
    }

    match /quotations/{id} {
      allow get, list: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow create, update: if isSalesStaff();
      allow delete: if hasRole('system_admin');
    }

    match /sales_contract_terms/{id} {
      allow read: if isSalesStaff() || isFinanceStaff();
      allow write: if isSalesStaff();
    }

    match /labor_cost_contract_terms/{id} {
      allow read: if isSalesStaff() || isHRStaff() || isFinanceStaff();
      allow write: if isSalesStaff() || isHRStaff();
    }

    match /rate_conditions/{id} {
      allow read: if isInternalStaff();
      allow write: if isSalesStaff() || isHRStaff() || isFinanceStaff();
    }

    match /main_contracts/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isSalesStaff();
    }

    match /purchase_orders/{poId} {
      allow get, list: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow write: if isSalesStaff() || isFinanceStaff();
    }
    
    match /purchase_orders/{poId}/po_lines/{lineId} {
      allow read: if isInternalStaff() || isClientOf(get(/databases/$(database)/documents/purchase_orders/$(poId)).data.customerId);
      allow write: if isInternalStaff();
    }

    // Operations & Mobilization
    match /waves/{id} {
      allow read: if isInternalStaff();
      allow write: if isOperationsStaff();
    }

    match /mobilizations/{id} {
      allow get, list: if isInternalStaff();
      allow write: if isHRStaff() || isOperationsStaff();
    }

    match /workers/{workerId} {
      allow get: if isSignedIn();
      allow list: if isInternalStaff();
      allow write: if isHRStaff();
    }

    match /positions/{id} {
      allow read: if isInternalStaff();
      allow write: if isHRStaff();
    }

    // Client-side Hiring/Mobilization Approvals
    match /worker_wave_acceptances/{id} {
      allow read: if isInternalStaff() || isClientOf(resource.data.customerId);
      allow create: if isOperationsStaff();
      allow update: if isOperationsStaff() || (isClientOf(resource.data.customerId) && hasRole('client_approver'));
      allow delete: if hasRole('system_admin');
    }

    // Store & Inventory
    match /store_items/{id} {
      allow read: if isInternalStaff();
      allow write: if isStoreStaff();
    }

    match /store_transactions/{id} {
      allow read: if isInternalStaff();
      allow create: if isStoreStaff() || isOperationsStaff();
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if hasRole('system_admin');
    }
  }
}
