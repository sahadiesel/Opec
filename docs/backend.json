
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a staff user with access to the application, distinct from workers. Authentication data is managed externally by Firebase Auth.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PurchaseOrderProfitSnapshot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchaseOrderProfitSnapshot",
      "type": "object",
      "description": "Commercial snapshot of estimated profitability for a PO or Wave within a specific period.",
      "properties": {
        "id": { "type": "string" },
        "purchaseOrderId": { "type": "string" },
        "waveId": { "type": "string" },
        "periodStartDate": { "type": "string", "format": "date" },
        "periodEndDate": { "type": "string", "format": "date" },
        "estimatedRevenue": { "type": "number" },
        "estimatedLaborCost": { "type": "number" },
        "estimatedGrossProfit": { "type": "number" },
        "estimatedGrossMarginPercent": { "type": "number" },
        "calculationBasisSummary": { "type": "string" },
        "generatedAt": { "type": "number" },
        "generatedBy": { "type": "string" }
      },
      "required": ["id", "purchaseOrderId", "periodStartDate", "periodEndDate", "estimatedRevenue", "estimatedLaborCost", "generatedAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/po_profit_snapshots/{snapshotId}",
        "definition": {
          "entityName": "PurchaseOrderProfitSnapshot",
          "schema": { "$ref": "#/backend/entities/PurchaseOrderProfitSnapshot" },
          "description": "Stores estimated profitability analyses for POs and Waves.",
          "params": [{ "name": "snapshotId", "description": "Unique ID of the snapshot." }]
        }
      }
    ]
  }
}
