{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a staff user with access to the application, distinct from workers. Authentication data is managed externally by Firebase Auth.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PurchaseOrderProfitSnapshot": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "PurchaseOrderProfitSnapshot",
      "type": "object",
      "description": "Commercial snapshot of estimated profitability for a PO or Wave within a specific period.",
      "properties": {
        "id": { "type": "string" },
        "purchaseOrderId": { "type": "string" },
        "waveId": { "type": "string" },
        "periodStartDate": { "type": "string", "format": "date" },
        "periodEndDate": { "type": "string", "format": "date" },
        "estimatedRevenue": { "type": "number" },
        "estimatedLaborCost": { "type": "number" },
        "estimatedGrossProfit": { "type": "number" },
        "estimatedGrossMarginPercent": { "type": "number" },
        "calculationBasisSummary": { "type": "string" },
        "generatedAt": { "type": "number" },
        "generatedBy": { "type": "string" }
      },
      "required": ["id", "purchaseOrderId", "periodStartDate", "periodEndDate", "estimatedRevenue", "estimatedLaborCost", "generatedAt"]
    },
    "AuditLog": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AuditLog",
      "type": "object",
      "description": "Detailed record of high-risk actions and data changes for security and compliance.",
      "properties": {
        "id": { "type": "string" },
        "actionType": { "type": "string" },
        "entityType": { "type": "string" },
        "entityId": { "type": "string" },
        "actorUserId": { "type": "string" },
        "actorName": { "type": "string" },
        "eventAt": { "type": "number" }
      },
      "required": ["id", "actionType", "entityType", "entityId", "actorUserId", "eventAt"]
    },
    "NumberSequence": {
      "title": "NumberSequence",
      "type": "object",
      "description": "State tracking for sequential document numbering (e.g. BN-0001, INV-0001).",
      "properties": {
        "id": { "type": "string" },
        "prefix": { "type": "string" },
        "lastNumber": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/po_profit_snapshots/{snapshotId}",
        "definition": {
          "entityName": "PurchaseOrderProfitSnapshot",
          "schema": { "$ref": "#/backend/entities/PurchaseOrderProfitSnapshot" },
          "description": "Stores estimated profitability analyses for POs and Waves.",
          "params": [{ "name": "snapshotId", "description": "Unique ID of the snapshot." }]
        }
      },
      {
        "path": "/audit_logs/{logId}",
        "definition": {
          "entityName": "AuditLog",
          "schema": { "$ref": "#/backend/entities/AuditLog" },
          "description": "Central collection for system-wide audit trails.",
          "params": [{ "name": "logId", "description": "Unique ID of the audit entry." }]
        }
      },
      {
        "path": "/number_sequences/{seqId}",
        "definition": {
          "entityName": "NumberSequence",
          "schema": { "$ref": "#/backend/entities/NumberSequence" },
          "description": "State for automatic document numbering.",
          "params": [{ "name": "seqId", "description": "Key identifying the specific numbering sequence." }]
        }
      }
    ]
  }
}
