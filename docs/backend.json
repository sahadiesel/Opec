{
  "entities": {
    "User": {
      "title": "User",
      "description": "Staff user profiles and shared client accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string", "enum": ["system_admin", "finance_officer", "sales_officer", "hr_manager", "hr_officer", "payroll_officer", "store_officer", "client"] },
        "customerId": { "type": "string", "description": "Mandatory for shared client accounts" },
        "isSharedAccount": { "type": "boolean", "default": false },
        "isActive": { "type": "boolean" },
        "linkedProjectIds": { "type": "array", "items": { "type": "string" } },
        "nationalId": { "type": "string" },
        "address": { "type": "string" }
      }
    },
    "Worker": {
      "title": "Worker",
      "description": "Field personnel managed by HR",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "thaiNationalId": { "type": "string" },
        "workerStatus": { "type": "string", "enum": ["available", "assigned", "on_leave", "inactive"] },
        "readinessStatus": { "type": "string", "enum": ["READY", "MISSING_CERTIFICATE", "MEDICAL_EXPIRED", "DOCUMENT_MISSING"] },
        "currentPositionId": { "type": "string" },
        "secondaryPositionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "MainContract": {
      "title": "MainContract",
      "description": "Master Commercial Agreement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "pending"] }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/User",
      "description": "System staff and shared client accounts"
    },
    "/roles_system_admin/{userId}": {
      "schema": { "type": "object" },
      "description": "System Admin role assignment"
    },
    "/positions/{posId}": {
      "schema": { "type": "object" },
      "description": "Job positions master"
    },
    "/positions/{posId}/requirements/{reqId}": {
      "schema": { "type": "object" },
      "description": "Subcollection for position requirements"
    },
    "/workers/{workerId}": {
      "schema": "#/backend/entities/Worker",
      "description": "Worker master records"
    },
    "/workers/{workerId}/certificates/{certId}": {
      "schema": { "type": "object" },
      "description": "Worker certs subcollection"
    },
    "/workers/{workerId}/medical_records/{medId}": {
      "schema": { "type": "object" },
      "description": "Worker medical checks subcollection"
    },
    "/workers/{workerId}/drug_tests/{drugId}": {
      "schema": { "type": "object" },
      "description": "Worker drug tests subcollection"
    },
    "/customers/{customerId}": {
      "schema": { "type": "object" },
      "description": "Customer master records"
    },
    "/customers/{customerId}/contacts/{contactId}": {
      "schema": { "type": "object" },
      "description": "Customer contact persons subcollection"
    },
    "/customers/{customerId}/main_contracts/{contractId}": {
      "schema": "#/backend/entities/MainContract",
      "description": "Master agreements subcollection"
    },
    "/customers/{customerId}/main_contracts/{contractId}/position_rates/{rateId}": {
      "schema": { "type": "object" },
      "description": "Master rates subcollection"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}": {
      "schema": { "type": "object" },
      "description": "Purchase orders subcollection"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}": {
      "schema": { "type": "object" },
      "description": "PO lines with financial snapshots"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}/assignments/{asgnId}": {
      "schema": { "type": "object" },
      "description": "Worker assignments subcollection"
    },
    "/audit_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "Immutable system activity logs"
    }
  }
}
