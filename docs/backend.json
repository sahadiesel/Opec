{
  "entities": {
    "Customer": {
      "title": "Customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" },
        "address": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "ContactPerson": {
      "title": "ContactPerson",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "position": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" }
      }
    },
    "MainContract": {
      "title": "MainContract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "title": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "expired", "pending"] }
      }
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "title": { "type": "string" },
        "startDate": { "type": "number" },
        "endDate": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "closed", "pending"] }
      }
    },
    "POLine": {
      "title": "POLine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "positionId": { "type": "string" },
        "quantity": { "type": "number" },
        "sellRateSnapshot": { "type": "number" },
        "costBaselineSnapshot": { "type": "number" },
        "billingUnitSnapshot": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/customers/{customerId}": {
      "schema": "#/backend/entities/Customer",
      "description": "Master customer records"
    },
    "/customers/{customerId}/contacts/{contactId}": {
      "schema": "#/backend/entities/ContactPerson",
      "description": "Customer contact persons"
    },
    "/customers/{customerId}/main_contracts/{contractId}": {
      "schema": "#/backend/entities/MainContract",
      "description": "Commercial master agreements"
    },
    "/customers/{customerId}/main_contracts/{contractId}/position_rates/{rateId}": {
      "schema": { "type": "object" },
      "description": "Contract-specific position rates"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}": {
      "schema": "#/backend/entities/PurchaseOrder",
      "description": "Purchase orders under a contract"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}": {
      "schema": "#/backend/entities/POLine",
      "description": "Line items in a PO"
    }
  }
}
