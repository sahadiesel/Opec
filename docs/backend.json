{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Position": {
      "title": "Position",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Worker": {
      "title": "Worker",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "workerStatus": { "type": "string" },
        "readinessStatus": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" }
      }
    },
    "MainContract": {
      "title": "MainContract",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" }
      }
    },
    "POLine": {
      "title": "POLine",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quantity": { "type": "number" },
        "positionId": { "type": "string" }
      }
    },
    "Assignment": {
      "title": "Assignment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "status": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/User",
      "description": "Staff user profiles"
    },
    "/audit_logs/{logId}": {
      "schema": { "type": "object" },
      "description": "System audit logs"
    },
    "/positions/{posId}": {
      "schema": "#/backend/entities/Position",
      "description": "Standard job positions"
    },
    "/positions/{posId}/certificate_requirements/{reqId}": {
      "schema": { "type": "object" },
      "description": "Mandatory certificates for position"
    },
    "/workers/{workerId}": {
      "schema": "#/backend/entities/Worker",
      "description": "Field worker records"
    },
    "/workers/{workerId}/certificates/{certId}": {
      "schema": { "type": "object" },
      "description": "Worker held certificates"
    },
    "/workers/{workerId}/medical_records/{medId}": {
      "schema": { "type": "object" },
      "description": "Worker medical check history"
    },
    "/workers/{workerId}/drug_tests/{drugId}": {
      "schema": { "type": "object" },
      "description": "Worker drug test results"
    },
    "/customers/{customerId}": {
      "schema": "#/backend/entities/Customer",
      "description": "Customer master data"
    },
    "/customers/{customerId}/contacts/{contactId}": {
      "schema": { "type": "object" },
      "description": "Customer contact persons"
    },
    "/customers/{customerId}/main_contracts/{contractId}": {
      "schema": "#/backend/entities/MainContract",
      "description": "Master agreements"
    },
    "/customers/{customerId}/main_contracts/{contractId}/position_rates/{rateId}": {
      "schema": { "type": "object" },
      "description": "Agreed position rates"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}": {
      "schema": "#/backend/entities/PurchaseOrder",
      "description": "Commercial purchase orders"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}": {
      "schema": "#/backend/entities/POLine",
      "description": "PO line items with snapshots"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}/assignments/{asgnId}": {
      "schema": "#/backend/entities/Assignment",
      "description": "Worker assignments to PO lines"
    }
  }
}
