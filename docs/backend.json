{
  "entities": {
    "User": {
      "title": "User",
      "description": "Staff user profiles and shared client accounts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string", "enum": ["system_admin", "finance_officer", "sales_officer", "hr_manager", "hr_officer", "payroll_officer", "store_officer", "client"] },
        "customerId": { "type": "string" },
        "isSharedAccount": { "type": "boolean" },
        "isActive": { "type": "boolean" }
      }
    },
    "Position": {
      "title": "Position",
      "description": "Job positions master",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Worker": {
      "title": "Worker",
      "description": "Field personnel managed by HR",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "thaiNationalId": { "type": "string" },
        "workerStatus": { "type": "string" },
        "readinessStatus": { "type": "string" }
      }
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer master records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "taxId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/User",
      "description": "System staff and shared client accounts"
    },
    "/positions/{posId}": {
      "schema": "#/backend/entities/Position",
      "description": "Position master"
    },
    "/positions/{posId}/certificate_requirements/{reqId}": {
      "schema": { "type": "object" },
      "description": "Required certs for position"
    },
    "/positions/{posId}/ppe_requirements/{reqId}": {
      "schema": { "type": "object" },
      "description": "Required PPE for position"
    },
    "/positions/{posId}/tool_requirements/{reqId}": {
      "schema": { "type": "object" },
      "description": "Required tools for position"
    },
    "/workers/{workerId}": {
      "schema": "#/backend/entities/Worker",
      "description": "Worker master"
    },
    "/workers/{workerId}/certificates/{certId}": {
      "schema": { "type": "object" },
      "description": "Worker certificates"
    },
    "/workers/{workerId}/medical_records/{medId}": {
      "schema": { "type": "object" },
      "description": "Worker medical checks"
    },
    "/workers/{workerId}/drug_tests/{drugId}": {
      "schema": { "type": "object" },
      "description": "Worker drug tests"
    },
    "/workers/{workerId}/documents/{docId}": {
      "schema": { "type": "object" },
      "description": "Worker documents"
    },
    "/customers/{customerId}": {
      "schema": "#/backend/entities/Customer",
      "description": "Customer master"
    },
    "/customers/{customerId}/contacts/{contactId}": {
      "schema": { "type": "object" },
      "description": "Customer contacts"
    },
    "/customers/{customerId}/main_contracts/{contractId}": {
      "schema": { "type": "object" },
      "description": "Master agreements"
    },
    "/customers/{customerId}/main_contracts/{contractId}/position_rates/{rateId}": {
      "schema": { "type": "object" },
      "description": "Position billing rates"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}": {
      "schema": { "type": "object" },
      "description": "Purchase orders"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}": {
      "schema": { "type": "object" },
      "description": "PO items/positions"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}/assignments/{asgnId}": {
      "schema": { "type": "object" },
      "description": "Worker assignments"
    }
  }
}
