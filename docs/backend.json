{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a staff user with access to the application, distinct from workers. Authentication data is managed externally by Firebase Auth.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "DailyTimesheet": {
      "title": "DailyTimesheet",
      "type": "object",
      "description": "Granular record of worker activity for a single day, serving as the source of truth for payroll and billing.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "workerId": { "type": "string" },
        "workerNameSnapshot": { "type": "string" },
        "assignmentId": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "OPS_REVIEWED", "CLIENT_APPROVED", "LOCKED", "REJECTED", "CORRECTION_REQUIRED"] },
        "normalHours": { "type": "number" },
        "ot15Hours": { "type": "number" }
      },
      "required": ["id", "date", "workerId", "assignmentId", "status"]
    },
    "PayrollPeriod": {
      "title": "PayrollPeriod",
      "type": "object",
      "description": "Defines a specific window of time for calculating worker salaries and customer billing, typically aligned with month boundaries.",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "cycleType": { "type": "string", "enum": ["MONTHLY", "PARTIAL_START", "PARTIAL_END", "CUSTOM"] },
        "status": { "type": "string", "enum": ["DRAFT", "OPEN", "PROCESSING", "LOCKED", "CLOSED"] },
        "generatedBy": { "type": "string" },
        "generatedAt": { "type": "number" }
      },
      "required": ["id", "startDate", "endDate", "cycleType", "status"]
    },
    "PayrollBatch": {
      "title": "PayrollBatch",
      "type": "object",
      "description": "A collection of payroll calculations for a specific period and scope, undergoing review and approval before payment.",
      "properties": {
        "id": { "type": "string" },
        "payrollPeriodId": { "type": "string" },
        "workModeScope": { "type": "string", "enum": ["onshore", "offshore", "mixed"] },
        "status": { "type": "string", "enum": ["DRAFT", "GENERATED", "HR_REVIEWED", "HR_APPROVED", "FINANCE_PREPARED", "PAYMENT_EXPORTED", "PAID", "LOCKED"] },
        "totalWorkers": { "type": "number" },
        "netAmount": { "type": "number" }
      }
    },
    "PayrollBatchLine": {
      "title": "PayrollBatchLine",
      "type": "object",
      "description": "Individual worker calculation within a payroll batch, containing snapshots of earnings and bank details.",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "workerNameSnapshot": { "type": "string" },
        "netAmount": { "type": "number" }
      }
    },
    "PaymentExportBatch": {
      "title": "PaymentExportBatch",
      "type": "object",
      "description": "A record of a generated bank payment file, derived from a payroll batch.",
      "properties": {
        "id": { "type": "string" },
        "payrollBatchId": { "type": "string" },
        "exportTemplateCode": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "generated", "downloaded", "superseded"] },
        "totalAmount": { "type": "number" }
      }
    },
    "Quotation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Quotation",
      "type": "object",
      "description": "Commercial proposal document sent to customers prior to PO or Contract.",
      "properties": {
        "id": { "type": "string" },
        "quotationNo": { "type": "string" },
        "customerId": { "type": "string" },
        "title": { "type": "string" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["DRAFT", "SENT", "ACCEPTED", "REJECTED", "EXPIRED", "CANCELLED"] },
        "issueDate": { "type": "string", "format": "date" },
        "expiryDate": { "type": "string", "format": "date" }
      },
      "required": ["id", "quotationNo", "customerId", "title"]
    },
    "SalesContractTerm": {
      "title": "SalesContractTerm",
      "type": "object",
      "description": "Detailed billing and commercial rules linked to a PO or project.",
      "properties": {
        "id": { "type": "string" },
        "contractNo": { "type": "string" },
        "customerId": { "type": "string" },
        "purchaseOrderId": { "type": "string" },
        "billingCycle": { "type": "string" },
        "vatPercent": { "type": "number" },
        "withholdingTaxPercent": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "LaborCostContractTerm": {
      "title": "LaborCostContractTerm",
      "type": "object",
      "description": "Detailed cost and payroll rules for specific project deployments.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "relatedPurchaseOrderId": { "type": "string" },
        "scopeType": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "RateCondition": {
      "title": "RateCondition",
      "type": "object",
      "description": "Structured rule for calculating billable revenue or payable labor cost based on events.",
      "properties": {
        "id": { "type": "string" },
        "parentType": { "type": "string", "enum": ["SALES_CONTRACT", "LABOR_COST_CONTRACT", "PO_SNAPSHOT", "WAVE_SNAPSHOT"] },
        "parentId": { "type": "string" },
        "appliesTo": { "type": "string", "enum": ["SALES", "COST"] },
        "eventType": { "type": "string" },
        "calculationMethod": { "type": "string", "enum": ["FLAT", "MULTIPLIER", "PERCENTAGE", "FORMULA"] },
        "unitType": { "type": "string", "enum": ["DAY", "HALF_DAY", "HOUR", "TRIP", "FIXED"] },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "parentType", "parentId", "appliesTo", "eventType", "calculationMethod", "unitType"]
    },
    "WorkerWaveAcceptance": {
      "title": "WorkerWaveAcceptance",
      "type": "object",
      "description": "Tracks client-side approval, rejection, or replacement requests for workers assigned to a wave.",
      "properties": {
        "id": { "type": "string" },
        "waveId": { "type": "string" },
        "assignmentId": { "type": "string" },
        "workerId": { "type": "string" },
        "customerPortalUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "replacement_requested"] },
        "remark": { "type": "string" },
        "approvedDate": { "type": "string", "format": "date" },
        "createdBy": { "type": "string" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "waveId", "assignmentId", "workerId", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/daily_timesheets/{tsId}",
        "definition": {
          "entityName": "DailyTimesheet",
          "schema": { "$ref": "#/backend/entities/DailyTimesheet" },
          "description": "Stores individual daily activity logs for workers.",
          "params": [{ "name": "tsId", "description": "Unique key combining worker, assignment, and date." }]
        }
      },
      {
        "path": "/payroll_periods/{periodId}",
        "definition": {
          "entityName": "PayrollPeriod",
          "schema": { "$ref": "#/backend/entities/PayrollPeriod" },
          "description": "Stores defined financial windows for processing.",
          "params": [{ "name": "periodId", "description": "Unique ID for the period." }]
        }
      },
      {
        "path": "/payroll_batches/{batchId}",
        "definition": {
          "entityName": "PayrollBatch",
          "schema": { "$ref": "#/backend/entities/PayrollBatch" },
          "description": "Main batch record for a payroll run.",
          "params": [{ "name": "batchId", "description": "Unique ID for the batch." }]
        }
      },
      {
        "path": "/payroll_batches/{batchId}/lines/{lineId}",
        "definition": {
          "entityName": "PayrollBatchLine",
          "schema": { "$ref": "#/backend/entities/PayrollBatchLine" },
          "description": "Individual worker records within a payroll batch.",
          "params": [
            { "name": "batchId", "description": "Parent batch ID." },
            { "name": "lineId", "description": "Unique ID for the line." }
          ]
        }
      },
      {
        "path": "/payment_export_batches/{id}",
        "definition": {
          "entityName": "PaymentExportBatch",
          "schema": { "$ref": "#/backend/entities/PaymentExportBatch" },
          "description": "Records of generated bank payment files.",
          "params": [{ "name": "id", "description": "Unique ID for the export batch." }]
        }
      },
      {
        "path": "/quotations/{quoId}",
        "definition": {
          "entityName": "Quotation",
          "schema": { "$ref": "#/backend/entities/Quotation" },
          "description": "Stores sales quotations sent to customers.",
          "params": [{ "name": "quoId", "description": "Unique ID of the quotation." }]
        }
      },
      {
        "path": "/sales_contract_terms/{termId}",
        "definition": {
          "entityName": "SalesContractTerm",
          "schema": { "$ref": "#/backend/entities/SalesContractTerm" },
          "description": "Stores project-specific billing rules.",
          "params": [{ "name": "termId", "description": "Unique ID of the sales term record." }]
        }
      },
      {
        "path": "/labor_cost_contract_terms/{termId}",
        "definition": {
          "entityName": "LaborCostContractTerm",
          "schema": { "$ref": "#/backend/entities/LaborCostContractTerm" },
          "description": "Stores project-specific cost/payroll rules.",
          "params": [{ "name": "termId", "description": "Unique ID of the cost term record." }]
        }
      },
      {
        "path": "/rate_conditions/{conditionId}",
        "definition": {
          "entityName": "RateCondition",
          "schema": { "$ref": "#/backend/entities/RateCondition" },
          "description": "Specific pricing and cost rules for contracts and POs.",
          "params": [{ "name": "conditionId", "description": "Unique ID of the rate condition." }]
        }
      },
      {
        "path": "/worker_wave_acceptances/{id}",
        "definition": {
          "entityName": "WorkerWaveAcceptance",
          "schema": { "$ref": "#/backend/entities/WorkerWaveAcceptance" },
          "description": "Stores client acceptance records for wave assignments.",
          "params": [{ "name": "id", "description": "Unique ID for the acceptance record." }]
        }
      }
    ]
  }
}
