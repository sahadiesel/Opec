
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a staff user with access to the application, distinct from workers. Authentication data is managed externally by Firebase Auth.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "department": { "type": "string" },
        "level": { "type": "string" },
        "roleIds": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "approvalStatus": { "type": "string" },
        "permissionProfileKey": { "type": "string" },
        "assignedRoleKey": { "type": "string" },
        "userType": { "type": "string", "enum": ["internal", "customer_portal"] },
        "customerId": { "type": "string" },
        "portalRole": { "type": "string", "enum": ["approver", "viewer"] },
        "mustResetPassword": { "type": "boolean" },
        "allowedContractIds": { "type": "array", "items": { "type": "string" } },
        "allowedPurchaseOrderIds": { "type": "array", "items": { "type": "string" } },
        "lastLoginAt": { "type": "number" },
        "deactivatedAt": { "type": "number" },
        "deactivatedReason": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "DailyTimesheet": {
      "title": "DailyTimesheet",
      "type": "object",
      "description": "Granular record of worker activity for a single day, serving as the source of truth for payroll and billing.",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "workerId": { "type": "string" },
        "workerNameSnapshot": { "type": "string" },
        "assignmentId": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string", "enum": ["DRAFT", "SUBMITTED", "OPS_REVIEWED", "CLIENT_APPROVED", "LOCKED", "REJECTED", "CORRECTION_REQUIRED"] },
        "normalHours": { "type": "number" },
        "ot15Hours": { "type": "number" },
        "customerId": { "type": "string" }
      },
      "required": ["id", "date", "workerId", "assignmentId", "status", "customerId"]
    },
    "ExceptionRequest": {
      "title": "ExceptionRequest",
      "type": "object",
      "description": "Formal requests from clients for changes to approved or locked records.",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "requestType": { "type": "string", "enum": ["TIMESHEET_CORRECTION", "ASSIGNMENT_CHANGE"] },
        "referenceId": { "type": "string" },
        "referenceNo": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "IN_REVIEW", "APPROVED", "REJECTED"] },
        "requestedBy": { "type": "string" },
        "requestedById": { "type": "string" },
        "requestedAt": { "type": "number" }
      }
    },
    "PayrollPeriod": {
      "title": "PayrollPeriod",
      "type": "object",
      "description": "Defines a specific window of time for calculating worker salaries and customer billing, typically aligned with month boundaries.",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "cycleType": { "type": "string", "enum": ["MONTHLY", "PARTIAL_START", "PARTIAL_END", "CUSTOM"] },
        "status": { "type": "string", "enum": ["DRAFT", "OPEN", "PROCESSING", "LOCKED", "CLOSED"] },
        "generatedBy": { "type": "string" },
        "generatedAt": { "type": "number" }
      },
      "required": ["id", "startDate", "endDate", "cycleType", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores user profiles and access roles.",
          "params": [{ "name": "userId", "description": "Unique user ID from Auth." }]
        }
      },
      {
        "path": "/exception_requests/{id}",
        "definition": {
          "entityName": "ExceptionRequest",
          "schema": { "$ref": "#/backend/entities/ExceptionRequest" },
          "description": "Stores client exception requests.",
          "params": [{ "name": "id", "description": "Unique request ID." }]
        }
      },
      {
        "path": "/daily_timesheets/{tsId}",
        "definition": {
          "entityName": "DailyTimesheet",
          "schema": { "$ref": "#/backend/entities/DailyTimesheet" },
          "description": "Stores individual daily activity logs for workers.",
          "params": [{ "name": "tsId", "description": "Unique key combining worker, assignment, and date." }]
        }
      }
    ]
  }
}
