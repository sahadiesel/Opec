{
  "entities": {
    "Position": {
      "title": "Position",
      "description": "Represents a specific job role or position within OPEC Manpower Supply.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "positionName": { "type": "string" },
        "positionCode": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "description": { "type": "string" },
        "payrollBasis": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "positionName", "positionCode", "category", "active", "payrollBasis"]
    },
    "Wave": {
      "title": "Wave",
      "description": "Represents a deployment wave or rotation cycle for a group of workers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waveCode": { "type": "string" },
        "poId": { "type": "string" },
        "poLineId": { "type": "string" },
        "customerId": { "type": "string" },
        "projectName": { "type": "string" },
        "siteLocation": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "mobilizationDate": { "type": "string", "format": "date" },
        "demobilizationDate": { "type": "string", "format": "date" },
        "rotationPattern": { "type": "string" },
        "plannedWorkers": { "type": "number" },
        "assignedWorkers": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["waveCode", "poId", "poLineId", "customerId", "startDate", "endDate", "status"]
    },
    "PayrollRun": {
      "title": "Payroll Run",
      "description": "Represents a batch calculation of worker payments for a specific period.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "payrollRunNo": { "type": "string" },
        "payrollPeriodStart": { "type": "string", "format": "date" },
        "payrollPeriodEnd": { "type": "string", "format": "date" },
        "payrollType": { "type": "string", "enum": ["MONTHLY", "WAVE_BASED", "SPECIAL_RUN", "ADJUSTMENT"] },
        "status": { "type": "string" },
        "workerCount": { "type": "number" },
        "grossAmount": { "type": "number" },
        "netAmount": { "type": "number" }
      }
    },
    "OfficeStaff": {
      "title": "Office Staff",
      "description": "Internal company employees (office staff), separate from offshore manpower workers.",
      "type": "object",
      "properties": {
        "staffCode": { "type": "string" },
        "fullName": { "type": "string" },
        "nickname": { "type": "string" },
        "department": { "type": "string" },
        "positionTitle": { "type": "string" },
        "employmentType": { "type": "string", "enum": ["FULL_TIME", "PART_TIME", "CONTRACT"] },
        "salaryType": { "type": "string", "enum": ["MONTHLY", "DAILY"] },
        "monthlySalary": { "type": "number" },
        "startDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE", "RESIGNED"] }
      }
    },
    "BankAccount": {
      "title": "Bank Account",
      "description": "Corporate bank accounts used for payments and receipts.",
      "type": "object",
      "properties": {
        "accountCode": { "type": "string" },
        "bankName": { "type": "string" },
        "accountName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "branchName": { "type": "string" },
        "accountType": { "type": "string", "enum": ["CURRENT", "SAVINGS", "CASH"] },
        "currency": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/positions/{positionId}": {
      "schema": { "$ref": "#/backend/entities/Position" },
      "description": "Top-level collection for all job positions."
    },
    "/waves/{waveId}": {
      "schema": { "$ref": "#/backend/entities/Wave" },
      "description": "Top-level collection for all deployment waves."
    },
    "/payroll_runs/{runId}": {
      "schema": { "$ref": "#/backend/entities/PayrollRun" },
      "description": "Top-level collection for payroll runs."
    },
    "/office_staff/{staffId}": {
      "schema": { "$ref": "#/backend/entities/OfficeStaff" },
      "description": "Registry for internal office employees."
    },
    "/bank_accounts/{accountId}": {
      "schema": { "$ref": "#/backend/entities/BankAccount" },
      "description": "Corporate bank accounts registry."
    }
  }
}
