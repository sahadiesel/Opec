
{
  "entities": {
    "Position": {
      "title": "Position",
      "description": "Represents a specific job role or position within OPEC Manpower Supply.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "positionName": { "type": "string" },
        "positionCode": { "type": "string" },
        "category": { "type": "string" },
        "active": { "type": "boolean" },
        "description": { "type": "string" },
        "payrollBasis": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "positionName", "positionCode", "category", "active", "payrollBasis"]
    },
    "Wave": {
      "title": "Wave",
      "description": "Represents a deployment wave or rotation cycle for a group of workers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "waveCode": { "type": "string" },
        "poId": { "type": "string" },
        "poLineId": { "type": "string" },
        "customerId": { "type": "string" },
        "projectName": { "type": "string" },
        "siteLocation": { "type": "string" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "mobilizationDate": { "type": "string", "format": "date" },
        "demobilizationDate": { "type": "string", "format": "date" },
        "rotationPattern": { "type": "string" },
        "plannedWorkers": { "type": "number" },
        "assignedWorkers": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["waveCode", "poId", "poLineId", "customerId", "startDate", "endDate", "status"]
    },
    "PayrollRun": {
      "title": "Payroll Run",
      "description": "Represents a batch calculation of worker payments for a specific period.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "payrollRunNo": { "type": "string" },
        "payrollPeriodStart": { "type": "string", "format": "date" },
        "payrollPeriodEnd": { "type": "string", "format": "date" },
        "payrollType": { "type": "string", "enum": ["MONTHLY", "WAVE_BASED", "SPECIAL_RUN", "ADJUSTMENT"] },
        "status": { "type": "string" },
        "workerCount": { "type": "number" },
        "grossAmount": { "type": "number" },
        "netAmount": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/positions/{positionId}": {
      "schema": { "$ref": "#/backend/entities/Position" },
      "description": "Top-level collection for all job positions."
    },
    "/waves/{waveId}": {
      "schema": { "$ref": "#/backend/entities/Wave" },
      "description": "Top-level collection for all deployment waves."
    },
    "/payroll_runs/{runId}": {
      "schema": { "$ref": "#/backend/entities/PayrollRun" },
      "description": "Top-level collection for payroll runs."
    },
    "/payroll_runs/{runId}/lines/{lineId}": {
      "schema": { "type": "object" },
      "description": "Individual payment lines for workers within a run."
    }
  }
}
