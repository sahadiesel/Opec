{
  "entities": {
    "User": {
      "title": "User",
      "description": "Staff user profiles including Clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "roleId": { "type": "string" },
        "customerId": { "type": "string", "description": "Linked customer ID for client users" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "number" }
      }
    },
    "MainContract": {
      "title": "MainContract",
      "description": "Master Commercial Agreement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "contractNumber": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "expired", "pending"] }
      }
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Commercial Purchase Order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "poNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed", "pending"] }
      }
    },
    "POLine": {
      "title": "POLine",
      "description": "PO Line item with financial snapshots",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "quantity": { "type": "number" },
        "positionId": { "type": "string" },
        "sellRateSnapshot": { "type": "number" },
        "costBaselineSnapshot": { "type": "number" },
        "billingUnitSnapshot": { "type": "string", "enum": ["daily", "monthly", "hourly"] },
        "overtimeRuleSnapshot": { "type": "string" }
      }
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Worker deployment through PO Line with client approval flow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "workerId": { "type": "string" },
        "poLineId": { "type": "string" },
        "status": { "type": "string", "enum": ["proposed", "client_review", "approved", "mobilizing", "active", "demobilized", "cancelled", "replaced"] }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "#/backend/entities/User",
      "description": "System users and clients"
    },
    "/customers/{customerId}": {
      "schema": { "type": "object" },
      "description": "Customer master records"
    },
    "/customers/{customerId}/contacts/{contactId}": {
      "schema": { "type": "object" },
      "description": "Customer contact persons"
    },
    "/customers/{customerId}/main_contracts/{contractId}": {
      "schema": "#/backend/entities/MainContract",
      "description": "Master commercial agreements"
    },
    "/customers/{customerId}/main_contracts/{contractId}/position_rates/{rateId}": {
      "schema": { "type": "object" },
      "description": "Standard position rates per contract"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}": {
      "schema": "#/backend/entities/PurchaseOrder",
      "description": "Purchase orders under a contract"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}": {
      "schema": "#/backend/entities/POLine",
      "description": "Detailed PO lines with cost snapshots"
    },
    "/customers/{customerId}/main_contracts/{contractId}/purchase_orders/{poId}/po_lines/{lineId}/assignments/{asgnId}": {
      "schema": "#/backend/entities/Assignment",
      "description": "Worker assignments to PO lines"
    },
    "/workers/{workerId}": {
      "schema": { "type": "object" },
      "description": "Field worker personnel data"
    },
    "/workers/{workerId}/certificates/{certId}": {
      "schema": { "type": "object" },
      "description": "Worker certificates"
    },
    "/workers/{workerId}/medical_records/{medId}": {
      "schema": { "type": "object" },
      "description": "Worker medical checks"
    },
    "/workers/{workerId}/drug_tests/{drugId}": {
      "schema": { "type": "object" },
      "description": "Worker drug tests"
    }
  }
}
