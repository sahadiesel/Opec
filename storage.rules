rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // ไฟล์พื้นหลัง login (root) — อ่านได้ทุกคน
    match /OPEC_Image_2.png {
      allow read: if true;
      allow write: if false;
    }

    // ไฟล์อื่นที่ root หนึ่งชั้น
    match /{name} {
      allow read: if request.auth != null && name != 'OPEC_Image_2.png';
      allow write: if request.auth != null && name != 'OPEC_Image_2.png';
    }

    // ลายเซ็นและตราหัวเอกสารถูกวางบนใบพิมพ์ที่เปิดนอกเซสชัน — อ่านได้โดยไม่ต้องล็อกอิน
    match /user_signatures/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /company_profile_branding/{file} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // โฟลเดอร์ย่อย
    match /{folder}/{rest=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
